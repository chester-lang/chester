effect div {};
effect State {
  def get(): Integer;
  def put(s: Integer): Unit
};
// run_state: var cell + handler closing over it (Effekt-style).
def run_state(init: Integer): Integer = {
  var st = init;
  handle {
    perform put(int_add(st, 1));
    perform get()
  } with State {
    case get() => resume(st);
    case put(s) => {
      st = s;
      resume(())
    }
  }
};
enum Pair(A, B) {
  case MkPair(fst: A, snd: B)
};
def pair_fst[A, B](pair: Pair(A, B)): A = {
  match pair {
    case MkPair(a, b) => a
  }
};
def pair_snd[A, B](pair: Pair(A, B)): B = {
  match pair {
    case MkPair(a, b) => b
  }
};
enum Option(T) {
  case None;
  case Some(value: T)
};
enum Result(T, E) {
  case Ok(value: T);
  case Err(err: E)
};
def result_or_else[T, E](res: Result(T, E), default_res: Result(T, E)): Result(T, E) = {
  match res {
    case Ok(x) => Ok(x);
    case Err(e) => default_res
  }
};
def result_unwrap_err[T, E](res: Result(T, E), default_val: E): E = {
  match res {
    case Ok(x) => default_val;
    case Err(e) => e
  }
};
def option_is_some[T](opt: Option(T)): Bool = {
  match opt {
    case Some(x) => true;
    case _ => false
  }
};
def option_is_none[T](opt: Option(T)): Bool = {
  match opt {
    case Some(x) => false;
    case _ => true
  }
};
def option_unwrap_or[T](opt: Option(T), default_val: T): T = {
  match opt {
    case Some(x) => x;
    case _ => default_val
  }
};
def option_map[A, B](opt: Option(A), f: (x: A) -> B): Option(B) = {
  match opt {
    case Some(x) => Some(f(x));
    case _ => None
  }
};
def option_and_then[A, B](opt: Option(A), f: (x: A) -> Option(B)): Option(B) = {
  match opt {
    case Some(x) => f(x);
    case _ => None
  }
};
def option_or_else[T](opt: Option(T), default_opt: Option(T)): Option(T) = {
  match opt {
    case Some(x) => Some(x);
    case _ => default_opt
  }
};
def option_to_result[T, E](opt: Option(T), err: E): Result(T, E) = {
  match opt {
    case Some(x) => Ok(x);
    case _ => Err(err)
  }
};
extension OptionOps[T] for Option(T) {
  def is_some(self: Option(T)): Bool = option_is_some(self);
  def is_none(self: Option(T)): Bool = option_is_none(self);
  def unwrap_or(self: Option(T), default_val: T): T = option_unwrap_or(self, default_val);
  def map[U](self: Option(T), f: (x: T) -> U): Option(U) = option_map(self, f);
  def and_then[U](self: Option(T), f: (x: T) -> Option(U)): Option(U) = option_and_then(self, f);
  def or_else(self: Option(T), default_opt: Option(T)): Option(T) = option_or_else(self, default_opt);
  def to_result[E](self: Option(T), err: E): Result(T, E) = option_to_result(self, err)
};

def result_is_ok[T, E](res: Result(T, E)): Bool = {
  match res {
    case Ok(x) => true;
    case _ => false
  }
};
def result_is_err[T, E](res: Result(T, E)): Bool = {
  match res {
    case Ok(x) => false;
    case _ => true
  }
};
def result_unwrap_or[T, E](res: Result(T, E), default_val: T): T = {
  match res {
    case Ok(x) => x;
    case _ => default_val
  }
};
def result_map[T, E, U](res: Result(T, E), f: (x: T) -> U): Result(U, E) = {
  match res {
    case Ok(x) => Ok(f(x));
    case Err(e) => Err(e)
  }
};
def result_map_err[T, E, F](res: Result(T, E), f: (err: E) -> F): Result(T, F) = {
  match res {
    case Ok(x) => Ok(x);
    case Err(e) => Err(f(e))
  }
};
def result_and_then[T, E, U](res: Result(T, E), f: (x: T) -> Result(U, E)): Result(U, E) = {
  match res {
    case Ok(x) => f(x);
    case Err(e) => Err(e)
  }
};
def result_to_option[T, E](res: Result(T, E)): Option(T) = {
  match res {
    case Ok(x) => Some(x);
    case _ => None
  }
};
extension ResultOps[T, E] for Result(T, E) {
  def is_ok(self: Result(T, E)): Bool = result_is_ok(self);
  def is_err(self: Result(T, E)): Bool = result_is_err(self);
  def unwrap_or(self: Result(T, E), default_val: T): T = result_unwrap_or(self, default_val);
  def map[U](self: Result(T, E), f: (x: T) -> U): Result(U, E) = result_map(self, f);
  def map_err[F](self: Result(T, E), f: (err: E) -> F): Result(T, F) = result_map_err(self, f);
  def and_then[U](self: Result(T, E), f: (x: T) -> Result(U, E)): Result(U, E) = result_and_then(self, f);
  def to_option(self: Result(T, E)): Option(T) = result_to_option(self)
};
// Arithmetic operators
infixl "+";
infixl "-" same_as "+";
infixl "*" tighter_than "+";
infixl "/" same_as "*";
infixl "%" same_as "*";
// Comparison operators
infixl "<";
infixl ">" same_as "<";
infixl "<=" same_as "<";
infixl ">=" same_as "<";
// Integer primitives
def int_eq(a: Integer, b: Integer): Bool = prim__int_eq(a, b);
def int_lt(a: Integer, b: Integer): Bool = prim__int_lt(a, b);
def int_add(a: Integer, b: Integer): Integer = prim__int_add(a, b);
def int_sub(a: Integer, b: Integer): Integer = prim__int_sub(a, b);
def int_mul(a: Integer, b: Integer): Integer = prim__int_mul(a, b);
def int_div(a: Integer, b: Integer): Integer = prim__int_div(a, b);
def int_mod(a: Integer, b: Integer): Integer = prim__int_mod(a, b);
def int_gt(a: Integer, b: Integer): Bool = prim__int_gt(a, b);
def int_ge(a: Integer, b: Integer): Bool = prim__int_ge(a, b);
def int_le(a: Integer, b: Integer): Bool = prim__int_le(a, b);
def int_neg(a: Integer): Integer = prim__int_neg(a);
def int_min(a: Integer, b: Integer): Integer = {
  if int_lt(a, b) then a else b
};
def int_max(a: Integer, b: Integer): Integer = {
  if int_gt(a, b) then a else b
};
def int_abs(a: Integer): Integer = {
  if int_lt(a, 0) then int_neg(a) else a
};
// List primitives
def list_length[T](list: List(T)): Integer = prim__list_length(list);
def list_get[T](list: List(T), index: Integer): T = prim__list_get(list, index);
def list_make[T](len: Integer, f: (i: Integer) -> T): List(T) = prim__list_make(len, f);
// String primitives
def string_length(s: String): Integer = prim__string_length(s);
def string_substring(s: String, start: Integer, end: Integer): String = prim__string_substring(s, start, end);
def string_concat(s1: String, s2: String): String = prim__string_concat(s1, s2);
def string_eq(s1: String, s2: String): Bool = prim__string_eq(s1, s2);
// Alias: string_append is identical to string_concat
def string_append(s1: String, s2: String): String = prim__string_concat(s1, s2);
// Convert integer to its decimal string representation
def digit_char(d: Integer): String = {
  if int_eq(d, 0) then "0" else
  if int_eq(d, 1) then "1" else
  if int_eq(d, 2) then "2" else
  if int_eq(d, 3) then "3" else
  if int_eq(d, 4) then "4" else
  if int_eq(d, 5) then "5" else
  if int_eq(d, 6) then "6" else
  if int_eq(d, 7) then "7" else
  if int_eq(d, 8) then "8" else "9"
};
def int_to_string_helper(n: Integer, acc: String): String / {div} = {
  if int_eq(n, 0) then acc else {
    let d = int_mod(n, 10);
    let rest = int_div(n, 10);
    int_to_string_helper(rest, string_concat(digit_char(d), acc))
  }
};
def int_to_string(n: Integer): String = {
  if int_eq(n, 0) then "0"
  else if int_lt(n, 0) then string_concat("-", int_to_string_helper(int_neg(n), ""))
  else int_to_string_helper(n, "")
};
def string_char_at(s: String, index: Integer): String = {
  if int_lt(index, 0) then {
    ""
  } else if int_lt(index, string_length(s)) then {
    string_substring(s, index, int_add(index, 1))
  } else {
    ""
  }
};
def digit_value(c: String): Option(Integer) = {
  if string_eq(c, "0") then Some(0) else
  if string_eq(c, "1") then Some(1) else
  if string_eq(c, "2") then Some(2) else
  if string_eq(c, "3") then Some(3) else
  if string_eq(c, "4") then Some(4) else
  if string_eq(c, "5") then Some(5) else
  if string_eq(c, "6") then Some(6) else
  if string_eq(c, "7") then Some(7) else
  if string_eq(c, "8") then Some(8) else
  if string_eq(c, "9") then Some(9) else None
};
def char_digit(c: String): Integer = option_unwrap_or(digit_value(c), 0);
def string_to_int_aux(s: String, idx: Integer, acc: Integer): Integer / {div} = {
  if int_eq(idx, string_length(s)) then acc
  else string_to_int_aux(s, int_add(idx, 1), int_add(int_mul(acc, 10), char_digit(string_char_at(s, idx))))
};
def string_to_int(s: String): Integer = {
  if int_eq(string_length(s), 0) then 0
  else if string_eq(string_char_at(s, 0), "-") then int_neg(string_to_int_aux(s, 1, 0))
  else string_to_int_aux(s, 0, 0)
};
// Strict variant: None unless every character (after an optional leading '-') is a digit.
def string_all_digits(s: String, idx: Integer): Bool / {div} = {
  if int_ge(idx, string_length(s)) then true
  else if option_is_some(digit_value(string_char_at(s, idx))) then {
    string_all_digits(s, int_add(idx, 1))
  } else {
    false
  }
};
def string_to_int_opt(s: String): Option(Integer) = {
  let len = string_length(s);
  if int_eq(len, 0) then {
    None
  } else if string_eq(string_char_at(s, 0), "-") then {
    if int_eq(len, 1) then None
    else if string_all_digits(s, 1) then Some(int_neg(string_to_int_aux(s, 1, 0)))
    else None
  } else if string_all_digits(s, 0) then {
    Some(string_to_int_aux(s, 0, 0))
  } else {
    None
  }
};
def string_starts_with(s: String, prefix: String): Bool = {
  let plen = string_length(prefix);
  if int_gt(plen, string_length(s)) then false
  else string_eq(string_substring(s, 0, plen), prefix)
};
def string_ends_with(s: String, suffix: String): Bool = {
  let slen = string_length(suffix);
  let len = string_length(s);
  if int_gt(slen, len) then false
  else string_eq(string_substring(s, int_sub(len, slen), len), suffix)
};
def string_find_from(s: String, needle: String, idx: Integer): Integer / {div} = {
  let nlen = string_length(needle);
  if int_gt(int_add(idx, nlen), string_length(s)) then int_neg(1)
  else if string_eq(string_substring(s, idx, int_add(idx, nlen)), needle) then idx
  else string_find_from(s, needle, int_add(idx, 1))
};
def string_index_of(s: String, needle: String): Integer = {
  string_find_from(s, needle, 0)
};
def string_contains(s: String, needle: String): Bool = {
  int_ge(string_index_of(s, needle), 0)
};
def string_is_space(c: String): Bool = {
  bool_or(
    string_eq(c, " "),
    bool_or(string_eq(c, "\t"), bool_or(string_eq(c, "\n"), string_eq(c, "\r")))
  )
};
def string_trim_start(s: String, idx: Integer): Integer / {div} = {
  if int_ge(idx, string_length(s)) then idx
  else if string_is_space(string_char_at(s, idx)) then string_trim_start(s, int_add(idx, 1))
  else idx
};
def string_trim_end(s: String, end: Integer): Integer / {div} = {
  if int_le(end, 0) then 0
  else if string_is_space(string_char_at(s, int_sub(end, 1))) then string_trim_end(s, int_sub(end, 1))
  else end
};
def string_trim(s: String): String = {
  let start = string_trim_start(s, 0);
  let stop = string_trim_end(s, string_length(s));
  if int_ge(start, stop) then "" else string_substring(s, start, stop)
};
def string_trim_left(s: String): String = {
  let start = string_trim_start(s, 0);
  string_substring(s, start, string_length(s))
};
def string_trim_right(s: String): String = {
  let stop = string_trim_end(s, string_length(s));
  string_substring(s, 0, stop)
};
def string_split_from(s: String, sep: String, start: Integer, acc: List(String)): List(String) / {div} = {
  let seplen = string_length(sep);
  let idx = string_find_from(s, sep, start);
  if int_lt(idx, 0) then {
    list_append(acc, string_substring(s, start, string_length(s)))
  } else {
    string_split_from(
      s,
      sep,
      int_add(idx, seplen),
      list_append(acc, string_substring(s, start, idx))
    )
  }
};
// Splits on every occurrence of sep, keeping empty fields ("a,,b" -> ["a", "", "b"]).
// An empty separator yields the whole string as the only field.
def string_split(s: String, sep: String): List(String) = {
  if int_eq(string_length(sep), 0) then list_insert_first(list_empty[String](), s)
  else string_split_from(s, sep, 0, list_empty[String]())
};
def list_is_empty[T](list: List(T)): Bool = int_eq(list_length(list), 0);
def list_head[T](list: List(T)): Option(T) = {
  if int_eq(list_length(list), 0) then None
  else Some(list_get(list, 0))
};
def list_tail[T](list: List(T)): Option(List(T)) = {
  if int_eq(list_length(list), 0) then None
  else Some(advance(list))
};
// Named extensions: method-call form can overload; ListOps.get / StringOps.length stay unique.
extension ListOps[T] for List(T) {
  def length(self: List(T)): Integer = list_length(self);
  def get(self: List(T), index: Integer): T = list_get(self, index);
  def is_empty(self: List(T)): Bool = list_is_empty(self);
  def head(self: List(T)): Option(T) = list_head(self);
  def tail(self: List(T)): Option(List(T)) = list_tail(self);
  def reverse(self: List(T)): List(T) = list_reverse(self);
  def append(self: List(T), elem: T): List(T) = list_append(self, elem);
  def map[B](self: List(T), f: (x: T) -> B): List(B) = list_map(self, f);
  def filter(self: List(T), predicate: (x: T) -> Bool): List(T) = list_filter(self, predicate);
  def foldl[B](self: List(T), init: B, f: (acc: B, elem: T) -> B): B = list_foldl(self, init, f);
  def any(self: List(T), pred: (x: T) -> Bool): Bool = list_any(self, pred);
  def all(self: List(T), pred: (x: T) -> Bool): Bool = list_all(self, pred);
  def find(self: List(T), pred: (x: T) -> Bool): Option(T) = list_find(self, pred);
  def concat(self: List(T), other: List(T)): List(T) = list_concat(self, other);
  def take(self: List(T), count: Integer): List(T) = list_take(self, count);
  def drop(self: List(T), count: Integer): List(T) = list_drop(self, count);
  def last(self: List(T)): Option(T) = list_last(self);
  def index_of(self: List(T), pred: (x: T) -> Bool): Integer = list_index_of(self, pred);
  def foldr[B](self: List(T), init: B, f: (elem: T, acc: B) -> B): B = list_foldr(self, init, f);
  def zip[B](self: List(T), other: List(B)): List(Pair(T, B)) = list_zip(self, other)
};
extension StringOps for String {
  def length(self: String): Integer = string_length(self);
  def get(self: String, index: Integer): String = string_char_at(self, index);
  def concat(self: String, other: String): String = string_concat(self, other);
  def contains(self: String, needle: String): Bool = string_contains(self, needle);
  def starts_with(self: String, prefix: String): Bool = string_starts_with(self, prefix);
  def ends_with(self: String, suffix: String): Bool = string_ends_with(self, suffix);
  def index_of(self: String, needle: String): Integer = string_index_of(self, needle);
  def to_int_opt(self: String): Option(Integer) = string_to_int_opt(self);
  def trim(self: String): String = string_trim(self);
  def trim_left(self: String): String = string_trim_left(self);
  def trim_right(self: String): String = string_trim_right(self);
  def split(self: String, sep: String): List(String) = string_split(self, sep)
};
def bool_or(a: Bool, b: Bool): Bool = if a then {
  true
} else {
  b
};
def bool_and(a: Bool, b: Bool): Bool = if a then {
  b
} else {
  false
};
def bool_not(a: Bool): Bool = if a then {
  false
} else {
  true
};
def list_empty[T](): List(T) = prim__list_empty();
def advance[T](list: List(T)): List(T) = prim__list_advance(list);
def list_drop_last[T](list: List(T)): List(T) = prim__list_drop_last(list);
def list_insert_first[T](list: List(T), elem: T): List(T) = prim__list_insert_first(list, elem);
def list_reverse[T](list: List(T)): List(T) = {
  let len = list_length(list);
  list_make(len, \i => list_get(list, int_sub(int_sub(len, 1), i)))
};
def list_append[T](list: List(T), elem: T): List(T) = prim__list_append(list, elem);
def list_map[A, B](list: List(A), f: (x: A) -> B): List(B) = {
  let len = list_length(list);
  list_make(len, \i => f(list_get(list, i)))
};
def find_matching_index[T](list: List(T), predicate: (x: T) -> Bool, target_match: Integer, current_idx: Integer, matches_found: Integer): Integer / {div} = {
  if int_eq(current_idx, list_length(list)) then {
    int_sub(0, 1)
  } else {
    if predicate(list_get(list, current_idx)) then {
      if int_eq(matches_found, target_match) then {
        current_idx
      } else {
        find_matching_index(list, predicate, target_match, int_add(current_idx, 1), int_add(matches_found, 1))
      }
    } else {
      find_matching_index(list, predicate, target_match, int_add(current_idx, 1), matches_found)
    }
  }
};
def list_filter[T](list: List(T), predicate: (x: T) -> Bool): List(T) = prim__list_filter(list, predicate);
def list_foldl_helper[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B, idx: Integer): B / {div} = {
  if int_eq(idx, list_length(list)) then {
    init
  } else {
    list_foldl_helper(list, f(init, list_get(list, idx)), f, int_add(idx, 1))
  }
};

def list_foldl[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B): B = {
  list_foldl_helper(list, init, f, 0)
};

def list_any_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Bool / {div} = {
  if int_eq(idx, list_length(list)) then {
    false
  } else {
    if pred(list_get(list, idx)) then {
      true
    } else {
      list_any_helper(list, pred, int_add(idx, 1))
    }
  }
};
def list_any[T](list: List(T), pred: (x: T) -> Bool): Bool = {
  list_any_helper(list, pred, 0)
};

def list_all_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Bool / {div} = {
  if int_eq(idx, list_length(list)) then {
    true
  } else {
    if pred(list_get(list, idx)) then {
      list_all_helper(list, pred, int_add(idx, 1))
    } else {
      false
    }
  }
};
def list_all[T](list: List(T), pred: (x: T) -> Bool): Bool = {
  list_all_helper(list, pred, 0)
};

def list_find_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Option(T) / {div} = {
  if int_eq(idx, list_length(list)) then {
    None
  } else {
    let elem = list_get(list, idx);
    if pred(elem) then {
      Some(elem)
    } else {
      list_find_helper(list, pred, int_add(idx, 1))
    }
  }
};
def list_find[T](list: List(T), pred: (x: T) -> Bool): Option(T) = {
  list_find_helper(list, pred, 0)
};

def list_contains_helper(list: List(Integer), target: Integer, idx: Integer): Bool / {div} = {
  if int_eq(idx, list_length(list)) then {
    false
  } else {
    if int_eq(list_get(list, idx), target) then {
      true
    } else {
      list_contains_helper(list, target, int_add(idx, 1))
    }
  }
};
def list_contains(list: List(Integer), target: Integer): Bool = {
  list_contains_helper(list, target, 0)
};

def list_concat[T](l1: List(T), l2: List(T)): List(T) = {
  let len1 = list_length(l1);
  let len2 = list_length(l2);
  list_make(int_add(len1, len2), \i => {
    if int_lt(i, len1) then {
      list_get(l1, i)
    } else {
      list_get(l2, int_sub(i, len1))
    }
  })
};
def list_take[T](list: List(T), count: Integer): List(T) = {
  let n = int_max(0, int_min(count, list_length(list)));
  list_make(n, \i => list_get(list, i))
};
def list_drop[T](list: List(T), count: Integer): List(T) = {
  let len = list_length(list);
  let start = int_max(0, int_min(count, len));
  list_make(int_sub(len, start), \i => list_get(list, int_add(start, i)))
};
def list_last[T](list: List(T)): Option(T) = {
  let len = list_length(list);
  if int_eq(len, 0) then None else Some(list_get(list, int_sub(len, 1)))
};
def list_index_of[T](list: List(T), pred: (x: T) -> Bool): Integer = {
  find_matching_index(list, pred, 0, 0, 0)
};
def list_foldr_helper[A, B](list: List(A), init: B, f: (elem: A, acc: B) -> B, idx: Integer): B / {div} = {
  if int_lt(idx, 0) then init
  else list_foldr_helper(list, f(list_get(list, idx), init), f, int_sub(idx, 1))
};
def list_foldr[A, B](list: List(A), init: B, f: (elem: A, acc: B) -> B): B = {
  list_foldr_helper(list, init, f, int_sub(list_length(list), 1))
};
def list_zip[A, B](l1: List(A), l2: List(B)): List(Pair(A, B)) = {
  let n = int_min(list_length(l1), list_length(l2));
  list_make(n, \i => MkPair(list_get(l1, i), list_get(l2, i)))
};
