effect State {
  def get(): Integer;
  def put(s: Integer): Unit
};
// run_state: var cell + handler closing over it (Effekt-style).
def run_state(init: Integer): Integer = {
  var st = init;
  handle {
    perform put(int_add(st, 1));
    perform get()
  } with State {
    case get() => resume(st);
    case put(s) => {
      st = s;
      resume(())
    }
  }
};
enum Pair[A, B] {
  case MkPair(fst: A, snd: B)
};
enum Option[T] {
  case None;
  case Some(value: T)
};
enum Result[T, E] {
  case Ok(value: T);
  case Err(err: E)
};
def option_is_some[T](opt: Option[T]): Bool = {
  match opt {
    case Some(x) => true;
    case _ => false
  }
};
def option_is_none[T](opt: Option[T]): Bool = {
  match opt {
    case Some(x) => false;
    case _ => true
  }
};
def option_unwrap_or[T](opt: Option[T], default_val: T): T = {
  match opt {
    case Some(x) => x;
    case _ => default_val
  }
};
def option_map[A, B](opt: Option[A], f: (x: A) -> B): Option[B] = {
  match opt {
    case Some(x) => Some(f(x));
    case _ => None
  }
};
def option_and_then[A, B](opt: Option[A], f: (x: A) -> Option[B]): Option[B] = {
  match opt {
    case Some(x) => f(x);
    case _ => None
  }
};
def option_or_else[T](opt: Option[T], default_opt: Option[T]): Option[T] = {
  match opt {
    case Some(x) => Some(x);
    case _ => default_opt
  }
};
extension OptionOps[T] for Option[T] {
  def is_some(self: Option[T]): Bool = option_is_some(self);
  def is_none(self: Option[T]): Bool = option_is_none(self);
  def unwrap_or(self: Option[T], default_val: T): T = option_unwrap_or(self, default_val);
  def map[U](self: Option[T], f: (x: T) -> U): Option[U] = option_map(self, f);
  def and_then[U](self: Option[T], f: (x: T) -> Option[U]): Option[U] = option_and_then(self, f);
  def or_else(self: Option[T], default_opt: Option[T]): Option[T] = option_or_else(self, default_opt)
};

def result_is_ok[T, E](res: Result[T, E]): Bool = {
  match res {
    case Ok(x) => true;
    case _ => false
  }
};
def result_is_err[T, E](res: Result[T, E]): Bool = {
  match res {
    case Ok(x) => false;
    case _ => true
  }
};
def result_unwrap_or[T, E](res: Result[T, E], default_val: T): T = {
  match res {
    case Ok(x) => x;
    case _ => default_val
  }
};
def result_map[T, E, U](res: Result[T, E], f: (x: T) -> U): Result[U, E] = {
  match res {
    case Ok(x) => Ok(f(x));
    case Err(e) => Err(e)
  }
};
def result_map_err[T, E, F](res: Result[T, E], f: (err: E) -> F): Result[T, F] = {
  match res {
    case Ok(x) => Ok(x);
    case Err(e) => Err(f(e))
  }
};
def result_and_then[T, E, U](res: Result[T, E], f: (x: T) -> Result[U, E]): Result[U, E] = {
  match res {
    case Ok(x) => f(x);
    case Err(e) => Err(e)
  }
};
extension ResultOps[T, E] for Result[T, E] {
  def is_ok(self: Result[T, E]): Bool = result_is_ok(self);
  def is_err(self: Result[T, E]): Bool = result_is_err(self);
  def unwrap_or(self: Result[T, E], default_val: T): T = result_unwrap_or(self, default_val);
  def map[U](self: Result[T, E], f: (x: T) -> U): Result[U, E] = result_map(self, f);
  def map_err[F](self: Result[T, E], f: (err: E) -> F): Result[T, F] = result_map_err(self, f);
  def and_then[U](self: Result[T, E], f: (x: T) -> Result[U, E]): Result[U, E] = result_and_then(self, f)
};
// Arithmetic operators
infixl "+";
infixl "-" same_as "+";
infixl "*" tighter_than "+";
infixl "/" same_as "*";
infixl "%" same_as "*";
// Comparison operators
infixl "<";
infixl ">" same_as "<";
infixl "<=" same_as "<";
infixl ">=" same_as "<";
// Integer primitives
def int_eq(a: Integer, b: Integer): Bool = prim__int_eq(a, b);
def int_lt(a: Integer, b: Integer): Bool = prim__int_lt(a, b);
def int_add(a: Integer, b: Integer): Integer = prim__int_add(a, b);
def int_sub(a: Integer, b: Integer): Integer = prim__int_sub(a, b);
def int_mul(a: Integer, b: Integer): Integer = prim__int_mul(a, b);
def int_div(a: Integer, b: Integer): Integer = prim__int_div(a, b);
def int_mod(a: Integer, b: Integer): Integer = prim__int_mod(a, b);
def int_gt(a: Integer, b: Integer): Bool = prim__int_gt(a, b);
def int_ge(a: Integer, b: Integer): Bool = prim__int_ge(a, b);
def int_le(a: Integer, b: Integer): Bool = prim__int_le(a, b);
def int_neg(a: Integer): Integer = prim__int_neg(a);
// List primitives
def list_length[T](list: List(T)): Integer = prim__list_length(list);
def list_get[T](list: List(T), index: Integer): T = prim__list_get(list, index);
def list_make[T](len: Integer, f: (i: Integer) -> T): List(T) = prim__list_make(len, f);
// String primitives
def string_length(s: String): Integer = prim__string_length(s);
def string_substring(s: String, start: Integer, end: Integer): String = prim__string_substring(s, start, end);
def string_concat(s1: String, s2: String): String = prim__string_concat(s1, s2);
def string_eq(s1: String, s2: String): Bool = prim__string_eq(s1, s2);
// Alias: string_append is identical to string_concat
def string_append(s1: String, s2: String): String = prim__string_concat(s1, s2);
// Convert integer to its decimal string representation
def digit_char(d: Integer): String = {
  if int_eq(d, 0) then "0" else
  if int_eq(d, 1) then "1" else
  if int_eq(d, 2) then "2" else
  if int_eq(d, 3) then "3" else
  if int_eq(d, 4) then "4" else
  if int_eq(d, 5) then "5" else
  if int_eq(d, 6) then "6" else
  if int_eq(d, 7) then "7" else
  if int_eq(d, 8) then "8" else "9"
};
def int_to_string_helper(n: Integer, acc: String): String / [div] = {
  if int_eq(n, 0) then acc else {
    let d = int_mod(n, 10);
    let rest = int_div(n, 10);
    int_to_string_helper(rest, string_concat(digit_char(d), acc))
  }
};
def int_to_string(n: Integer): String = {
  if int_eq(n, 0) then "0"
  else if int_lt(n, 0) then string_concat("-", int_to_string_helper(int_neg(n), ""))
  else int_to_string_helper(n, "")
};
def string_char_at(s: String, index: Integer): String = {
  let res = if int_lt(index, string_length(s)) then {
    string_substring(s, index, int_add(index, 1))
  } else {
    ""
  };
  res
};
def char_digit(c: String): Integer = {
  if string_eq(c, "0") then 0 else
  if string_eq(c, "1") then 1 else
  if string_eq(c, "2") then 2 else
  if string_eq(c, "3") then 3 else
  if string_eq(c, "4") then 4 else
  if string_eq(c, "5") then 5 else
  if string_eq(c, "6") then 6 else
  if string_eq(c, "7") then 7 else
  if string_eq(c, "8") then 8 else
  if string_eq(c, "9") then 9 else 0
};
def string_to_int_aux(s: String, idx: Integer, acc: Integer): Integer / [div] = {
  if int_eq(idx, string_length(s)) then acc
  else string_to_int_aux(s, int_add(idx, 1), int_add(int_mul(acc, 10), char_digit(string_char_at(s, idx))))
};
def string_to_int(s: String): Integer = {
  if int_eq(string_length(s), 0) then 0
  else if string_eq(string_char_at(s, 0), "-") then int_neg(string_to_int_aux(s, 1, 0))
  else string_to_int_aux(s, 0, 0)
};
// Named extensions: method-call form can overload; ListOps.get / StringOps.length stay unique.
extension ListOps[T] for List(T) {
  def length(self: List(T)): Integer = list_length(self);
  def get(self: List(T), index: Integer): T = list_get(self, index);
  def reverse(self: List(T)): List(T) = list_reverse(self);
  def append(self: List(T), elem: T): List(T) = list_append(self, elem);
  def map[B](self: List(T), f: (x: T) -> B): List(B) = list_map(self, f);
  def filter(self: List(T), predicate: (x: T) -> Bool): List(T) = list_filter(self, predicate);
  def foldl[B](self: List(T), init: B, f: (acc: B, elem: T) -> B): B = list_foldl(self, init, f);
  def any(self: List(T), pred: (x: T) -> Bool): Bool = list_any(self, pred);
  def all(self: List(T), pred: (x: T) -> Bool): Bool = list_all(self, pred);
  def find(self: List(T), pred: (x: T) -> Bool): Option[T] = list_find(self, pred);
  def concat(self: List(T), other: List(T)): List(T) = list_concat(self, other)
};
extension StringOps for String {
  def length(self: String): Integer = string_length(self);
  def get(self: String, index: Integer): String = string_char_at(self, index)
};
def bool_or(a: Bool, b: Bool): Bool = if a then {
  true
} else {
  b
};
def bool_and(a: Bool, b: Bool): Bool = if a then {
  b
} else {
  false
};
def bool_not(a: Bool): Bool = if a then {
  false
} else {
  true
};
def list_empty[T](): List(T) = prim__list_empty();
def advance[T](list: List(T)): List(T) = prim__list_advance(list);
def list_drop_last[T](list: List(T)): List(T) = prim__list_drop_last(list);
def list_insert_first[T](list: List(T), elem: T): List(T) = prim__list_insert_first(list, elem);
def list_reverse[T](list: List(T)): List(T) = {
  let len = list_length(list);
  list_make(len, \i => list_get(list, int_sub(int_sub(len, 1), i)))
};
def list_append[T](list: List(T), elem: T): List(T) = prim__list_append(list, elem);
def list_map[A, B](list: List(A), f: (x: A) -> B): List(B) = {
  let len = list_length(list);
  list_make(len, \i => f(list_get(list, i)))
};
def find_matching_index[T](list: List(T), predicate: (x: T) -> Bool, target_match: Integer, current_idx: Integer, matches_found: Integer): Integer / [div] = {
  if int_eq(current_idx, list_length(list)) then {
    int_sub(0, 1)
  } else {
    if predicate(list_get(list, current_idx)) then {
      if int_eq(matches_found, target_match) then {
        current_idx
      } else {
        find_matching_index(list, predicate, target_match, int_add(current_idx, 1), int_add(matches_found, 1))
      }
    } else {
      find_matching_index(list, predicate, target_match, int_add(current_idx, 1), matches_found)
    }
  }
};
def list_filter[T](list: List(T), predicate: (x: T) -> Bool): List(T) = prim__list_filter(list, predicate);
def list_foldl_helper[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B, idx: Integer): B / [div] = {
  if int_eq(idx, list_length(list)) then {
    init
  } else {
    list_foldl_helper(list, f(init, list_get(list, idx)), f, int_add(idx, 1))
  }
};

def list_foldl[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B): B = {
  list_foldl_helper(list, init, f, 0)
};

def list_any_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Bool / [div] = {
  if int_eq(idx, list_length(list)) then {
    false
  } else {
    if pred(list_get(list, idx)) then {
      true
    } else {
      list_any_helper(list, pred, int_add(idx, 1))
    }
  }
};
def list_any[T](list: List(T), pred: (x: T) -> Bool): Bool = {
  list_any_helper(list, pred, 0)
};

def list_all_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Bool / [div] = {
  if int_eq(idx, list_length(list)) then {
    true
  } else {
    if pred(list_get(list, idx)) then {
      list_all_helper(list, pred, int_add(idx, 1))
    } else {
      false
    }
  }
};
def list_all[T](list: List(T), pred: (x: T) -> Bool): Bool = {
  list_all_helper(list, pred, 0)
};

def list_find_helper[T](list: List(T), pred: (x: T) -> Bool, idx: Integer): Option[T] / [div] = {
  if int_eq(idx, list_length(list)) then {
    None
  } else {
    let elem = list_get(list, idx);
    if pred(elem) then {
      Some(elem)
    } else {
      list_find_helper(list, pred, int_add(idx, 1))
    }
  }
};
def list_find[T](list: List(T), pred: (x: T) -> Bool): Option[T] = {
  list_find_helper(list, pred, 0)
};

def list_contains_helper(list: List(Integer), target: Integer, idx: Integer): Bool / [div] = {
  if int_eq(idx, list_length(list)) then {
    false
  } else {
    if int_eq(list_get(list, idx), target) then {
      true
    } else {
      list_contains_helper(list, target, int_add(idx, 1))
    }
  }
};
def list_contains(list: List(Integer), target: Integer): Bool = {
  list_contains_helper(list, target, 0)
};

def list_concat[T](l1: List(T), l2: List(T)): List(T) = {
  let len1 = list_length(l1);
  let len2 = list_length(l2);
  list_make(int_add(len1, len2), \i => {
    if int_lt(i, len1) then {
      list_get(l1, i)
    } else {
      list_get(l2, int_sub(i, len1))
    }
  })
};
