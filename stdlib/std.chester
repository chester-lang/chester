effect State {
  def get(): Integer;
  def put(s: Integer): Unit
};
// run_state: var cell + handler closing over it (Effekt-style).
def run_state(init: Integer): Integer = {
  var st = init;
  handle {
    perform put(int_add(st, 1));
    perform get()
  } with State {
    case get() => resume(st);
    case put(s) => {
      st = s;
      resume(())
    }
  }
};
enum Pair[A, B] {
  case MkPair(fst: A, snd: B)
};
enum Option[T] {
  case None;
  case Some(value: T)
};
enum Result[T, E] {
  case Ok(value: T);
  case Err(err: E)
};
// Arithmetic operators
infixl "+";
infixl "-" same_as "+";
infixl "*" tighter_than "+";
infixl "/" same_as "*";
infixl "%" same_as "*";
// Comparison operators
infixl "<";
infixl ">" same_as "<";
infixl "<=" same_as "<";
infixl ">=" same_as "<";
// Integer primitives
def int_eq(a: Integer, b: Integer): Bool = prim__int_eq(a, b);
def int_lt(a: Integer, b: Integer): Bool = prim__int_lt(a, b);
def int_add(a: Integer, b: Integer): Integer = prim__int_add(a, b);
def int_sub(a: Integer, b: Integer): Integer = prim__int_sub(a, b);
def int_mul(a: Integer, b: Integer): Integer = prim__int_mul(a, b);
def int_div(a: Integer, b: Integer): Integer = prim__int_div(a, b);
def int_mod(a: Integer, b: Integer): Integer = prim__int_mod(a, b);
def int_gt(a: Integer, b: Integer): Bool = prim__int_gt(a, b);
def int_ge(a: Integer, b: Integer): Bool = prim__int_ge(a, b);
def int_le(a: Integer, b: Integer): Bool = prim__int_le(a, b);
def int_neg(a: Integer): Integer = prim__int_neg(a);
// List primitives
def list_length[T](list: List(T)): Integer = prim__list_length(list);
def list_get[T](list: List(T), index: Integer): T = prim__list_get(list, index);
def list_make[T](len: Integer, f: (i: Integer) -> T): List(T) = prim__list_make(len, f);
// String primitives
def string_length(s: String): Integer = prim__string_length(s);
def string_substring(s: String, start: Integer, end: Integer): String = prim__string_substring(s, start, end);
def string_concat(s1: String, s2: String): String = prim__string_concat(s1, s2);
def string_eq(s1: String, s2: String): Bool = prim__string_eq(s1, s2);
// Alias: string_append is identical to string_concat
def string_append(s1: String, s2: String): String = prim__string_concat(s1, s2);
// Convert integer to its decimal string representation
def digit_char(d: Integer): String = {
  if int_eq(d, 0) then "0" else
  if int_eq(d, 1) then "1" else
  if int_eq(d, 2) then "2" else
  if int_eq(d, 3) then "3" else
  if int_eq(d, 4) then "4" else
  if int_eq(d, 5) then "5" else
  if int_eq(d, 6) then "6" else
  if int_eq(d, 7) then "7" else
  if int_eq(d, 8) then "8" else "9"
};
def int_to_string_helper(n: Integer, acc: String): String / [div] = {
  if int_eq(n, 0) then acc else {
    let d = int_mod(n, 10);
    let rest = int_div(n, 10);
    int_to_string_helper(rest, string_concat(digit_char(d), acc))
  }
};
def int_to_string(n: Integer): String = {
  if int_eq(n, 0) then "0"
  else if int_lt(n, 0) then string_concat("-", int_to_string_helper(int_neg(n), ""))
  else int_to_string_helper(n, "")
};
def string_char_at(s: String, index: Integer): String = {
  let res = if int_lt(index, string_length(s)) then {
    string_substring(s, index, int_add(index, 1))
  } else {
    ""
  };
  res
};
def char_digit(c: String): Integer = {
  if string_eq(c, "0") then 0 else
  if string_eq(c, "1") then 1 else
  if string_eq(c, "2") then 2 else
  if string_eq(c, "3") then 3 else
  if string_eq(c, "4") then 4 else
  if string_eq(c, "5") then 5 else
  if string_eq(c, "6") then 6 else
  if string_eq(c, "7") then 7 else
  if string_eq(c, "8") then 8 else
  if string_eq(c, "9") then 9 else 0
};
def string_to_int_aux(s: String, idx: Integer, acc: Integer): Integer / [div] = {
  if int_eq(idx, string_length(s)) then acc
  else string_to_int_aux(s, int_add(idx, 1), int_add(int_mul(acc, 10), char_digit(string_char_at(s, idx))))
};
def string_to_int(s: String): Integer = {
  if int_eq(string_length(s), 0) then 0
  else if string_eq(string_char_at(s, 0), "-") then int_neg(string_to_int_aux(s, 1, 0))
  else string_to_int_aux(s, 0, 0)
};
// Named extensions: method-call form can overload; ListOps.get / StringOps.length stay unique.
extension ListOps[T] for List(T) {
  def length(self: List(T)): Integer = list_length(self);
  def get(self: List(T), index: Integer): T = list_get(self, index)
};
extension StringOps for String {
  def length(self: String): Integer = string_length(self);
  def get(self: String, index: Integer): String = string_char_at(self, index)
};
def bool_or(a: Bool, b: Bool): Bool = if a then {
  true
} else {
  b
};
def bool_and(a: Bool, b: Bool): Bool = if a then {
  b
} else {
  false
};
def bool_not(a: Bool): Bool = if a then {
  false
} else {
  true
};
def list_empty[T](): List(T) = prim__list_empty();
def advance[T](list: List(T)): List(T) = prim__list_advance(list);
def list_drop_last[T](list: List(T)): List(T) = prim__list_drop_last(list);
def list_insert_first[T](list: List(T), elem: T): List(T) = prim__list_insert_first(list, elem);
def list_reverse[T](list: List(T)): List(T) = {
  let len = list.length();
  list_make(len, \i => list.get(int_sub(int_sub(len, 1), i)))
};
def list_append[T](list: List(T), elem: T): List(T) = prim__list_append(list, elem);
def list_map[A, B](list: List(A), f: (x: A) -> B): List(B) = {
  let len = list.length();
  list_make(len, \i => f(list.get(i)))
};
def find_matching_index[T](list: List(T), predicate: (x: T) -> Bool, target_match: Integer, current_idx: Integer, matches_found: Integer): Integer / [div] = {
  if int_eq(current_idx, list.length()) then {
    int_sub(0, 1)
  } else {
    if predicate(list.get(current_idx)) then {
      if int_eq(matches_found, target_match) then {
        current_idx
      } else {
        find_matching_index(list, predicate, target_match, int_add(current_idx, 1), int_add(matches_found, 1))
      }
    } else {
      find_matching_index(list, predicate, target_match, int_add(current_idx, 1), matches_found)
    }
  }
};
def list_filter[T](list: List(T), predicate: (x: T) -> Bool): List(T) = prim__list_filter(list, predicate);
def list_foldl_helper[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B, idx: Integer): B / [div] = {
  if int_eq(idx, list.length()) then {
    init
  } else {
    list_foldl_helper(list, f(init, list.get(idx)), f, int_add(idx, 1))
  }
};

def list_foldl[A, B](list: List(A), init: B, f: (acc: B, elem: A) -> B): B = {
  list_foldl_helper(list, init, f, 0)
};
