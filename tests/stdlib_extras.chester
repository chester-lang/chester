// Exercises the stdlib helpers beyond tests/stdlib_functional.chester:
// Integer min/max/abs, strict string parsing/search, Pair/Result helpers, and
// list take/drop/last/index_of/foldr/zip.
// Concretely typed function value: the Go backend must adapt it when it is
// passed to a higher-order helper (regression for the func(any, ...) assertion).
def add_acc(x: Integer, acc: Integer): Integer = int_add(x, acc);

def main(): Integer = {
  // Integer helpers: 3 + 7 + 5 = 15
  let ints = int_add(int_min(3, 7), int_add(int_max(3, 7), int_abs(int_neg(5))));

  // string_char_at clamps out-of-range indices instead of slicing negatively: 0
  let clamp = string_length(string_char_at("abc", int_neg(1)));

  // string search: 1 + 2 + (-1) + 1 + 1 + 1 = 5
  let search = int_add(
    if string_contains("hello world", "lo wo") then { 1 } else { 0 },
    int_add(
      string_index_of("hello", "l"),
      int_add(
        string_index_of("hello", "z"),
        int_add(
          if string_starts_with("chester", "che") then { 1 } else { 0 },
          int_add(
            if string_ends_with("chester", "ster") then { 1 } else { 0 },
            if "abc".starts_with("ab") then { 1 } else { 0 }
          )
        )
      )
    )
  );

  // strict parsing: 123 + 1 + 1 + (-42) = 83
  let parsed = int_add(
    string_to_int_opt("123").unwrap_or(0),
    int_add(
      if string_to_int_opt("12a").is_none() then { 1 } else { 0 },
      int_add(
        if string_to_int_opt("-").is_none() then { 1 } else { 0 },
        string_to_int_opt("-42").unwrap_or(0)
      )
    )
  );

  // Result helpers: 4 + length("fallback") = 12
  let results = int_add(
    result_or_else(Err("boom"), Ok(4)).unwrap_or(0),
    string_length(result_unwrap_err(Ok(1), "fallback"))
  );

  // list helpers: 2 + 2 + 0 + 5 + 5 + 2 + (-1) + 15 + 5 + 1 + 50 = 86
  let xs = [1, 2, 3, 4, 5];
  let zipped = xs.zip([10, 20, 30, 40, 50]);
  let lists = int_add(
    xs.take(2).length(),
    int_add(
      xs.drop(3).length(),
      int_add(
        xs.drop(9).length(),
        int_add(
          xs.take(9).length(),
          int_add(
            xs.last().unwrap_or(0),
            int_add(
              xs.index_of(\x => int_eq(x, 3)),
              int_add(
                xs.index_of(\x => int_eq(x, 9)),
                int_add(
                  xs.foldr(0, add_acc),
                  int_add(
                    zipped.length(),
                    int_add(pair_fst(zipped.get(0)), pair_snd(zipped.get(4)))
                  )
                )
              )
            )
          )
        )
      )
    )
  );

  // String concat method + legacy string_to_int + char_digit: 4 + 7 + 5 = 16
  let misc = int_add(
    "ab".concat("cd").length(),
    int_add(string_to_int("7"), char_digit("5"))
  );

  // trim + split: 2 + 2 + 2 + 3 + 3 = 12
  let trim_split = int_add(
    string_length(string_trim("  hi  ")),
    int_add(
      string_length("  ab".trim_left()),
      int_add(
        string_length("ab  ".trim_right()),
        int_add(
          list_length(string_split("a,b,c", ",")),
          "a,,b".split(",").length()
        )
      )
    )
  );

  // 15 + 0 + 5 + 83 + 12 + 86 + 16 + 12 = 229
  int_add(
    ints,
    int_add(
      clamp,
      int_add(
        search,
        int_add(
          parsed,
          int_add(
            results,
            int_add(lists, int_add(misc, trim_split))
          )
        )
      )
    )
  )
};
