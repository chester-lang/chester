effect Flip {
  def flip(): Boolean;
}

// True multi-shot: each resume re-enters the continuation after perform
// with a fresh answer (answer-stream replay / forking).
def main() = {
  handle {
    let x = perform flip();
    let r = if x then {
      10
    } else {
      1
    };
    r
  } with Flip {
    case flip() => {
      let a = resume(true);
      let b = resume(false);
      int_add(a, b)
    }
  }
}
