effect Choose {
  def choose(): Integer;
}

// Multi-shot resume: handler may call resume more than once.
// Full continuation-forking CPS is follow-up; here each resume updates a shared var.
def main() = {
  var hits = 0;
  handle {
    perform choose();
    hits
  } with Choose {
    case choose() => {
      hits = int_add(hits, 1);
      resume(Unit);
      hits = int_add(hits, 1);
      resume(Unit);
      hits = int_add(hits, 1);
      resume(Unit)
    }
  }
}
