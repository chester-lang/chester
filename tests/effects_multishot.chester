effect Flip {
  def flip(): Boolean
}

// Answer-stream multishot (not delimited-continuation capture): each resume
// re-enters after perform via fork; side effects before perform re-execute.
def main() = {
  handle multishot {
    let x = perform flip();
    let r = if x then {
      10
    } else {
      1
    };
    r
  } with Flip {
    case flip() => {
      let a = resume(true);
      let b = resume(false);
      int_add(a, b)
    }
  }
}
