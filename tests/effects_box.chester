effect State {
  def get(): Integer;
  def put(s: Integer): Unit
}

// Box under a handler captures State evidence; unbox outside still runs.
def main() = {
  var st = 0;
  let f = handle {
    let b = box {
      perform put(5);
      perform get()
    };
    b
  } with State {
    case get() => resume(st);
    case put(s) => {
      st = s;
      resume(())
    }
  };
  unbox f
}
