signature Showable {
  def show(): String
};

module Counter :> Showable {
  def show(): String = { "0" };
  def secret(): Unit = { () }
};

module Visible : Showable {
  def show(): String = { "1" };
  def secret(): Unit = { () }
};

module app Twice(X: Showable) {
  def tag(): String = { "twice" }
};

module A = Twice(Counter);
module B = Twice(Counter);

signature Shown = Showable with type carrier = String;

def main(): Unit = {
  let _ = Counter.show();
  let _ = Visible.show();
  let _ = A.tag();
  let _ = B.tag();
  unpack (X : Showable) = pack Counter as Showable in {
    let _ = X.show();
    ()
  }
}
