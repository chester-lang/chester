effect State[T] {
  def get(): T;
  def put(s: T): Unit;
}

def main() = {
  var st = 0;
  handle {
    perform put(1);
    let a = perform get();
    perform put(2);
    let b = perform get();
    b
  } with State {
    case get() => resume(st);
    case put(s) => {
      st = s;
      resume(Unit)
    }
  }
}
