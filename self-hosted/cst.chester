// Chester Concrete Syntax Tree (CST)
enum Span {
  case Span(start: Integer, end_idx: Integer, context: List(Integer))
};
def Span_start(sp: Span): Integer = match sp { case Span(st, _, _) => st };
def Span_end(sp: Span): Integer = match sp { case Span(_, en, _) => en };
def Span_context(sp: Span): List(Integer) = match sp { case Span(_, _, ctx) => ctx };

enum CST {
  case Symbol(name: String, span: Span);
  case Tuple(elements: List(CST), span: Span);
  case ListLiteral(elements: List(CST), span: Span);
  case Block(elements: List(CST), tail: CST, span: Span);
  case StringLiteral(value: String, span: Span);
  case IntegerLiteral(value: String, span: Span);
  case BoolLiteral(value: Bool, span: Span);
  case SeqOf(elements: List(CST), span: Span);
  case FieldAccess(expr: CST, field: String, span: Span);
  case Comment(text: String, span: Span);
  case Error(msg: String, span: Span);
  // Macro expanded nodes
  case LetCST(name: String, value: CST, next: CST, span: Span);
  case VarCST(name: String, value: CST, next: CST, span: Span);
  case AssignCST(name: String, value: CST, span: Span);
  case IfCST(cond: CST, then_branch: CST, else_branch: CST, span: Span);
  case DefCST(name: String, type_params: List(String), params: List(CST), ret_ty: CST, body: CST, span: Span);
  case LamCST(arg_name: String, opt_arg_ty: CST, body: CST, span: Span);
  case AppCST(fn_expr: CST, args: List(CST), span: Span);
  case ImplicitAppCST(fn_expr: CST, targs: List(CST), span: Span);
  case EnumCST(name: String, type_params: List(String), variants: List(CST), span: Span);
  case MatchCST(expr: CST, cases: List(CST), span: Span);
  case RecordCST(name: String, type_params: List(String), fields: List(CST), span: Span);
  case MacroDefCST(name: String, cases: List(CST), span: Span);
  case ExtensionCST(name: String, type_params: List(String), target_ty: CST, methods: List(CST), span: Span);
  case EffectCST(name: String, type_params: List(String), decls: List(CST), span: Span);
  case DoCST(op: CST, args: List(CST), span: Span);
  case HandleCST(body: CST, eff: String, handlers: List(CST), span: Span);
  case BoxCST(inner: CST, span: Span);
  case UnboxCST(inner: CST, span: Span);
  case ImportCST(lang: String, alias: String, mod_path: String, syms: List(String), span: Span);
  case ExternCST(lang: String, mod_path: String, decls: List(CST), span: Span);
  case ModuleCST(name: String, params: List(Pair), seal: List(CST), body: List(CST), span: Span);
  case SignatureCST(name: String, body: List(CST), span: Span);
  case FunctorAppCST(func: CST, args: List(CST), span: Span);
  case ModuleAliasCST(name: String, rhs: CST, span: Span);
  case SigValCST(name: String, type_params: List(String), params: List(Pair), ret_ty: CST, span: Span);
  case TypeDeclCST(name: String, def: List(CST), span: Span);
  case FileImportCST(name: String, path: String, span: Span);
  case SigWithCST(base: CST, eqs: List(Pair), span: Span);
  case PackCST(mod_expr: CST, sig_expr: CST, span: Span);
  case UnpackCST(name: String, sig_expr: CST, packed: CST, body: CST, span: Span)
};
