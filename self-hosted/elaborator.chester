def span_context(sp: CST.Span): List(Integer) = {
  match sp {
    case Span(_, _, ctx) => ctx
  }
};
def elab_fields(fs: List(CST)): List(AST) = {
                      if int_eq(list_length(fs), 0) then list_empty[AST]() else {
                        let f0 = list_get(fs, 0);
                        let rest = elab_fields(advance(fs));
                        let f0_res = elaborate(list_empty[Pair](), f0, OptionAST.NoneAST);
                        match f0_res {
                          case MkPair(f_ast, _) => list_insert_first(rest, f_ast)
                        }
}
};
def elab_ops(env: List(Pair), ds: List(CST)): List(EffectOp) = {
        if int_eq(list_length(ds), 0) then list_empty[EffectOp]() else {
          let d = list_get(ds, 0);
          let rest = elab_ops(env, advance(ds));
          match d {
            case DefCST(op, _, _, ret_ty, _, _) => {
              let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
              match ret_res {
                case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
              }
};
            case SeqOf(elems, _) => {
              if int_lt(list_length(elems), 2) then rest else {
                match list_get(elems, 0) {
                  case Symbol(kw, _) => {
                    if string_eq(kw, "def") then {
                      match list_get(elems, 1) {
                        case Symbol(op, _) => {
                          let ret_ty = if int_lt(list_length(elems), 4) then CST.Symbol("Any", Span(0, 0, list_empty[Integer]())) else list_get(elems, int_sub(list_length(elems), 1));
                          let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
                          match ret_res {
                            case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
                          }
};
                        case AppCST(f, _, _) => {
                          match f {
                            case Symbol(op, _) => {
                              let ret_ty = if int_lt(list_length(elems), 3) then CST.Symbol("Any", Span(0, 0, list_empty[Integer]())) else list_get(elems, int_sub(list_length(elems), 1));
                              let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
                              match ret_res {
                                case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
                              }
};
                            case _ => rest
                          }
                        };
                        case _ => rest
                      }
                    } else rest
                  };
                  case _ => rest
                }
              }
};
            case _ => rest
          }
        }
};
def elab_args(env: List(Pair), fs: List(CST)): List(AST) = {
        if int_eq(list_length(fs), 0) then list_empty[AST]() else {
          let f0_res = elaborate(env, list_get(fs, 0), OptionAST.NoneAST);
          match f0_res {
            case MkPair(f_ast, _) => list_insert_first(elab_args(env, advance(fs)), f_ast)
          }
}
};
def find_op(op_name: String, reg: List(EffectDecl)): Pair = {
            if int_eq(list_length(reg), 0) then Pair.MkPair("", AST.AstRef("Unknown")) else {
              match list_get(reg, 0) {
                case MkEffectDecl(eff, ops) => {

                  find_in_ops(op_name, eff, reg, ops)
                }
              }
            }
};
def find_in_ops(op_name: String, eff: String, reg: List(EffectDecl), os: List(EffectOp)): Pair = {
                    if int_eq(list_length(os), 0) then find_op(op_name, advance(reg)) else {
                      match list_get(os, 0) {
                        case MkEffectOp(n, _, ret_ty) => {
                          if string_eq(n, op_name) then Pair.MkPair(eff, ret_ty) else find_in_ops(op_name, eff, reg, advance(os))
                        }
                      }
                    }
};
def filter_pending(eff: String, ps: List(String)): List(String) = {
                if int_eq(list_length(ps), 0) then list_empty[String]() else {
                  let p = list_get(ps, 0);
                  let rest = filter_pending(eff, advance(ps));
                  if string_eq(p, eff) then rest else list_insert_first(rest, p)
                }
};
def merge_pending(a: List(String), b: List(String)): List(String) = {
  if int_eq(list_length(a), 0) then b else merge_pending(advance(a), list_insert_first(b, list_get(a, 0)))
};
def parse_hcase(env: List(Pair), h: CST): Pair = {
  match h {
    case SeqOf(elems, _) => {
      if int_lt(list_length(elems), 4) then Pair.MkPair("", AST.AstRef("Unit")) else {
        match list_get(elems, 1) {
          case AppCST(f, args, _) => {
            match f {
              case Symbol(op, _) => {
                let body_c = list_get(elems, int_sub(list_length(elems), 1));
                let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair("resume", list_empty[Integer]()), AST.AstPi("v", AST.AstRef("Any"), AST.AstRef("Any"), list_empty[String]())));
                let henv2 = add_binders(env, args, henv);
                let h_elab = elaborate(henv2, body_c, OptionAST.NoneAST);
                match h_elab {
                  case MkPair(h_ast, _) => Pair.MkPair(op, wrap(env, args, h_ast))
                }
              };
              case _ => Pair.MkPair("", AST.AstRef("Unit"))
            }
          };
          case Symbol(op, _) => {
            let body_c = list_get(elems, int_sub(list_length(elems), 1));
            let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair("resume", list_empty[Integer]()), AST.AstPi("v", AST.AstRef("Any"), AST.AstRef("Any"), list_empty[String]())));
            let h_elab = elaborate(henv, body_c, OptionAST.NoneAST);
            match h_elab {
              case MkPair(h_ast, _) => Pair.MkPair(op, AST.AstLam("resume", AST.AstRef("Any"), h_ast))
            }
          };
          case _ => Pair.MkPair("", AST.AstRef("Unit"))
        }
      }
    };
    case _ => Pair.MkPair("", AST.AstRef("Unit"))
  }
};
def add_binders(env: List(Pair), as_: List(CST), e0: List(Pair)): List(Pair) = {
  if int_eq(list_length(as_), 0) then e0 else {
    match list_get(as_, 0) {
      case Symbol(bn, _) => add_binders(env, advance(as_), list_insert_first(e0, Pair.MkPair(Pair.MkPair(bn, list_empty[Integer]()), AST.AstRef("Any"))));
      case _ => add_binders(env, advance(as_), e0)
    }
  }
};
def wrap(env: List(Pair), bs: List(CST), body_ast: AST): AST = {
  if int_eq(list_length(bs), 0) then AST.AstLam("resume", AST.AstRef("Any"), body_ast) else {
    match list_get(bs, 0) {
      case Symbol(bn, _) => AST.AstLam(bn, AST.AstRef("Any"), wrap(env, advance(bs), body_ast));
      case _ => wrap(env, advance(bs), body_ast)
    }
  }
};
def elab_hs(env: List(Pair), hs: List(CST)): List(Pair) = {
  if int_eq(list_length(hs), 0) then list_empty[Pair]() else {
    match parse_hcase(env, list_get(hs, 0)) {
      case MkPair(op, fn) => {
        let rest = elab_hs(env, advance(hs));
        if string_eq(op, "") then rest else list_insert_first(rest, Pair.MkPair(op, fn))
      }
    }
  }
};
def subst_ast(x: String, v: AST, body: AST): AST = {
  match body {
    case AstRef(name) => {
      if string_eq(name, x) then v else body
    };
    case AstUniverse(l) => AST.AstUniverse(l);
    case AstTuple(elems) => AST.AstTuple(list_map(elems, \e => subst_ast(x, v, e)));
    case AstStringLit(s) => AST.AstStringLit(s);
    case AstIntLit(n) => AST.AstIntLit(n);
    case AstBoolLit(b) => AST.AstBoolLit(b);
    case AstBlock(stmts, tail) => AST.AstBlock(list_map(stmts, \s => subst_ast(x, v, s)), subst_ast(x, v, tail));
    case AstApp(f, args) => AST.AstApp(subst_ast(x, v, f), list_map(args, \a => subst_ast(x, v, a)));
    case AstLam(argName, argTy, argBody) => {
      let newTy = subst_ast(x, v, argTy);
      if string_eq(argName, x) then AST.AstLam(argName, newTy, argBody) else AST.AstLam(argName, newTy, subst_ast(x, v, argBody))
    };
    case AstPi(argName, argTy, retTy, effs) => {
      let newTy = subst_ast(x, v, argTy);
      if string_eq(argName, x) then AST.AstPi(argName, newTy, retTy, effs) else AST.AstPi(argName, newTy, subst_ast(x, v, retTy), effs)
    };
    case AstLet(n, val) => AST.AstLet(n, subst_ast(x, v, val));
    case _ => body
  }
};
def whnf(expr: AST): AST = {
  match expr {
    case AstApp(f, args) => {
      let f_whnf = whnf(f);
      match f_whnf {
        case AstLam(argName, _, body) => {
          if int_eq(list_length(args), 0) then f_whnf else {
            let arg = list_get(args, 0);
            let body_subst = subst_ast(argName, arg, body);
            whnf(body_subst)
          }
};
        case _ => AST.AstApp(f_whnf, args)
      }
    };
    case _ => expr
  }
};
enum ExtMethod {
  case MkExtMethod(name: String, full: String)
};
enum ExtDecl {
  case MkExtDecl(name: String, target_ty: AST, meths: List(ExtMethod))
};
enum EffectOp {
  case MkEffectOp(name: String, arg_tys: List(AST), ret_ty: AST)
};
enum EffectDecl {
  case MkEffectDecl(name: String, ops: List(EffectOp))
};
enum ElabState {
  case MkElabState(env: List(Pair), next_var: Integer, subst: List(Pair), exts: List(ExtDecl), effects: List(EffectDecl), active: List(String), pending: List(String))
};
def get_elab_state(): ElabState = prim__get_elab_state();
def put_elab_state(s: ElabState): Unit = prim__put_elab_state(s);
def lookup_meta(id: Integer, subst: List(Pair)): OptionAST = {
  if int_eq(list_length(subst), 0) then OptionAST.NoneAST else {
    let entry = list_get(subst, 0);
    match entry {
      case MkPair(k, v) => {
        if int_eq(k, id) then OptionAST.SomeAST(v) else lookup_meta(id, advance(subst))
      }
    }
  }
};
def equiv_ast(t1: AST, t2: AST): Bool = {
  // basic equivalence for now (unification takes care of the deep stuff)
  match t1 {
    case AstUniverse(l1) => {
      match t2 {
        case AstUniverse(l2) => int_eq(l1, l2);
        case _ => false
      }
    };
    case AstRef(n1) => {
      match t2 {
        case AstRef(n2) => string_eq(n1, n2);
        case _ => false
      }
    };
    case AstMeta(m1) => {
      match t2 {
        case AstMeta(m2) => int_eq(m1, m2);
        case _ => false
      }
    };
    case _ => false
  }
};
enum OptionAST {
  case SomeAST(ast: AST);
  case NoneAST
};
def fresh_meta(): AST = {
  let s = get_elab_state();
  match s {
    case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
      let m = AST.AstMeta(next_var);
      put_elab_state(ElabState.MkElabState(env, int_add(next_var, 1), subst, exts, effects, active, pending));
      m
    }
  }
};
def unify_list(fuel: Integer, l1: List(AST), l2: List(AST)): Unit = {
  if int_eq(list_length(l1), 0) then () else {
    if int_eq(list_length(l2), 0) then () else {
      unify(fuel, list_get(l1, 0), list_get(l2, 0));
      unify_list(fuel, advance(l1), advance(l2))
    }
  }
};
def unify(fuel: Integer, t1: AST, t2: AST): Unit = {
  if int_eq(fuel, 0) then () else {
    let t1_whnf = whnf(t1);
    let t2_whnf = whnf(t2);
    match t1_whnf {
      case AstMeta(m1) => {
        match t2_whnf {
          case AstMeta(m2) => {
            if int_eq(m1, m2) then () else {
              let s = get_elab_state();
              match s {
                case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                  let v1_opt = lookup_meta(m1, subst);
                  match v1_opt {
                    case SomeAST(v1) => unify(int_sub(fuel, 1), v1, t2_whnf);
                    case OptionAST.NoneAST => {
                      let v2_opt = lookup_meta(m2, subst);
                      match v2_opt {
                        case SomeAST(v2) => unify(int_sub(fuel, 1), t1_whnf, v2);
                        case OptionAST.NoneAST => {
                          let new_subst = list_insert_first(subst, Pair.MkPair(m1, t2_whnf));
                          put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                        }
                      }
                    }
                  }
                }
              }
            }
};
          case _ => {
            let s = get_elab_state();
            match s {
              case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                let v1_opt = lookup_meta(m1, subst);
                match v1_opt {
                  case SomeAST(v1) => unify(int_sub(fuel, 1), v1, t2_whnf);
                  case OptionAST.NoneAST => {
                    let new_subst = list_insert_first(subst, Pair.MkPair(m1, t2_whnf));
                    put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                  }
                }
              }
            }
          }
        }
      };
      case AstApp(f1, a1) => {
        match t2_whnf {
          case AstApp(f2, a2) => {
            unify(int_sub(fuel, 1), f1, f2);
            unify_list(int_sub(fuel, 1), a1, a2)
          };
          case AstMeta(m2) => {
            let s = get_elab_state();
            match s {
              case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                let v2_opt = lookup_meta(m2, subst);
                match v2_opt {
                  case SomeAST(v2) => unify(int_sub(fuel, 1), t1_whnf, v2);
                  case OptionAST.NoneAST => {
                    let new_subst = list_insert_first(subst, Pair.MkPair(m2, t1_whnf));
                    put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                  }
                }
              }
            }
          };
          case _ => ()
        }
      };
      case AstPi(_, ty1, ret1, eff1) => {
        match t2_whnf {
          case AstPi(_, ty2, ret2, eff2) => {
            unify(int_sub(fuel, 1), ty1, ty2);
            unify(int_sub(fuel, 1), ret1, ret2);
            if effect_rows_compatible(eff1, eff2) then () else ()
          };
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      };
      case AstFunTy(_, _, ret1, eff1) => {
        match t2_whnf {
          case AstFunTy(_, _, ret2, eff2) => {
            unify(int_sub(fuel, 1), ret1, ret2);
            if effect_rows_compatible(eff1, eff2) then () else ()
          };
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      };
      case _ => {
        match t2_whnf {
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      }
    }
  }
};
def list_nat_eq(l1: List(Integer), l2: List(Integer)): Bool = {
  if int_eq(list_length(l1), 0) then {
    if int_eq(list_length(l2), 0) then true else false
} else {
    if int_eq(list_length(l2), 0) then false else {
      let x = list_get(l1, 0);
      let y = list_get(l2, 0);
      if int_eq(x, y) then list_nat_eq(advance(l1), advance(l2)) else false
    }
}
};
def lookup_type(name: String, ctx: List(Integer), env: List(Pair)): OptionAST = {
  if int_eq(list_length(env), 0) then OptionAST.NoneAST else {
    let entry = list_get(env, 0);
    match entry {
      case MkPair(k, v) => {
        match k {
          case MkPair(k_name, k_ctx) => {
            if string_eq(name, k_name) then {
              if list_nat_eq(ctx, k_ctx) then OptionAST.SomeAST(v) else lookup_type(name, ctx, advance(env))
} else {
              lookup_type(name, ctx, advance(env))
            }
}
        }
      }
    }
  }
};
def resolve_hygiene(env: List(Pair), name: String, ctx: List(Integer)): Pair = {
  let res = lookup_type(name, ctx, env);
  match res {
    case SomeAST(ty) => Pair.MkPair(ty, ctx);
    case OptionAST.NoneAST => {
      if int_eq(list_length(ctx), 0) then Pair.MkPair(AST.AstError("Not found"), ctx) else resolve_hygiene(env, name, advance(ctx))
    }
  }
};
def join_ctx(ls: List(Integer)): String = {
  if int_eq(list_length(ls), 0) then "" else string_append(string_append("_", int_to_string(list_get(ls, 0))), join_ctx(advance(ls)))
};
def mangle_name(n: String, ctx: List(Integer)): String = {
  if int_eq(list_length(ctx), 0) then n else string_append(n, join_ctx(ctx))
};
def append_env(e1: List(Pair), e2: List(Pair)): List(Pair) = {
  if int_eq(list_length(e1), 0) then e2 else list_insert_first(append_env(advance(e1), e2), list_get(e1, 0))
};
def string_in_list(s: String, xs: List(String)): Bool = {
  if int_eq(list_length(xs), 0) then false else {
    if string_eq(s, list_get(xs, 0)) then true else string_in_list(s, advance(xs))
  }
};
def is_row_var(s: String): Bool = {
  if int_eq(string_length(s), 0) then false else string_eq(string_substring(s, 0, 1), "μ")
};
def effect_in_row(label: String, provided: List(String)): Bool = {
  if int_eq(list_length(provided), 0) then false else {
    if is_row_var(list_get(provided, 0)) then true else {
      if string_eq(label, list_get(provided, 0)) then true else effect_in_row(label, advance(provided))
    }
}
};
def effect_row_subsumes(needed: List(String), provided: List(String)): Bool = {
  if int_eq(list_length(needed), 0) then true else {
    let n = list_get(needed, 0);
    if is_row_var(n) then effect_row_subsumes(advance(needed), provided) else {
      if effect_in_row(n, provided) then effect_row_subsumes(advance(needed), provided) else false
    }
}
};
def effect_rows_compatible(e1: List(String), e2: List(String)): Bool = {
  if effect_row_subsumes(e1, e2) then true else effect_row_subsumes(e2, e1)
};
def effect_labels(es: List(String)): List(String) = {
  if int_eq(list_length(es), 0) then list_empty[String]() else {
    if is_row_var(list_get(es, 0)) then effect_labels(advance(es)) else list_insert_first(effect_labels(advance(es)), list_get(es, 0))
  }
};
def effects_covered_by(needed: List(String), active: List(String)): Bool = {
  if int_eq(list_length(needed), 0) then true else {
    let n = list_get(needed, 0);
    if is_row_var(n) then effects_covered_by(advance(needed), active) else {
      if string_in_list(n, active) then effects_covered_by(advance(needed), active) else false
    }
}
};
def add_effect(e: String, es: List(String)): List(String) = {
  if string_in_list(e, es) then es else list_insert_first(es, e)
};
def merge_effects(a: List(String), b: List(String)): List(String) = {
  if int_eq(list_length(a), 0) then b else merge_effects(advance(a), add_effect(list_get(a, 0), b))
};
def fresh_row_var(): String = {
  let s = get_elab_state();
  match s {
    case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
      put_elab_state(ElabState.MkElabState(env, int_add(next_var, 1), subst, exts, effects, active, pending));
      string_concat("μ", int_to_string(next_var))
    }
  }
};
def with_open_row(effs: List(String)): List(String) = {
  list_append(effs, fresh_row_var())
};
def elab_extract_vars(args: List(CST)): List(String) = {
  if int_eq(list_length(args), 0) then list_empty[String]() else {
    let a = list_get(args, 0);
    let rest = elab_extract_vars(advance(args));
    match a {
      case Symbol(s, _) => list_insert_first(rest, s);
      case _ => rest
    }
  }
};
def add_vars_to_env(env: List(Pair), vars: List(String), ctx: List(Integer)): List(Pair) = {
  if int_eq(list_length(vars), 0) then env else {
    let v = list_get(vars, 0);
    let rest = add_vars_to_env(env, advance(vars), ctx);
    list_insert_first(rest, Pair.MkPair(Pair.MkPair(v, ctx), fresh_meta()))
  }
};
def elab_check_args(env: List(Pair), fs: AST, as_: List(CST)): Pair = {
  if int_eq(list_length(as_), 0) then Pair.MkPair(list_empty[AST](), fs) else {
    let a = list_get(as_, 0);
    let rest = advance(as_);
    match fs {
      case AstPi(_, arg_ty, ret_ty, _) => {
        let aAst_res = elaborate(env, a, OptionAST.SomeAST(arg_ty));
        match aAst_res {
          case MkPair(aAst_expr, _) => {
            let restAst_res = elab_check_args(env, ret_ty, rest);
            match restAst_res {
              case MkPair(restAst_exprs, restAst_ty) => {
                Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
              }
            }
          }
        }
      };
      case AstRef(name) => {
        if string_eq(name, "Any") then {
          let aAst_res = elaborate(env, a, OptionAST.NoneAST);
          match aAst_res {
            case MkPair(aAst_expr, _) => {
              let restAst_res = elab_check_args(env, AST.AstRef("Any"), rest);
              match restAst_res {
                case MkPair(restAst_exprs, _) => {
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), AST.AstRef("Any"))
                }
              }
            }
          }
        } else {
          let argTyM = fresh_meta();
          let retTyM = fresh_meta();
          unify(100, fs, AST.AstPi("x", argTyM, retTyM, list_empty[String]()));
          let aAst_res = elaborate(env, a, OptionAST.SomeAST(argTyM));
          match aAst_res {
            case MkPair(aAst_expr, _) => {
              let restAst_res = elab_check_args(env, retTyM, rest);
              match restAst_res {
                case MkPair(restAst_exprs, restAst_ty) => {
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
                }
              }
            }
          }
        }
};
      case _ => {
        let argTyM = fresh_meta();
        let retTyM = fresh_meta();
        unify(100, fs, AST.AstPi("x", argTyM, retTyM, list_empty[String]()));
        let aAst_res = elaborate(env, a, OptionAST.SomeAST(argTyM));
        match aAst_res {
          case MkPair(aAst_expr, _) => {
            let restAst_res = elab_check_args(env, retTyM, rest);
            match restAst_res {
              case MkPair(restAst_exprs, restAst_ty) => {
                Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
              }
            }
          }
        }
      }
    }
  }
};
def elab_extern_decls(env: List(Pair), decls: List(CST)): Pair = {
  if int_eq(list_length(decls), 0) then Pair.MkPair(list_empty[String](), env) else {
    let d = list_get(decls, 0);
    let rest = advance(decls);
    match d {
      case DefCST(op, _, _, _, _, span) => {
        let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
        let rest_res = elab_extern_decls(new_env, rest);
        match rest_res {
          case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
        }
      };
      case SeqOf(elems, span) => {
        if int_lt(list_length(elems), 2) then elab_extern_decls(env, rest) else {
          match list_get(elems, 0) {
            case Symbol(kw, _) => {
              if string_eq(kw, "def") then {
                match list_get(elems, 1) {
                  case Symbol(op, _) => {
                    let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
                    let rest_res = elab_extern_decls(new_env, rest);
                    match rest_res {
                      case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
                    }
                  };
                  case AppCST(f, _, _) => {
                    match f {
                      case Symbol(op, _) => {
                        let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
                        let rest_res = elab_extern_decls(new_env, rest);
                        match rest_res {
                          case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
                        }
                      };
                      case _ => elab_extern_decls(env, rest)
                    }
                  };
                  case _ => elab_extern_decls(env, rest)
                }
              } else elab_extern_decls(env, rest)
            };
            case _ => elab_extern_decls(env, rest)
          }
        }
      };
      case _ => elab_extern_decls(env, rest)
    }
  }
};
def map_elabs(env: List(Pair), ls: List(CST)): Pair = {
  if int_eq(list_length(ls), 0) then Pair.MkPair(list_empty[AST](), env) else {
    let x = list_get(ls, 0);
    let xs = advance(ls);
    match x {
      case LetCST(name, value, _, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, vTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let let_node = AST.AstLet(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, let_node), final_env)
              }
            }
          }
        }
      };
      case VarCST(name, value, _, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, vTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let var_node = AST.AstVar(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, var_node), final_env)
              }
            }
          }
        }
      };
      case AssignCST(name, value, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, _) => {
            let rest_res = map_elabs(env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let asg = AST.AstAssign(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, asg), final_env)
              }
            }
          }
        }
      };
      case DefCST(name, _, _, ret_ty, _, span) => {
        let tyAst_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
        match tyAst_res {
          case MkPair(tAst, _) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), tAst));
            let res = elaborate(env, x, OptionAST.NoneAST);
            match res {
              case MkPair(rAst, _) => {
                let rest_res = map_elabs(new_env, xs);
                match rest_res {
                  case MkPair(restAst, final_env) => {
                    Pair.MkPair(list_insert_first(restAst, rAst), final_env)
                  }
                }
              }
            }
          }
        }
      };
      case ImportCST(lang, alias, mod_path, syms, _) => {
        let rest_res = map_elabs(env, xs);
        match rest_res {
          case MkPair(restAst, final_env) => {
            Pair.MkPair(list_insert_first(restAst, AST.AstImport(lang, alias, mod_path, syms)), final_env)
          }
        }
      };
      case ExternCST(lang, mod_path, decls, _) => {
        let ext_res = elab_extern_decls(env, decls);
        match ext_res {
          case MkPair(syms, new_env) => {
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                Pair.MkPair(list_insert_first(restAst, AST.AstImport(lang, "", mod_path, syms)), final_env)
              }
            }
          }
        }
      };
      case _ => {
        let res = elaborate(env, x, OptionAST.NoneAST);
        match res {
          case MkPair(rAst, _) => {
            let rest_res = map_elabs(env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                Pair.MkPair(list_insert_first(restAst, rAst), final_env)
              }
            }
          }
        }
      }
    }
  }
};
def elab_map_params(env: List(Pair), ps: List(CST)): Pair = {
  if int_eq(list_length(ps), 0) then Pair.MkPair(list_empty[Pair](), list_empty[Pair]()) else {
    let p = list_get(ps, 0);
    let rest_res = elab_map_params(env, advance(ps));
    match rest_res {
      case MkPair(restAst, restEnvItems) => {
        match p {
          case Tuple(elems, sp) => {
            if int_eq(list_length(elems), 2) then {
              let pname_cst = list_get(elems, 0);
              let pty_cst = list_get(elems, 1);
              match pname_cst {
                case Symbol(pname, _) => {
                  let tyAst_res = elaborate(env, pty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                  match tyAst_res {
                    case MkPair(tAst, _) => {
                      Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
                    }
                  }
                };
                case _ => rest_res
              }
            } else rest_res
          };
          // Expander extract_params builds SeqOf(name, ":", ty, …)
          case SeqOf(elems, sp) => {
            if int_lt(list_length(elems), 2) then rest_res else {
              match list_get(elems, 0) {
                case Symbol(pname, _) => {
                  match list_get(elems, 1) {
                    case Symbol(kw, _) => {
                      if string_eq(kw, ":") then {
                        let pty_cst = if int_eq(list_length(elems), 3) then list_get(elems, 2) else SeqOf(advance(advance(elems)), sp);
                        let tyAst_res = elaborate(env, pty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                        match tyAst_res {
                          case MkPair(tAst, _) => {
                            Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
                          }
                        }
                      } else rest_res
                    };
                    case _ => rest_res
                  }
                };
                case _ => rest_res
              }
            }
          };
          case Symbol(pname, sp) => {
            let tAst = AST.AstRef("Unknown");
            Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
          };
          case _ => rest_res
        }
      }
    }
  }
};
def elab_check_targs(env: List(Pair), as_: List(CST)): List(AST) = {
  if int_eq(list_length(as_), 0) then list_empty[AST]() else {
    let a = list_get(as_, 0);
    let rest = elab_check_targs(env, advance(as_));
    let aAst_res = elaborate(env, a, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
    match aAst_res {
      case MkPair(aAst_expr, _) => list_insert_first(rest, aAst_expr)
    }
}
};
def elab_variant(v: CST): Pair = {
  match v {
    case AppCST(f, args, _) => {
      match f {
        case Symbol(op, _) => {
          if string_eq(op, ":") then {
            let lhs = list_get(args, 0);
            let rhs = list_get(args, 1);
            let rhs_res = elaborate(list_empty[Pair](), rhs, OptionAST.NoneAST);
            let ret_ty = match rhs_res {
              case MkPair(ast, _) => ast
            };
            match lhs {
              case AppCST(inner_f, inner_args, _) => {
                match inner_f {
                  case Symbol(vname, _) => {

                    Pair.MkPair(vname, Pair.MkPair(elab_fields(inner_args), ret_ty))
                  };
                  case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), ret_ty))
                }
              };
              case Symbol(vname, _) => Pair.MkPair(vname, Pair.MkPair(list_empty[AST](), ret_ty));
              case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), ret_ty))
            }
          } else Pair.MkPair(op, Pair.MkPair(elab_fields(args), AST.AstRef("Any")))
        };
        case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), AST.AstRef("Any")))
      }
    };
    case Symbol(vname, _) => Pair.MkPair(vname, Pair.MkPair(list_empty[AST](), AST.AstRef("Any")));
    case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), AST.AstRef("Any")))
  }
};
def elab_variants(vs: List(CST)): List(Pair) = {
  if int_eq(list_length(vs), 0) then list_empty[Pair]() else {
    let v = list_get(vs, 0);
    list_insert_first(elab_variants(advance(vs)), elab_variant(v))
  }
};
def elab_cases(env: List(Pair), expected: OptionAST, cs: List(CST), expr_ty: AST): Pair = {
  if int_eq(list_length(cs), 0) then Pair.MkPair(list_empty[Pair](), AST.AstRef("Any")) else {
    let c = list_get(cs, 0);
    let rest_res = elab_cases(env, expected, advance(cs), expr_ty);
    match c {
      case SeqOf(elems, _) => {
        if int_eq(list_length(elems), 2) then {
          let pat_cst = list_get(elems, 0);
          let body_cst = list_get(elems, 1);
          let pat_ast_res = match pat_cst {
            case Symbol(pname, _) => {
              if string_eq(pname, "_") then PatternAST.PatWildcard else PatternAST.PatVar(pname)
            };
            case FieldAccess(_, field, _) => PatternAST.PatConstructor(field, list_empty[String]());
            case AppCST(f, args, _) => {
              match f {
                case Symbol(cname, _) => PatternAST.PatConstructor(cname, elab_extract_vars(args));
                case FieldAccess(_, field, _) => PatternAST.PatConstructor(field, elab_extract_vars(args));
                case _ => PatternAST.PatWildcard
              }
            };
            case _ => PatternAST.PatWildcard
          };
          let case_env = match pat_ast_res {
            case PatVar(v) => list_insert_first(env, Pair.MkPair(Pair.MkPair(v, list_empty[Integer]()), fresh_meta()));
            case PatConstructor(_, vars) => add_vars_to_env(env, vars, list_empty[Integer]());
            case _ => env
          };
          let old_state = get_elab_state();
          match pat_ast_res {
            case PatConstructor(cname, _) => {
              let ctor_ty = resolve_hygiene(env, cname, list_empty[Integer]());
              match ctor_ty {
                case MkPair(ty, _) => unify(100, expr_ty, ty);
                case _ => ()
              }
            };
            case _ => ()
          };
          let body_ast_res = elaborate(case_env, body_cst, expected);
          // Restore the solver state (but keep next_var so we don't reuse meta IDs)
          let new_state = get_elab_state();
          match old_state {
            case MkElabState(_, _, old_subst, _, _, _, _) => {
              match new_state {
                case MkElabState(new_e, new_nv, _, new_exts, new_effects, new_active, new_pending) => {
                  put_elab_state(ElabState.MkElabState(new_e, new_nv, old_subst, new_exts, new_effects, new_active, new_pending))
                }
              }
            }
          }
          match body_ast_res {
            case MkPair(bAst, bTy) => {
              match rest_res {
                case MkPair(restAst, _) => {
                  Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pat_ast_res, bAst)), bTy)
                }
              }
            }
          }
        } else rest_res
      };
      case _ => rest_res
    }
  }
};
def elab_tuple_elems(env: List(Pair), es: List(CST)): Pair = {
  if int_eq(list_length(es), 0) then Pair.MkPair(list_empty[AST](), AST.AstRef("Unit")) else {
    let e = list_get(es, 0);
    let eAst_res = elaborate(env, e, OptionAST.NoneAST);
    match eAst_res {
      case MkPair(eAst, _) => {
        let rest_res = elab_tuple_elems(env, advance(es));
        match rest_res {
          case MkPair(restAst, _) => {
            Pair.MkPair(list_insert_first(restAst, eAst), AST.AstRef("Tuple"))
          }
        }
      }
    }
  }
};
def get_base_type(t: AST): AST = {
  match t {
    case AstApp(f, _) => get_base_type(f);
    case AstImplicitApp(f, _) => get_base_type(f);
    case _ => t
  }
};
def check_type_match(target: AST, actual: AST): Bool = {
  let bt1 = get_base_type(target);
  let bt2 = get_base_type(actual);
  match bt1 {
    case AstRef(n1) => {
      match bt2 {
        case AstRef(n2) => string_eq(n1, n2);
        case _ => false
      }
    };
    case _ => false
  }
};
def lookup_ext_method(field: String, meths: List(ExtMethod)): String = {
  if int_eq(list_length(meths), 0) then "" else {
    let m = list_get(meths, 0);
    match m {
      case MkExtMethod(n, full) => {
        if string_eq(n, field) then full else lookup_ext_method(field, advance(meths))
      }
    }
  }
};
def find_ext_method(ty: AST, field: String, exts: List(ExtDecl)): String = {
  // Match Rocq: only typed lookup (no any-name fallback that picks StringOps for List).
  find_ext_method_typed(ty, field, exts)
};
def find_ext_method_typed(ty: AST, field: String, exts: List(ExtDecl)): String = {
  if int_eq(list_length(exts), 0) then "" else {
    let ext = list_get(exts, 0);
    match ext {
      case MkExtDecl(_, target_ty, meths) => {
        if check_type_match(target_ty, ty) then {
          let meth_name = lookup_ext_method(field, meths);
          if string_eq(meth_name, "") then find_ext_method_typed(ty, field, advance(exts)) else meth_name
        } else find_ext_method_typed(ty, field, advance(exts))
      }
    }
  }
};
def find_ext_method_any(field: String, exts: List(ExtDecl)): String = {
  if int_eq(list_length(exts), 0) then "" else {
    let ext = list_get(exts, 0);
    match ext {
      case MkExtDecl(_, _, meths) => {
        let meth_name = lookup_ext_method(field, meths);
        if string_eq(meth_name, "") then find_ext_method_any(field, advance(exts)) else meth_name
      }
    }
  }
};
def extract_ext_methods(meths: List(CST), ext_name: String): List(ExtMethod) = {
  if int_eq(list_length(meths), 0) then list_empty[ExtMethod]() else {
    let m = list_get(meths, 0);
    let rest = extract_ext_methods(advance(meths), ext_name);
    match m {
      case DefCST(n, _, _, _, _, _) => {
        let full = string_append(string_append(ext_name, "_"), n);
        list_insert_first(rest, ExtMethod.MkExtMethod(n, full))
      };
      case _ => rest
    }
  }
};
def elab_ext_methods(env: List(Pair), meths: List(CST), ext_name: String): List(AST) = {
  if int_eq(list_length(meths), 0) then list_empty[AST]() else {
    let m = list_get(meths, 0);
    let rest = elab_ext_methods(env, advance(meths), ext_name);
    match m {
      case DefCST(n, tps, ps, rt, b, sp) => {
        let full_name = string_append(string_append(ext_name, "_"), n);
        let mod_m = CST.DefCST(full_name, tps, ps, rt, b, sp);
        let res = elaborate(env, mod_m, OptionAST.NoneAST);
        match res {
          case MkPair(ast, _) => list_insert_first(rest, ast)
        }
};
      case _ => rest
    }
  }
};
def zonk_list(fuel: Integer, l: List(AST)): List(AST) = {
  if int_eq(list_length(l), 0) then list_empty[AST]() else {
    let hd = zonk(fuel, list_get(l, 0));
    let tl = zonk_list(fuel, advance(l));
    list_insert_first(tl, hd)
  }
};
def zonk(fuel: Integer, expr: AST): AST = {
  if int_eq(fuel, 0) then expr else {
    match expr {
      case AstMeta(m) => {
        let s = get_elab_state();
        match s {
          case MkElabState(_, _, subst, _, _, _, _) => {
            let v_opt = lookup_meta(m, subst);
            match v_opt {
              case SomeAST(v) => zonk(int_sub(fuel, 1), v);
              case OptionAST.NoneAST => expr
            }
          }
        }
      };
      case AstApp(f, args) => AST.AstApp(zonk(int_sub(fuel, 1), f), zonk_list(int_sub(fuel, 1), args));
      case AstPi(n, ty, ret, effs) => AST.AstPi(n, zonk(int_sub(fuel, 1), ty), zonk(int_sub(fuel, 1), ret), effs);
      case AstLam(n, ty, body) => AST.AstLam(n, zonk(int_sub(fuel, 1), ty), zonk(int_sub(fuel, 1), body));
      case AstBlock(stmts, tail) => AST.AstBlock(zonk_list(int_sub(fuel, 1), stmts), zonk(int_sub(fuel, 1), tail));
      case AstTuple(elems) => AST.AstTuple(zonk_list(int_sub(fuel, 1), elems));
      case AstLet(n, v) => AST.AstLet(n, zonk(int_sub(fuel, 1), v));
      case AstIf(c, t, e) => AST.AstIf(zonk(int_sub(fuel, 1), c), zonk(int_sub(fuel, 1), t), zonk(int_sub(fuel, 1), e));
      case _ => expr
    }
  }
};
def elaborate(env: List(Pair), expr: CST, expected: OptionAST): Pair = {
  match expr {
    case Symbol(name, span) => {
      let res = resolve_hygiene(env, name, span_context(span));
      match res {
        case MkPair(ty, resolved_ctx) => {
          match ty {
            case AstError(_) => Pair.MkPair(AST.AstRef(name), AST.AstRef("Any"));
            case _ => {
              match expected {
                case SomeAST(exp) => {
                  unify(100, ty, exp);
                  Pair.MkPair(AST.AstRef(mangle_name(name, resolved_ctx)), ty)
                };
                case OptionAST.NoneAST => Pair.MkPair(AST.AstRef(mangle_name(name, resolved_ctx)), ty)
              }
            }
          }
        }
      }
    };
    case StringLiteral(s, _) => {
      let str_ty = AST.AstRef("String");
      match expected {
        case SomeAST(exp) => unify(100, str_ty, exp);
        case OptionAST.NoneAST => ()
      };
      Pair.MkPair(AST.AstStringLit(s), str_ty)
    };
    case IntegerLiteral(s, _) => {
      let int_ty = AST.AstRef("Int");
      match expected {
        case SomeAST(exp) => unify(100, int_ty, exp);
        case OptionAST.NoneAST => ()
      };
      Pair.MkPair(AST.AstIntLit(string_to_int(s)), int_ty)
    };
    case BoolLiteral(b, _) => {
      let bool_ty = AST.AstRef("Bool");
      match expected {
        case SomeAST(exp) => unify(100, bool_ty, exp);
        case OptionAST.NoneAST => ()
      };
      Pair.MkPair(AST.AstBoolLit(b), bool_ty)
    };
    case SeqOf(elems, _) => {
      if int_eq(list_length(elems), 0) then Pair.MkPair(AST.AstError("Empty SeqOf"), AST.AstRef("Any")) else {
        let f = list_get(elems, 0);
        let args = advance(elems);
        let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
        match funcAst_res {
          case MkPair(fAst, fTy) => {
            let args_res = elab_check_args(env, fTy, args);
            match args_res {
              case MkPair(argsAst, argsTy) => {
                match expected {
                  case SomeAST(exp) => unify(100, argsTy, exp);
                  case OptionAST.NoneAST => ()
                };
                Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
              }
            }
          }
        }
      }
};
    case Block(stmts, tail, _) => {
      let stmtsRes = map_elabs(env, stmts);
      match stmtsRes {
        case MkPair(stmtsAst, final_env) => {
          let retAst_res = elaborate(final_env, tail, OptionAST.NoneAST);
          match retAst_res {
            case MkPair(rAst, rTy) => {
              Pair.MkPair(AST.AstBlock(stmtsAst, rAst), rTy)
            }
          }
        }
      }
    };
    case LetCST(name, value, next, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, vTy) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
          let bodyAst_res = elaborate(new_env, next, expected);
          match bodyAst_res {
            case MkPair(bAst, bTy) => {
              let stmts = list_insert_first(list_empty[AST](), AST.AstLet(mangle_name(name, span_context(span)), vAst));
              Pair.MkPair(AST.AstBlock(stmts, bAst), bTy)
            }
          }
        }
      }
    };
    case VarCST(name, value, next, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, vTy) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
          let bodyAst_res = elaborate(new_env, next, expected);
          match bodyAst_res {
            case MkPair(bAst, bTy) => {
              let stmts = list_insert_first(list_empty[AST](), AST.AstVar(mangle_name(name, span_context(span)), vAst));
              Pair.MkPair(AST.AstBlock(stmts, bAst), bTy)
            }
          }
        }
      }
    };
    case AssignCST(name, value, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, _) => Pair.MkPair(AST.AstAssign(mangle_name(name, span_context(span)), vAst), AST.AstRef("Unit"))
      }
};
    case BoxCST(inner, _) => {
      let s0 = get_elab_state();
      match s0 {
        case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
          put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
          let inner_res = elaborate(env, inner, OptionAST.NoneAST);
          match inner_res {
            case MkPair(iAst, innerTy) => {
              let s1 = get_elab_state();
              match s1 {
                case MkElabState(e1, nv1, sub1, ex1, ef1, act1, caps) => {
                  put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, pend0));
                  let ty_effs = if effects_covered_by(caps, act1) then list_empty[String]() else caps;
                  let box_ty = AST.AstPi("x", AST.AstRef("Unit"), innerTy, ty_effs);
                  Pair.MkPair(AST.AstBox(iAst, caps), box_ty)
                }
              }
            }
          }
        }
      }
    };
    case UnboxCST(inner, _) => {
      let inner_res = elaborate(env, inner, OptionAST.NoneAST);
      match inner_res {
        case MkPair(iAst, iTy) => {
          let caps = match iTy {
            case AstPi(_, _, _, effs) => effect_labels(effs);
            case AstFunTy(_, _, _, effs) => effect_labels(effs);
            case _ => list_empty[String]()
          };
          let s = get_elab_state();
          match s {
            case MkElabState(e, nv, sub, ex, ef, act, pending) => {
              put_elab_state(ElabState.MkElabState(e, nv, sub, ex, ef, act, merge_effects(pending, caps)));
              let ret_ty = match iTy {
                case AstPi(_, _, ret_ty, _) => ret_ty;
                case AstFunTy(_, _, ret_ty, _) => ret_ty;
                case _ => iTy
              };
              Pair.MkPair(AST.AstUnbox(iAst), ret_ty)
            }
          }
        }
      }
    };
    case IfCST(cond, thenB, elseB, _) => {
      let condAst_res = elaborate(env, cond, OptionAST.NoneAST);
      match condAst_res {
        case MkPair(cAst, _) => {
          let thenAst_res = elaborate(env, thenB, expected);
          match thenAst_res {
            case MkPair(tAst, tTy) => {
              let elseAst_res = elaborate(env, elseB, expected);
              match elseAst_res {
                case MkPair(eAst, _) => {
                  Pair.MkPair(AST.AstIf(cAst, tAst, eAst), tTy)
                }
              }
            }
          }
        }
      }
    };
    case DefCST(name, type_params, params, ret_ty, body, _) => {
      let params_res = elab_map_params(env, params);
      match params_res {
        case MkPair(paramsAst, envItems) => {
          let body_env = append_env(envItems, env);
          let retAst_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
          match retAst_res {
            case MkPair(rAst, _) => {
              let s0 = get_elab_state();
              match s0 {
                case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
                  put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
                  let bodyAst_res = elaborate(body_env, body, OptionAST.SomeAST(rAst));
                  match bodyAst_res {
                    case MkPair(bAst, _) => {
                      let s1 = get_elab_state();
                      match s1 {
                        case MkElabState(e1, nv1, sub1, ex1, ef1, act1, body_effs) => {
                          let open_effs = with_open_row(body_effs);
                          put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, merge_effects(pend0, body_effs)));
                          let fun_ty = AST.AstFunTy(type_params, paramsAst, rAst, open_effs);
                          Pair.MkPair(AST.AstDef(name, type_params, paramsAst, rAst, bAst), fun_ty)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    case LamCST(arg_name, opt_arg_ty, body, span) => {
      let argTyAst_res = match opt_arg_ty {
        case Error(_, _) => {
          let m = fresh_meta();
          Pair.MkPair(m, AST.AstRef("TypeUniverse"))
        };
        case _ => elaborate(env, opt_arg_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")))
      };
      match argTyAst_res {
        case MkPair(argTyAst, _) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(arg_name, span_context(span)), argTyAst));
          let s0 = get_elab_state();
          match s0 {
            case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
              put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
              let bodyAst_res = elaborate(new_env, body, OptionAST.NoneAST);
              match bodyAst_res {
                case MkPair(bAst, bTy) => {
                  let s1 = get_elab_state();
                  match s1 {
                    case MkElabState(e1, nv1, sub1, ex1, ef1, act1, body_effs) => {
                      let open_effs = with_open_row(body_effs);
                      put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, merge_effects(pend0, body_effs)));
                      let arrTy = AST.AstPi(arg_name, argTyAst, bTy, open_effs);
                      Pair.MkPair(AST.AstLam(mangle_name(arg_name, span_context(span)), argTyAst, bAst), arrTy)
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    case AppCST(f, args, span) => {
      match f {
        case FieldAccess(expr, field, fsp) => {
          let exprAst_res = elaborate(env, expr, OptionAST.NoneAST);
          match exprAst_res {
            case MkPair(eAst, eTy) => {
              let state = get_elab_state();
              let full_name = match state {
                case MkElabState(_, _, _, exts, _, _, _) => find_ext_method(eTy, field, exts)
              };
              if string_eq(full_name, "") then {
                let funcAst = AST.AstFieldAccess(eAst, field);
                let args_res = elab_check_args(env, AST.AstRef("UnknownType"), args);
                match args_res {
                  case MkPair(argsAst, argsTy) => Pair.MkPair(AST.AstApp(funcAst, argsAst), argsTy)
                }
} else {
                let new_cst = AppCST(Symbol(full_name, fsp), list_insert_first(args, expr), span);
                elaborate(env, new_cst, expected)
              }
}
          }
        };
        case ImplicitAppCST(inner_func, targs, _) => {
          // Match Rocq: erase [A,B] telescope; keep only the inner function in the App.
          let funcAst_res = elaborate(env, inner_func, OptionAST.NoneAST);
          match funcAst_res {
            case MkPair(fAst, fTy) => {
              let _targsAst = elab_check_targs(env, targs);
              let args_res = elab_check_args(env, fTy, args);
              match args_res {
                case MkPair(argsAst, argsTy) => {
                  match expected {
                    case SomeAST(exp) => unify(100, argsTy, exp);
                    case OptionAST.NoneAST => ()
                  };
                  Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
                }
              }
            }
          }
        };
        case _ => {
          let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
          match funcAst_res {
            case MkPair(fAst, fTy) => {
              let args_res = elab_check_args(env, fTy, args);
              match args_res {
                case MkPair(argsAst, argsTy) => {
                  match expected {
                    case SomeAST(exp) => unify(100, argsTy, exp);
                    case OptionAST.NoneAST => ()
                  };
                  Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
                }
              }
            }
          }
        }
      }
    };
    case ImplicitAppCST(f, targs, _) => {
      // Standalone implicit application f[A,B] — used in type position only
      let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
      match funcAst_res {
        case MkPair(fAst, _) => {
          let targsAst_res = elab_check_targs(env, targs);
          Pair.MkPair(AST.AstImplicitApp(fAst, targsAst_res), AST.AstRef("TypeUniverse"))
        }
      }
    };
    case EnumCST(name, type_params, variants, _) => {
      let vs = elab_variants(variants);
      Pair.MkPair(AST.AstEnum(name, type_params, vs), AST.AstRef("Unit"))
    };
    case MatchCST(expr, cases, _) => {
      let exprAst_res = elaborate(env, expr, OptionAST.NoneAST);
      match exprAst_res {
        case MkPair(eAst, eTy) => {
          let cases_res = elab_cases(env, expected, cases, eTy);
          match cases_res {
            case MkPair(cAsts, cTy) => {
              Pair.MkPair(AST.AstMatch(eAst, cAsts), cTy)
            }
          }
        }
      }
    };
    case Tuple(elems, _) => {
      let res = elab_tuple_elems(env, elems);
      match res {
        case MkPair(asts, ty) => Pair.MkPair(AST.AstTuple(asts), ty)
      }
};
    case ListLiteral(elems, _) => {
      let res = elab_tuple_elems(env, elems);
      match res {
        case MkPair(asts, _) => Pair.MkPair(AST.AstTuple(asts), AST.AstRef("List"))
      }
};
    case RecordCST(name, type_params, _, _) => {
      Pair.MkPair(AST.AstRecord(name, type_params, list_empty[Pair]()), AST.AstRef("Unit"))
    };
    case FieldAccess(expr, field, _) => {
      let eAst_res = elaborate(env, expr, OptionAST.NoneAST);
      match eAst_res {
        case MkPair(eAst, _) => Pair.MkPair(AST.AstFieldAccess(eAst, field), AST.AstRef("TypeUniverse"))
      }
};
    case ExtensionCST(ext_name, tparams, target_ty, meths, _) => {
      let targetTy_res = elaborate(env, target_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
      match targetTy_res {
        case MkPair(tAst, _) => {
          let state = get_elab_state();
          match state {
            case MkElabState(e, next_var, subst, exts, effects, active, pending) => {
              let ext_meths = extract_ext_methods(meths, ext_name);
              let new_ext = ExtDecl.MkExtDecl(ext_name, tAst, ext_meths);
              put_elab_state(ElabState.MkElabState(e, next_var, subst, list_insert_first(exts, new_ext), effects, active, pending));
              let meths_res = elab_ext_methods(env, meths, ext_name);
              Pair.MkPair(AST.AstExtension(ext_name, tparams, tAst, meths_res), AST.AstRef("Unit"))
            }
          }
        }
      }
    };
    case Error(msg, _) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
    case Comment(_, _) => Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"));
    case MacroDefCST(_, _, _) => Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"));
    case ImportCST(lang, alias, mod_path, syms, _) => {
      Pair.MkPair(AST.AstImport(lang, alias, mod_path, syms), AST.AstRef("Unit"))
    };
    case ExternCST(lang, mod_path, decls, _) => {
      let ext_res = elab_extern_decls(env, decls);
      match ext_res {
        case MkPair(syms, _) => Pair.MkPair(AST.AstImport(lang, "", mod_path, syms), AST.AstRef("Unit"))
      }
    };
    case EffectCST(name, _, decls, _) => {

      let ops = elab_ops(env, decls);
      let s = get_elab_state();
      match s {
        case MkElabState(e, next_var, subst, exts, effects, active, pending) => {
          put_elab_state(ElabState.MkElabState(e, next_var, subst, exts, list_insert_first(effects, EffectDecl.MkEffectDecl(name, ops)), active, pending));
          Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"))
        }
      }
    };
    case DoCST(op, args, _) => {
      let op_name = match op {
        case Symbol(n, _) => n;
        case _ => ""
      };

      let s = get_elab_state();
      match s {
        case MkElabState(e, next_var, subst, exts, effects, active, pending) => {

          match find_op(op_name, effects) {
            case MkPair(eff, ret_ty) => {
              if string_eq(eff, "") then Pair.MkPair(AST.AstError(string_concat("Unknown effect operation: ", op_name)), AST.AstRef("Any")) else {
                put_elab_state(ElabState.MkElabState(e, next_var, subst, exts, effects, active, list_insert_first(pending, eff)));
                Pair.MkPair(AST.AstDo(AST.AstRef(op_name), elab_args(env, args)), ret_ty)
              }
}
          }
        }
      }
    };
    case HandleCST(body, eff, handlers, _) => {
      let s0 = get_elab_state();
      match s0 {
        case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
          put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, list_insert_first(act0, eff), list_empty[String]()));
          let body_elab = elaborate(env, body, OptionAST.NoneAST);
          let s1 = get_elab_state();
          match s1 {
            case MkElabState(e1, nv1, sub1, ex1, ef1, _, pend1) => {


              put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act0, merge_pending(pend0, filter_pending(eff, pend1))));


              match body_elab {
                case MkPair(body_ast, body_ty) => Pair.MkPair(AST.AstHandle(body_ast, eff, elab_hs(env, handlers)), body_ty)
              }
}
          }
        }
      }
    };
    case _ => Pair.MkPair(AST.AstError("Unsupported CST in self-hosted elaborator"), AST.AstRef("Any"))
  }
};
def check_pending(ps: List(String), res: Pair): Pair = {
  if int_eq(list_length(ps), 0) then res else {
    let e = list_get(ps, 0);
    if is_row_var(e) then check_pending(advance(ps), res) else {
      Pair.MkPair(AST.AstError(string_concat("Unhandled effect: ", e)), AST.AstRef("Any"))
    }
}
};
def elaborate_top(env: List(Pair), expr: CST, expected: OptionAST): Pair = {
  let res = elaborate(env, expr, expected);
  let s = get_elab_state();
  match s {
    case MkElabState(_, _, _, _, _, _, pending) => check_pending(pending, res)
  }
};
