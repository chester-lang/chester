def span_context(sp: CST.Span): List(Integer) = {
  match sp {
    case Span(_, _, ctx) => ctx
  }
};
def elab_extract_field(f: CST): Pair = {
  match f {
    case Symbol(n, _) => Pair.MkPair(n, CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]())));
    case SeqOf(elems, _) => {
      if int_lt(list_length(elems), 3) then Pair.MkPair("unknown", CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]()))) else {
        match list_get(elems, 0) {
          case Symbol(n, _) => {
            match list_get(elems, 1) {
              case Symbol(kw, _) => {
                if string_eq(kw, ":") then Pair.MkPair(n, list_get(elems, 2))
                else Pair.MkPair("unknown", CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]())))
              };
              case _ => Pair.MkPair("unknown", CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]())))
            }
          };
          case _ => Pair.MkPair("unknown", CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]())))
        }
      }
    };
    case _ => Pair.MkPair("unknown", CST.Symbol("Unknown", Span(0, 0, list_empty[Integer]())))
  }
};
def elab_record_fields(env: List(Pair), fs: List(CST)): List(Pair) = {
  if int_eq(list_length(fs), 0) then list_empty[Pair]() else {
    let f = list_get(fs, 0);
    let rest = elab_record_fields(env, advance(fs));
    match elab_extract_field(f) {
      case MkPair(fname, fty) => {
        let ty_res = elaborate(env, fty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
        match ty_res {
          case MkPair(tAst, _) => list_insert_first(rest, Pair.MkPair(fname, tAst))
        }
      }
    }
  }
};
def elab_fields(fs: List(CST)): List(AST) = {
                      if int_eq(list_length(fs), 0) then list_empty[AST]() else {
                        let f0 = list_get(fs, 0);
                        let rest = elab_fields(advance(fs));
                        let f0_res = elaborate(list_empty[Pair](), f0, OptionAST.NoneAST);
                        match f0_res {
                          case MkPair(f_ast, _) => list_insert_first(rest, f_ast)
                        }
}
};
def elab_ops(env: List(Pair), ds: List(CST)): List(EffectOp) = {
        if int_eq(list_length(ds), 0) then list_empty[EffectOp]() else {
          let d = list_get(ds, 0);
          let rest = elab_ops(env, advance(ds));
          match d {
            case DefCST(op, _, _, ret_ty, _, _) => {
              let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
              match ret_res {
                case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
              }
};
            case SeqOf(elems, _) => {
              if int_lt(list_length(elems), 2) then rest else {
                match list_get(elems, 0) {
                  case Symbol(kw, _) => {
                    if string_eq(kw, "def") then {
                      match list_get(elems, 1) {
                        case Symbol(op, _) => {
                          let ret_ty = if int_lt(list_length(elems), 4) then CST.Symbol("Any", Span(0, 0, list_empty[Integer]())) else list_get(elems, int_sub(list_length(elems), 1));
                          let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
                          match ret_res {
                            case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
                          }
};
                        case AppCST(f, _, _) => {
                          match f {
                            case Symbol(op, _) => {
                              let ret_ty = if int_lt(list_length(elems), 3) then CST.Symbol("Any", Span(0, 0, list_empty[Integer]())) else list_get(elems, int_sub(list_length(elems), 1));
                              let ret_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("Type")));
                              match ret_res {
                                case MkPair(r_ast, _) => list_insert_first(rest, EffectOp.MkEffectOp(op, list_empty[AST](), r_ast))
                              }
};
                            case _ => rest
                          }
                        };
                        case _ => rest
                      }
                    } else rest
                  };
                  case _ => rest
                }
              }
};
            case _ => rest
          }
        }
};
def elab_args(env: List(Pair), fs: List(CST)): List(AST) = {
        if int_eq(list_length(fs), 0) then list_empty[AST]() else {
          let f0_res = elaborate(env, list_get(fs, 0), OptionAST.NoneAST);
          match f0_res {
            case MkPair(f_ast, _) => list_insert_first(elab_args(env, advance(fs)), f_ast)
          }
}
};
def find_op(op_name: String, reg: List(EffectDecl)): Pair = {
            if int_eq(list_length(reg), 0) then Pair.MkPair("", AST.AstRef("Unknown")) else {
              match list_get(reg, 0) {
                case MkEffectDecl(eff, ops) => {

                  find_in_ops(op_name, eff, reg, ops)
                }
              }
            }
};
def find_in_ops(op_name: String, eff: String, reg: List(EffectDecl), os: List(EffectOp)): Pair = {
                    if int_eq(list_length(os), 0) then find_op(op_name, advance(reg)) else {
                      match list_get(os, 0) {
                        case MkEffectOp(n, _, ret_ty) => {
                          if string_eq(n, op_name) then Pair.MkPair(eff, ret_ty) else find_in_ops(op_name, eff, reg, advance(os))
                        }
                      }
                    }
};
def filter_pending(eff: String, ps: List(String)): List(String) = {
                if int_eq(list_length(ps), 0) then list_empty[String]() else {
                  let p = list_get(ps, 0);
                  let rest = filter_pending(eff, advance(ps));
                  if string_eq(p, eff) then rest else list_insert_first(rest, p)
                }
};
def merge_pending(a: List(String), b: List(String)): List(String) = {
  if int_eq(list_length(a), 0) then b else merge_pending(advance(a), list_insert_first(b, list_get(a, 0)))
};
def parse_hcase_op(h: CST): String = {
  match h {
    case SeqOf(elems, _) => {
      if int_lt(list_length(elems), 2) then "" else {
        match list_get(elems, 1) {
          case AppCST(f, _, _) => {
            match f { case Symbol(op, _) => op; case _ => "" }
          };
          case Symbol(op, _) => op;
          case _ => ""
        }
      }
    };
    case _ => ""
  }
};
def parse_hcase(env: List(Pair), h: CST, answer_ty: AST): Pair = {
  match h {
    case SeqOf(elems, _) => {
      if int_lt(list_length(elems), 4) then Pair.MkPair("", AST.AstRef("Unit")) else {
        match list_get(elems, 1) {
          case AppCST(f, args, _) => {
            match f {
              case Symbol(op, _) => {
                let body_c = list_get(elems, int_sub(list_length(elems), 1));
                if string_eq(op, "return") then {
                  let x = if int_eq(list_length(args), 0) then "x" else {
                    match list_get(args, 0) { case Symbol(n, _) => n; case _ => "x" }
                  };
                  let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, list_empty[Integer]()), answer_ty));
                  let h_elab = elaborate(henv, body_c, OptionAST.NoneAST);
                  match h_elab {
                    case MkPair(h_ast, h_ty) => Pair.MkPair("return", AST.AstLam(x, answer_ty, h_ast))
                  }
                } else {
                  let resume_ty = AST.AstPi("v", AST.AstRef("Any"), answer_ty, list_empty[String]());
                  let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair("resume", list_empty[Integer]()), resume_ty));
                  let henv2 = add_binders(env, args, henv);
                  let h_elab = elaborate(henv2, body_c, OptionAST.SomeAST(answer_ty));
                  match h_elab {
                    case MkPair(h_ast, _) => Pair.MkPair(op, wrap(env, args, h_ast))
                  }
                }
              };
              case _ => Pair.MkPair("", AST.AstRef("Unit"))
            }
          };
          case Symbol(op, _) => {
            let body_c = list_get(elems, int_sub(list_length(elems), 1));
            let resume_ty = AST.AstPi("v", AST.AstRef("Any"), answer_ty, list_empty[String]());
            let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair("resume", list_empty[Integer]()), resume_ty));
            let h_elab = elaborate(henv, body_c, OptionAST.SomeAST(answer_ty));
            match h_elab {
              case MkPair(h_ast, _) => Pair.MkPair(op, AST.AstLam("resume", AST.AstRef("Any"), h_ast))
            }
          };
          case _ => Pair.MkPair("", AST.AstRef("Unit"))
        }
      }
    };
    case _ => Pair.MkPair("", AST.AstRef("Unit"))
  }
};
def add_binders(env: List(Pair), as_: List(CST), e0: List(Pair)): List(Pair) = {
  if int_eq(list_length(as_), 0) then e0 else {
    match list_get(as_, 0) {
      case Symbol(bn, _) => add_binders(env, advance(as_), list_insert_first(e0, Pair.MkPair(Pair.MkPair(bn, list_empty[Integer]()), AST.AstRef("Any"))));
      case _ => add_binders(env, advance(as_), e0)
    }
  }
};
def wrap(env: List(Pair), bs: List(CST), body_ast: AST): AST = {
  if int_eq(list_length(bs), 0) then AST.AstLam("resume", AST.AstRef("Any"), body_ast) else {
    match list_get(bs, 0) {
      case Symbol(bn, _) => AST.AstLam(bn, AST.AstRef("Any"), wrap(env, advance(bs), body_ast));
      case _ => wrap(env, advance(bs), body_ast)
    }
  }
};
def elab_hs(env: List(Pair), hs: List(CST), answer_ty: AST): List(Pair) = {
  if int_eq(list_length(hs), 0) then list_empty[Pair]() else {
    match parse_hcase(env, list_get(hs, 0), answer_ty) {
      case MkPair(op, fn) => {
        let rest = elab_hs(env, advance(hs), answer_ty);
        if string_eq(op, "") then rest else list_insert_first(rest, Pair.MkPair(op, fn))
      }
    }
  }
};
def find_return_clause(hs: List(CST)): CST = {
  if int_eq(list_length(hs), 0) then CST.Error("none", Span(0, 0, list_empty[Integer]())) else {
    if string_eq(parse_hcase_op(list_get(hs, 0)), "return") then list_get(hs, 0)
    else find_return_clause(advance(hs))
  }
};
def drop_return_clauses(hs: List(CST)): List(CST) = {
  if int_eq(list_length(hs), 0) then list_empty[CST]() else {
    let h = list_get(hs, 0);
    let rest = drop_return_clauses(advance(hs));
    if string_eq(parse_hcase_op(h), "return") then rest else list_insert_first(rest, h)
  }
};
def lookup_effect_ops(name: String, reg: List(EffectDecl)): List(EffectOp) = {
  if int_eq(list_length(reg), 0) then list_empty[EffectOp]() else {
    match list_get(reg, 0) {
      case MkEffectDecl(n, ops) => {
        if string_eq(n, name) then ops else lookup_effect_ops(name, advance(reg))
      }
    }
  }
};
def hs_has_op(op: String, hs: List(Pair)): Bool = {
  if int_eq(list_length(hs), 0) then false else {
    match list_get(hs, 0) {
      case MkPair(n, _) => {
        if string_eq(n, op) then true else hs_has_op(op, advance(hs))
      }
    }
  }
};
def check_handler_complete(_eff: String, _ops: List(EffectOp), _hs: List(Pair)): String = {
  // Incomplete handlers allowed (Effekt forwarding): missing ops re-perform outward.
  "ok"
};
def free_in_asts(name: String, ls: List(AST)): Bool = {
  if int_eq(list_length(ls), 0) then false else {
    if free_in(name, list_get(ls, 0)) then true else free_in_asts(name, advance(ls))
  }
};
def free_in_snd(name: String, ls: List(Pair)): Bool = {
  if int_eq(list_length(ls), 0) then false else {
    match list_get(ls, 0) {
      case MkPair(_, v) => {
        if free_in(name, v) then true else free_in_snd(name, advance(ls))
      };
      case _ => free_in_snd(name, advance(ls))
    }
  }
};
def pat_binds(name: String, pat: PatternAST): Bool = {
  match pat {
    case PatVar(n) => string_eq(n, name);
    case PatConstructor(_, vs) => string_in_list(name, vs);
    case _ => false
  }
};
def free_in_cases(name: String, cases: List(Pair)): Bool = {
  if int_eq(list_length(cases), 0) then false else {
    match list_get(cases, 0) {
      case MkPair(pat, body) => {
        if pat_binds(name, pat) then free_in_cases(name, advance(cases)) else {
          if free_in(name, body) then true else free_in_cases(name, advance(cases))
        }
      };
      case _ => free_in_cases(name, advance(cases))
    }
  }
};
def free_in(name: String, t: AST): Bool = {
  match t {
    case AstRef(n) => string_eq(n, name);
    case AstMeta(_) => false;
    case AstUniverse(_) => false;
    case AstTuple(elems) => free_in_asts(name, elems);
    case AstStringLit(_) => false;
    case AstIntLit(_) => false;
    case AstBoolLit(_) => false;
    case AstBlock(stmts, tail) => bool_or(free_in_asts(name, stmts), free_in(name, tail));
    case AstApp(f, args) => bool_or(free_in(name, f), free_in_asts(name, args));
    case AstImplicitApp(f, args) => bool_or(free_in(name, f), free_in_asts(name, args));
    case AstLam(argName, argTy, argBody) => {
      if free_in(name, argTy) then true else {
        if string_eq(argName, name) then false else free_in(name, argBody)
      }
    };
    case AstPi(argName, argTy, retTy, _) => {
      if free_in(name, argTy) then true else {
        if string_eq(argName, name) then false else free_in(name, retTy)
      }
    };
    case AstLet(_, val) => free_in(name, val);
    case AstVar(_, val) => free_in(name, val);
    case AstAssign(_, val) => free_in(name, val);
    case AstIf(c, th, el) => bool_or(free_in(name, c), bool_or(free_in(name, th), free_in(name, el)));
    case AstDef(_, _, params, ret, body, _) => {
      if free_in_snd(name, params) then true else {
        if free_in(name, ret) then true else free_in(name, body)
      }
    };
    case AstFunTy(_, params, ret, _) => {
      if free_in_snd(name, params) then true else free_in(name, ret)
    };
    case AstEnum(_, _, _) => false;
    case AstMatch(scrut, cases) => bool_or(free_in(name, scrut), free_in_cases(name, cases));
    case AstRecord(_, _, _) => false;
    case AstFieldAccess(e, _) => free_in(name, e);
    case AstExtension(_, _, tgt, meths) => bool_or(free_in(name, tgt), free_in_asts(name, meths));
    case AstSpan(_, inner) => free_in(name, inner);
    case AstError(_) => false;
    case AstDo(op, args) => bool_or(free_in(name, op), free_in_asts(name, args));
    case AstHandle(body, _, hs) => bool_or(free_in(name, body), free_in_snd(name, hs));
    case AstBox(inner, _) => free_in(name, inner);
    case AstUnbox(inner) => free_in(name, inner);
    case AstImport(_, _, _, _) => false;
    case AstModule(_, params, seal, body) => {
      if free_in_snd(name, params) then true else {
        if free_in_asts(name, seal) then true else free_in_asts(name, body)
      }
    };
    case AstSignature(_, decls) => free_in_asts(name, decls);
    case AstFunctorApp(f, args) => bool_or(free_in(name, f), free_in_asts(name, args));
    case AstModTy(exports) => free_in_snd(name, exports);
    case AstSigVal(_, _, params, ret, _) => {
      if free_in_snd(name, params) then true else free_in(name, ret)
    };
    case AstTypeDecl(_, def) => free_in_asts(name, def);
    case AstSigWith(base, eqs) => bool_or(free_in(name, base), free_in_snd(name, eqs));
    case AstPack(m, s) => bool_or(free_in(name, m), free_in(name, s));
    case AstUnpack(n, s, e, b) => {
      if free_in(name, s) then true else {
        if free_in(name, e) then true else {
          if string_eq(n, name) then false else free_in(name, b)
        }
      }
    };
    case AstFileImport(_, _) => false
  }
};
def is_decr_arg(params: List(String), smaller: List(String), arg: AST): Bool = {
  match arg {
    case AstSpan(_, inner) => is_decr_arg(params, smaller, inner);
    case AstRef(n) => string_in_list(n, smaller);
    case AstApp(fn, args) => {
      match fn {
        case AstSpan(_, inner) => is_decr_arg(params, smaller, AST.AstApp(inner, args));
        case AstRef(op) => {
          if bool_or(string_eq(op, "int_sub"), string_eq(op, "prim__int_sub")) then {
            if int_eq(list_length(args), 2) then {
              let p0 = list_get(args, 0);
              let p1 = list_get(args, 1);
              match p0 {
                case AstSpan(_, inner) => is_decr_arg(params, smaller, AST.AstApp(AST.AstRef(op), list_insert_first(advance(args), inner)));
                case AstRef(p) => {
                  match p1 {
                    case AstSpan(_, inner) => is_decr_arg(params, smaller, AST.AstApp(AST.AstRef(op), list_insert_first(list_insert_first(list_empty[AST](), inner), AST.AstRef(p))));
                    case AstIntLit(k) => {
                      if int_lt(0, k) then bool_or(string_in_list(p, params), string_in_list(p, smaller)) else false
                    };
                    case _ => false
                  }
                };
                case _ => false
              }
            } else false
          } else if bool_or(string_eq(op, "advance"), string_eq(op, "prim__list_tail")) then {
            if int_eq(list_length(args), 1) then {
              match list_get(args, 0) {
                case AstSpan(_, inner) => is_decr_arg(params, smaller, AST.AstApp(AST.AstRef(op), list_insert_first(list_empty[AST](), inner)));
                case AstRef(p) => bool_or(string_in_list(p, params), string_in_list(p, smaller));
                case _ => false
              }
            } else false
          } else false
        };
        case _ => false
      }
    };
    case _ => false
  }
};
def any_decr(params: List(String), smaller: List(String), args: List(AST)): Bool = {
  if int_eq(list_length(args), 0) then false else {
    if is_decr_arg(params, smaller, list_get(args, 0)) then true else any_decr(params, smaller, advance(args))
  }
};
def calls_ok_list(fn: String, params: List(String), smaller: List(String), ls: List(AST)): Bool = {
  if int_eq(list_length(ls), 0) then true else {
    if calls_ok(fn, params, smaller, list_get(ls, 0)) then calls_ok_list(fn, params, smaller, advance(ls)) else false
  }
};
def calls_ok_block(fn: String, params: List(String), smaller: List(String), stmts: List(AST), tail: AST): Bool = {
  if int_eq(list_length(stmts), 0) then calls_ok(fn, params, smaller, tail) else {
    let s = list_get(stmts, 0);
    let rest = advance(stmts);
    let smaller2 = match s {
      case AstLet(n, v) => {
        if is_decr_arg(params, smaller, v) then list_insert_first(smaller, n) else smaller
      };
      case _ => smaller
    };
    if calls_ok(fn, params, smaller, s) then calls_ok_block(fn, params, smaller2, rest, tail) else false
  }
};
def calls_ok(fn: String, params: List(String), smaller: List(String), t: AST): Bool = {
  match t {
    case AstSpan(_, inner) => calls_ok(fn, params, smaller, inner);
    case AstRef(n) => bool_not(string_eq(n, fn));
    case AstTuple(es) => calls_ok_list(fn, params, smaller, es);
    case AstBlock(stmts, tail) => calls_ok_block(fn, params, smaller, stmts, tail);
    case AstApp(f, args) => {
      let f2 = unwrap_span(f);
      match f2 {
        case AstRef(n) => {
          if string_eq(n, fn) then {
            if calls_ok_list(fn, params, smaller, args) then any_decr(params, smaller, args) else false
          } else {
            if calls_ok(fn, params, smaller, f2) then calls_ok_list(fn, params, smaller, args) else false
          }
        };
        case _ => {
          if calls_ok(fn, params, smaller, f2) then calls_ok_list(fn, params, smaller, args) else false
        }
      }
    };
    case AstIf(c, th, el) => {
      if calls_ok(fn, params, smaller, c) then {
        if calls_ok(fn, params, smaller, th) then calls_ok(fn, params, smaller, el) else false
      } else false
    };
    case AstLet(_, v) => calls_ok(fn, params, smaller, v);
    case AstLam(n, ty, body) => {
      if calls_ok(fn, params, smaller, ty) then {
        if string_eq(n, fn) then true else calls_ok(fn, params, smaller, body)
      } else false
    };
    case AstMatch(scrut, cases) => {
      if calls_ok(fn, params, smaller, scrut) then calls_ok_cases(fn, params, smaller, scrut, cases) else false
    };
    case _ => bool_not(free_in(fn, t))
  }
};
def unwrap_span(t: AST): AST = {
  match t {
    case AstSpan(_, inner) => unwrap_span(inner);
    case _ => t
  }
};
def calls_ok_cases(fn: String, params: List(String), smaller: List(String), scrut: AST, cases: List(Pair)): Bool = {
  if int_eq(list_length(cases), 0) then true else {
    let c = list_get(cases, 0);
    let scrut_dec = match unwrap_span(scrut) {
      case AstRef(n) => bool_or(string_in_list(n, params), string_in_list(n, smaller));
      case _ => false
    };
    match c {
      case MkPair(pat, body) => {
        let smaller2 = match pat {
          case PatConstructor(_, vs) => {
            if scrut_dec then append_strings(vs, smaller) else smaller
          };
          case _ => smaller
        };
        if calls_ok(fn, params, smaller2, body) then calls_ok_cases(fn, params, smaller, scrut, advance(cases)) else false
      };
      case _ => calls_ok_cases(fn, params, smaller, scrut, advance(cases))
    }
  }
};
def append_strings(a: List(String), b: List(String)): List(String) = {
  if int_eq(list_length(a), 0) then b else list_insert_first(append_strings(advance(a), b), list_get(a, 0))
};
def param_names(ps: List(Pair)): List(String) = {
  if int_eq(list_length(ps), 0) then list_empty[String]() else {
    match list_get(ps, 0) {
      case MkPair(n, _) => list_insert_first(param_names(advance(ps)), n);
      case _ => param_names(advance(ps))
    }
  }
};
def check_terminates(fn: String, params: List(String), body: AST): Bool = {
  if free_in(fn, body) then calls_ok(fn, params, list_empty[String](), body) else true
};
def rename_free(old: String, new_name: String, t: AST): AST = {
  match t {
    case AstRef(n) => {
      if string_eq(n, old) then AST.AstRef(new_name) else t
    };
    case AstTuple(elems) => AST.AstTuple(list_map(elems, \e => rename_free(old, new_name, e)));
    case AstBlock(stmts, tail) =>
      AST.AstBlock(list_map(stmts, \s => rename_free(old, new_name, s)), rename_free(old, new_name, tail));
    case AstApp(f, args) =>
      AST.AstApp(rename_free(old, new_name, f), list_map(args, \a => rename_free(old, new_name, a)));
    case AstFieldAccess(e2, f) => AST.AstFieldAccess(rename_free(old, new_name, e2), f);
    case AstLam(argName, argTy, argBody) => {
      let ty2 = rename_free(old, new_name, argTy);
      if string_eq(argName, old) then AST.AstLam(argName, ty2, argBody)
      else AST.AstLam(argName, ty2, rename_free(old, new_name, argBody))
    };
    case AstPi(argName, argTy, retTy, effs) => {
      let ty2 = rename_free(old, new_name, argTy);
      if string_eq(argName, old) then AST.AstPi(argName, ty2, retTy, effs)
      else AST.AstPi(argName, ty2, rename_free(old, new_name, retTy), effs)
    };
    case AstLet(n, val) => AST.AstLet(n, rename_free(old, new_name, val));
    case AstIf(c, th, el) =>
      AST.AstIf(rename_free(old, new_name, c), rename_free(old, new_name, th), rename_free(old, new_name, el));
    case AstSpan(sp, inner) => AST.AstSpan(sp, rename_free(old, new_name, inner));
    case _ => t
  }
};
def fresh_name(base: String, avoid1: String, avoid2: String): String = {
  let cand = string_concat(base, "'");
  if bool_or(string_eq(cand, avoid1), string_eq(cand, avoid2)) then string_concat(cand, "'") else cand
};
def subst_ast(x: String, v: AST, body: AST): AST = {
  match body {
    case AstRef(name) => {
      if string_eq(name, x) then v else body
    };
    case AstUniverse(l) => AST.AstUniverse(l);
    case AstTuple(elems) => AST.AstTuple(list_map(elems, \e => subst_ast(x, v, e)));
    case AstStringLit(s) => AST.AstStringLit(s);
    case AstIntLit(n) => AST.AstIntLit(n);
    case AstBoolLit(b) => AST.AstBoolLit(b);
    case AstBlock(stmts, tail) => AST.AstBlock(list_map(stmts, \s => subst_ast(x, v, s)), subst_ast(x, v, tail));
    case AstApp(f, args) => AST.AstApp(subst_ast(x, v, f), list_map(args, \a => subst_ast(x, v, a)));
    case AstLam(argName, argTy, argBody) => {
      let newTy = subst_ast(x, v, argTy);
      if string_eq(argName, x) then AST.AstLam(argName, newTy, argBody)
      else if free_in(argName, v) then {
        let z = fresh_name(argName, x, argName);
        let body2 = rename_free(argName, z, argBody);
        AST.AstLam(z, newTy, subst_ast(x, v, body2))
      } else AST.AstLam(argName, newTy, subst_ast(x, v, argBody))
    };
    case AstPi(argName, argTy, retTy, effs) => {
      let newTy = subst_ast(x, v, argTy);
      if string_eq(argName, x) then AST.AstPi(argName, newTy, retTy, effs)
      else if free_in(argName, v) then {
        let z = fresh_name(argName, x, argName);
        let ret2 = rename_free(argName, z, retTy);
        AST.AstPi(z, newTy, subst_ast(x, v, ret2), effs)
      } else AST.AstPi(argName, newTy, subst_ast(x, v, retTy), effs)
    };
    case AstLet(n, val) => AST.AstLet(n, subst_ast(x, v, val));
    case _ => body
  }
};
def whnf(expr: AST): AST = {
  match expr {
    case AstApp(f, args) => {
      let f_whnf = whnf(f);
      match f_whnf {
        case AstLam(argName, _, body) => {
          if int_eq(list_length(args), 0) then f_whnf else {
            let arg = list_get(args, 0);
            let body_subst = subst_ast(argName, arg, body);
            whnf(body_subst)
          }
};
        case _ => AST.AstApp(f_whnf, args)
      }
    };
    case _ => expr
  }
};
enum ExtMethod {
  case MkExtMethod(name: String, full: String)
};
enum ExtDecl {
  case MkExtDecl(name: String, target_ty: AST, meths: List(ExtMethod))
};
enum EffectOp {
  case MkEffectOp(name: String, arg_tys: List(AST), ret_ty: AST)
};
enum EffectDecl {
  case MkEffectDecl(name: String, ops: List(EffectOp))
};
enum ElabState {
  case MkElabState(env: List(Pair), next_var: Integer, subst: List(Pair), exts: List(ExtDecl), effects: List(EffectDecl), active: List(String), pending: List(String))
};
def get_elab_state(): ElabState = prim__get_elab_state();
def put_elab_state(s: ElabState): Unit = prim__put_elab_state(s);
def lookup_meta(id: Integer, subst: List(Pair)): OptionAST = {
  if int_eq(list_length(subst), 0) then OptionAST.NoneAST else {
    let entry = list_get(subst, 0);
    match entry {
      case MkPair(k, v) => {
        if int_eq(k, id) then OptionAST.SomeAST(v) else lookup_meta(id, advance(subst))
      }
    }
  }
};
def equiv_ast(t1: AST, t2: AST): Bool = {
  // basic equivalence for now (unification takes care of the deep stuff)
  match t1 {
    case AstUniverse(l1) => {
      match t2 {
        case AstUniverse(l2) => int_eq(l1, l2);
        case _ => false
      }
    };
    case AstRef(n1) => {
      match t2 {
        case AstRef(n2) => string_eq(n1, n2);
        case _ => false
      }
    };
    case AstMeta(m1) => {
      match t2 {
        case AstMeta(m2) => int_eq(m1, m2);
        case _ => false
      }
    };
    case _ => false
  }
};
enum OptionAST {
  case SomeAST(ast: AST);
  case NoneAST
};
def fresh_meta(): AST = {
  let s = get_elab_state();
  match s {
    case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
      let m = AST.AstMeta(next_var);
      put_elab_state(ElabState.MkElabState(env, int_add(next_var, 1), subst, exts, effects, active, pending));
      m
    }
  }
};
def ast_list_size(ls: List(AST)): Integer = {
  if int_eq(list_length(ls), 0) then 0 else int_add(ast_size(list_get(ls, 0)), ast_list_size(advance(ls)))
};
def ast_paired_size(ls: List(Pair)): Integer = {
  if int_eq(list_length(ls), 0) then 0 else {
    match list_get(ls, 0) {
      case MkPair(_, a) => int_add(ast_size(a), ast_paired_size(advance(ls)));
      case _ => ast_paired_size(advance(ls))
    }
  }
};
def ast_size(t: AST): Integer = match t {
  case AstRef(_) => 1;
  case AstMeta(_) => 1;
  case AstUniverse(_) => 1;
  case AstStringLit(_) => 1;
  case AstIntLit(_) => 1;
  case AstBoolLit(_) => 1;
  case AstError(_) => 1;
  case AstImport(_, _, _, _) => 1;
  case AstEnum(_, _, _) => 1;
  case AstRecord(_, _, _) => 1;
  case AstFileImport(_, _) => 1;
  case AstTuple(es) => int_add(1, ast_list_size(es));
  case AstBlock(stmts, tail) => int_add(1, int_add(ast_list_size(stmts), ast_size(tail)));
  case AstApp(f, args) => int_add(1, int_add(ast_size(f), ast_list_size(args)));
  case AstImplicitApp(f, args) => int_add(1, int_add(ast_size(f), ast_list_size(args)));
  case AstLam(_, ty, body) => int_add(1, int_add(ast_size(ty), ast_size(body)));
  case AstPi(_, ty, ret, _) => int_add(1, int_add(ast_size(ty), ast_size(ret)));
  case AstLet(_, val) => int_add(1, ast_size(val));
  case AstVar(_, val) => int_add(1, ast_size(val));
  case AstAssign(_, val) => int_add(1, ast_size(val));
  case AstIf(c, th, el) => int_add(1, int_add(ast_size(c), int_add(ast_size(th), ast_size(el))));
  case AstDef(_, _, ps, ret, body, _) => int_add(1, int_add(ast_paired_size(ps), int_add(ast_size(ret), ast_size(body))));
  case AstFunTy(_, ps, ret, _) => int_add(1, int_add(ast_paired_size(ps), ast_size(ret)));
  case AstMatch(e, cases) => int_add(1, int_add(ast_size(e), ast_paired_size(cases)));
  case AstFieldAccess(e, _) => int_add(1, ast_size(e));
  case AstExtension(_, _, tgt, meths) => int_add(1, int_add(ast_size(tgt), ast_list_size(meths)));
  case AstSpan(_, inner) => int_add(1, ast_size(inner));
  case AstDo(op, args) => int_add(1, int_add(ast_size(op), ast_list_size(args)));
  case AstHandle(body, _, hs) => int_add(1, int_add(ast_size(body), ast_paired_size(hs)));
  case AstBox(e, _) => int_add(1, ast_size(e));
  case AstUnbox(e) => int_add(1, ast_size(e));
  case AstModule(_, ps, seal, body) => int_add(1, int_add(ast_paired_size(ps), int_add(ast_list_size(seal), ast_list_size(body))));
  case AstSignature(_, decls) => int_add(1, ast_list_size(decls));
  case AstFunctorApp(f, args) => int_add(1, int_add(ast_size(f), ast_list_size(args)));
  case AstModTy(ex) => int_add(1, ast_paired_size(ex));
  case AstSigVal(_, _, ps, ret, _) => int_add(1, int_add(ast_paired_size(ps), ast_size(ret)));
  case AstTypeDecl(_, defs) => int_add(1, ast_list_size(defs));
  case AstSigWith(s, eqs) => int_add(1, int_add(ast_size(s), ast_paired_size(eqs)));
  case AstPack(m, s) => int_add(1, int_add(ast_size(m), ast_size(s)));
  case AstUnpack(_, s, e, b) => int_add(1, int_add(ast_size(s), int_add(ast_size(e), ast_size(b))))
};
def ast_fuel(t: AST): Integer = int_mul(int_add(ast_size(t), 1), 16);
// First elaboration error embedded in an AST ("" when clean). Used by the CLI
// so failed compiles exit nonzero instead of emitting panic expressions.
def first_error_asts(ls: List(AST)): String = {
  if int_eq(list_length(ls), 0) then "" else {
    let head = first_error(list_get(ls, 0));
    if string_eq(head, "") then first_error_asts(advance(ls)) else head
  }
};
def first_error_pairs(ps: List(Pair)): String = {
  if int_eq(list_length(ps), 0) then "" else {
    match list_get(ps, 0) {
      case MkPair(_, v) => {
        let head = first_error(v);
        if string_eq(head, "") then first_error_pairs(advance(ps)) else head
      }
    }
  }
};
def first_error(ast: AST): String = {
  match ast {
    case AstError(msg) => msg;
    case AstSpan(_, inner) => first_error(inner);
    case AstTuple(es) => first_error_asts(es);
    case AstBlock(stmts, tail) => {
      let e = first_error_asts(stmts);
      if string_eq(e, "") then first_error(tail) else e
    };
    case AstApp(f, args) => {
      let e = first_error(f);
      if string_eq(e, "") then first_error_asts(args) else e
    };
    case AstImplicitApp(f, args) => {
      let e = first_error(f);
      if string_eq(e, "") then first_error_asts(args) else e
    };
    case AstLam(_, ty, body) => {
      let e = first_error(ty);
      if string_eq(e, "") then first_error(body) else e
    };
    case AstPi(_, ty, ret, _) => {
      let e = first_error(ty);
      if string_eq(e, "") then first_error(ret) else e
    };
    case AstLet(_, v) => first_error(v);
    case AstVar(_, v) => first_error(v);
    case AstAssign(_, v) => first_error(v);
    case AstIf(c, t, e2) => {
      let e = first_error(c);
      if string_eq(e, "") then {
        let e1 = first_error(t);
        if string_eq(e1, "") then first_error(e2) else e1
      } else e
    };
    case AstDef(_, _, ps, ret, body, _) => {
      let e = first_error_pairs(ps);
      if string_eq(e, "") then {
        let e1 = first_error(ret);
        if string_eq(e1, "") then first_error(body) else e1
      } else e
    };
    case AstFunTy(_, ps, ret, _) => {
      let e = first_error_pairs(ps);
      if string_eq(e, "") then first_error(ret) else e
    };
    case AstMatch(e0, cases) => {
      let e = first_error(e0);
      if string_eq(e, "") then first_error_pairs(cases) else e
    };
    case AstFieldAccess(e, _) => first_error(e);
    case AstExtension(_, _, tgt, meths) => {
      let e = first_error(tgt);
      if string_eq(e, "") then first_error_asts(meths) else e
    };
    case AstDo(op, args) => {
      let e = first_error(op);
      if string_eq(e, "") then first_error_asts(args) else e
    };
    case AstHandle(body, _, hs) => {
      let e = first_error(body);
      if string_eq(e, "") then first_error_pairs(hs) else e
    };
    case AstBox(e, _) => first_error(e);
    case AstUnbox(e) => first_error(e);
    case AstModule(_, ps, seal, body) => {
      let e = first_error_pairs(ps);
      if string_eq(e, "") then {
        let e1 = first_error_asts(seal);
        if string_eq(e1, "") then first_error_asts(body) else e1
      } else e
    };
    case AstSignature(_, decls) => first_error_asts(decls);
    case AstFunctorApp(f, args) => {
      let e = first_error(f);
      if string_eq(e, "") then first_error_asts(args) else e
    };
    case AstModTy(ex) => first_error_pairs(ex);
    case AstSigVal(_, _, ps, ret, _) => {
      let e = first_error_pairs(ps);
      if string_eq(e, "") then first_error(ret) else e
    };
    case AstTypeDecl(_, defs) => first_error_asts(defs);
    case AstSigWith(s, eqs) => {
      let e = first_error(s);
      if string_eq(e, "") then first_error_pairs(eqs) else e
    };
    case AstPack(m, s) => {
      let e = first_error(m);
      if string_eq(e, "") then first_error(s) else e
    };
    case AstUnpack(_, s, e, b) => {
      let e0 = first_error(s);
      if string_eq(e0, "") then {
        let e1 = first_error(e);
        if string_eq(e1, "") then first_error(b) else e1
      } else e0
    };
    case _ => ""
  }
};
def elab_module_params(env: List(Pair), ps: List(Pair)): Pair = {
  if int_eq(list_length(ps), 0) then Pair.MkPair(list_empty[Pair](), env) else {
    match list_get(ps, 0) {
      case MkPair(pn, pty) => {
        match elaborate(env, pty, OptionAST.NoneAST) {
          case MkPair(tyAst, ty) => {
            let pmodty = match ty {
              case AstSignature(_, decls) => AST.AstModTy(module_exports_of(decls));
              case AstModTy(ex) => AST.AstModTy(ex);
              case other => other
            };
            let env1 = list_insert_first(env, Pair.MkPair(Pair.MkPair(pn, list_empty[Integer]()), pmodty));
            match elab_module_params(env1, advance(ps)) {
              case MkPair(psAst, env2) => Pair.MkPair(list_insert_first(psAst, Pair.MkPair(pn, tyAst)), env2)
            }
          }
        }
      }
    }
  }
};
def unify_fuel(t1: AST, t2: AST): Integer = {
  let s = get_elab_state();
  let subst_len = match s {
    case MkElabState(_, _, subst, _, _, _, _) => list_length(subst)
  };
  int_add(ast_size(t1), int_add(ast_size(t2), int_add(subst_len, 2)))
};
// Type-shape helpers mirroring CoreChecker's if/application rules.
def ty_is_definitely_not_bool(t: AST): Bool = {
  match t {
    case AstRef(n) =>
      bool_or(string_eq(n, "Integer"), bool_or(string_eq(n, "Int"),
        bool_or(string_eq(n, "String"), bool_or(string_eq(n, "Unit"),
          bool_or(string_eq(n, "Type"), string_eq(n, "TypeUniverse"))))));
    case AstSpan(_, inner) => ty_is_definitely_not_bool(inner);
    case _ => false
  }
};
def ty_name_is_int(n: String): Bool = bool_or(string_eq(n, "Integer"), string_eq(n, "Int"));
def ty_name_is_bool(n: String): Bool =
  bool_or(string_eq(n, "Bool"), bool_or(string_eq(n, "Boolean"), string_eq(n, "bool")));
def ty_name_is_universe(n: String): Bool =
  bool_or(string_eq(n, "Type"), string_eq(n, "TypeUniverse"));
// "" unless [t] is a ground named type (no unsolved meta / Any / Unknown).
def ty_ground_name(t: AST): String = {
  match whnf(t) {
    case AstRef(n) => { if bool_or(string_eq(n, "Any"), string_eq(n, "Unknown")) then "" else n };
    case AstSpan(_, inner) => ty_ground_name(inner);
    case _ => ""
  }
};
// Ground named types that are definitely different (alias-aware).
def ty_ground_mismatch(t1: AST, t2: AST): Bool = {
  let n1 = ty_ground_name(t1);
  let n2 = ty_ground_name(t2);
  if bool_or(string_eq(n1, ""), string_eq(n2, "")) then false
  else if string_eq(n1, n2) then false
  else if bool_and(ty_name_is_int(n1), ty_name_is_int(n2)) then false
  else if bool_and(ty_name_is_bool(n1), ty_name_is_bool(n2)) then false
  else if bool_and(ty_name_is_universe(n1), ty_name_is_universe(n2)) then false
  else true
};
// Unify for its meta effects, then report a definite ground mismatch.
def unify_ok(t1: AST, t2: AST): Bool = {
  unify(unify_fuel(t1, t2), t1, t2);
  bool_not(ty_ground_mismatch(t1, t2))
};
def unify_top(t1: AST, t2: AST): Unit = unify(unify_fuel(t1, t2), t1, t2);
def unify_list(fuel: Integer, l1: List(AST), l2: List(AST)): Unit = {
  if int_eq(list_length(l1), 0) then () else {
    if int_eq(list_length(l2), 0) then () else {
      unify(fuel, list_get(l1, 0), list_get(l2, 0));
      unify_list(fuel, advance(l1), advance(l2))
    }
  }
};
def unify(fuel: Integer, t1: AST, t2: AST): Unit = {
  if int_eq(fuel, 0) then () else {
    let t1_whnf = whnf(t1);
    let t2_whnf = whnf(t2);
    match t1_whnf {
      case AstMeta(m1) => {
        match t2_whnf {
          case AstMeta(m2) => {
            if int_eq(m1, m2) then () else {
              let s = get_elab_state();
              match s {
                case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                  let v1_opt = lookup_meta(m1, subst);
                  match v1_opt {
                    case SomeAST(v1) => unify(int_sub(fuel, 1), v1, t2_whnf);
                    case OptionAST.NoneAST => {
                      let v2_opt = lookup_meta(m2, subst);
                      match v2_opt {
                        case SomeAST(v2) => unify(int_sub(fuel, 1), t1_whnf, v2);
                        case OptionAST.NoneAST => {
                          let new_subst = list_insert_first(subst, Pair.MkPair(m1, t2_whnf));
                          put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                        }
                      }
                    }
                  }
                }
              }
            }
};
          case _ => {
            let s = get_elab_state();
            match s {
              case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                let v1_opt = lookup_meta(m1, subst);
                match v1_opt {
                  case SomeAST(v1) => unify(int_sub(fuel, 1), v1, t2_whnf);
                  case OptionAST.NoneAST => {
                    let new_subst = list_insert_first(subst, Pair.MkPair(m1, t2_whnf));
                    put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                  }
                }
              }
            }
          }
        }
      };
      case AstApp(f1, a1) => {
        match t2_whnf {
          case AstApp(f2, a2) => {
            unify(int_sub(fuel, 1), f1, f2);
            unify_list(int_sub(fuel, 1), a1, a2)
          };
          case AstMeta(m2) => {
            let s = get_elab_state();
            match s {
              case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
                let v2_opt = lookup_meta(m2, subst);
                match v2_opt {
                  case SomeAST(v2) => unify(int_sub(fuel, 1), t1_whnf, v2);
                  case OptionAST.NoneAST => {
                    let new_subst = list_insert_first(subst, Pair.MkPair(m2, t1_whnf));
                    put_elab_state(ElabState.MkElabState(env, next_var, new_subst, exts, effects, active, pending))
                  }
                }
              }
            }
          };
          case _ => ()
        }
      };
      case AstPi(_, ty1, ret1, eff1) => {
        match t2_whnf {
          case AstPi(_, ty2, ret2, eff2) => {
            unify(int_sub(fuel, 1), ty1, ty2);
            unify(int_sub(fuel, 1), ret1, ret2);
            if effect_rows_compatible(eff1, eff2) then () else ()
          };
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      };
      case AstFunTy(_, _, ret1, eff1) => {
        match t2_whnf {
          case AstFunTy(_, _, ret2, eff2) => {
            unify(int_sub(fuel, 1), ret1, ret2);
            if effect_rows_compatible(eff1, eff2) then () else ()
          };
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      };
      case _ => {
        match t2_whnf {
          case AstMeta(_) => unify(int_sub(fuel, 1), t2_whnf, t1_whnf);
          case _ => ()
        }
      }
    }
  }
};
def list_nat_eq(l1: List(Integer), l2: List(Integer)): Bool = {
  if int_eq(list_length(l1), 0) then {
    if int_eq(list_length(l2), 0) then true else false
} else {
    if int_eq(list_length(l2), 0) then false else {
      let x = list_get(l1, 0);
      let y = list_get(l2, 0);
      if int_eq(x, y) then list_nat_eq(advance(l1), advance(l2)) else false
    }
}
};
def lookup_type(name: String, ctx: List(Integer), env: List(Pair)): OptionAST = {
  if int_eq(list_length(env), 0) then OptionAST.NoneAST else {
    let entry = list_get(env, 0);
    match entry {
      case MkPair(k, v) => {
        match k {
          case MkPair(k_name, k_ctx) => {
            if string_eq(name, k_name) then {
              if list_nat_eq(ctx, k_ctx) then OptionAST.SomeAST(v) else lookup_type(name, ctx, advance(env))
} else {
              lookup_type(name, ctx, advance(env))
            }
}
        }
      }
    }
  }
};
def is_preamble_prim(name: String): Bool = {
  if string_eq(name, "int_add") then true
  else if string_eq(name, "int_sub") then true
  else if string_eq(name, "int_mul") then true
  else if string_eq(name, "int_div") then true
  else if string_eq(name, "int_mod") then true
  else if string_eq(name, "int_neg") then true
  else if string_eq(name, "int_eq") then true
  else if string_eq(name, "int_lt") then true
  else if string_eq(name, "int_gt") then true
  else if string_eq(name, "int_le") then true
  else if string_eq(name, "int_ge") then true
  else if string_eq(name, "bool_or") then true
  else if string_eq(name, "bool_and") then true
  else if string_eq(name, "bool_not") then true
  else if string_eq(name, "string_eq") then true
  else if string_eq(name, "string_concat") then true
  else if string_eq(name, "string_length") then true
  else if string_eq(name, "string_substring") then true
  else if string_eq(name, "string_char_at") then true
  else if string_eq(name, "string_append") then true
  else if string_eq(name, "string_to_int") then true
  else if string_eq(name, "int_to_string") then true
  else if string_eq(name, "list_length") then true
  else if string_eq(name, "list_get") then true
  else if string_eq(name, "list_empty") then true
  else if string_eq(name, "list_insert_first") then true
  else if string_eq(name, "advance") then true
  else if string_eq(name, "true") then true
  else if string_eq(name, "false") then true
  else if string_eq(name, "null") then true
  else if string_eq(name, "undefined") then true
  else if string_eq(name, "fmt") then true
  else if string_eq(name, "math") then true
  else if string_eq(name, "os") then true
  else if string_eq(name, "console") then true
  else if string_eq(name, "\\") then true
  else false
};
def name_is_upper(name: String): Bool = {
  if int_eq(string_length(name), 0) then false else {
    let c = string_char_at(name, 0);
    if string_eq(c, "A") then true else if string_eq(c, "B") then true else if string_eq(c, "C") then true
    else if string_eq(c, "D") then true else if string_eq(c, "E") then true else if string_eq(c, "F") then true
    else if string_eq(c, "G") then true else if string_eq(c, "H") then true else if string_eq(c, "I") then true
    else if string_eq(c, "J") then true else if string_eq(c, "K") then true else if string_eq(c, "L") then true
    else if string_eq(c, "M") then true else if string_eq(c, "N") then true else if string_eq(c, "O") then true
    else if string_eq(c, "P") then true else if string_eq(c, "Q") then true else if string_eq(c, "R") then true
    else if string_eq(c, "S") then true else if string_eq(c, "T") then true else if string_eq(c, "U") then true
    else if string_eq(c, "V") then true else if string_eq(c, "W") then true else if string_eq(c, "X") then true
    else if string_eq(c, "Y") then true else if string_eq(c, "Z") then true else false
  }
};
def is_allowed_unbound(name: String): Bool = {
  if name_is_upper(name) then true
  else if is_preamble_prim(name) then true
  else if string_starts_with(name, "prim__") then true
  else if string_starts_with(name, "__") then true
  else false
};
def is_type_expected(expected: OptionAST): Bool = {
  match expected {
    case SomeAST(ty) => {
      match ty {
        case AstRef(n) => bool_or(string_eq(n, "Type"), string_eq(n, "TypeUniverse"));
        case _ => false
      }
    };
    case OptionAST.NoneAST => false
  }
};
def resolve_hygiene(env: List(Pair), name: String, ctx: List(Integer)): Pair = {
  let res = lookup_type(name, ctx, env);
  match res {
    case SomeAST(ty) => Pair.MkPair(ty, ctx);
    case OptionAST.NoneAST => {
      if int_eq(list_length(ctx), 0) then Pair.MkPair(AST.AstError("Not found"), ctx) else resolve_hygiene(env, name, advance(ctx))
    }
  }
};
def join_ctx(ls: List(Integer)): String = {
  if int_eq(list_length(ls), 0) then "" else string_append(string_append("_", int_to_string(list_get(ls, 0))), join_ctx(advance(ls)))
};
def mangle_name(n: String, ctx: List(Integer)): String = {
  if int_eq(list_length(ctx), 0) then n else string_append(n, join_ctx(ctx))
};
def append_env(e1: List(Pair), e2: List(Pair)): List(Pair) = {
  if int_eq(list_length(e1), 0) then e2 else list_insert_first(append_env(advance(e1), e2), list_get(e1, 0))
};
def string_in_list(s: String, xs: List(String)): Bool = {
  if int_eq(list_length(xs), 0) then false else {
    if string_eq(s, list_get(xs, 0)) then true else string_in_list(s, advance(xs))
  }
};
def is_row_var(s: String): Bool = {
  // Prefer ASCII "mu" prefix — UTF-8 "μ" breaks byte-oriented string_substring.
  if int_eq(string_length(s), 0) then false
  else if bool_and(int_ge(string_length(s), 2), string_eq(string_substring(s, 0, 2), "mu")) then true
  else string_eq(string_substring(s, 0, 1), "μ")
};
def effect_in_row(label: String, provided: List(String)): Bool = {
  // Open-row vars are skipped (not “accepts every label”); ⟨State | μ⟩ has State.
  if int_eq(list_length(provided), 0) then false else {
    if is_row_var(list_get(provided, 0)) then effect_in_row(label, advance(provided)) else {
      if string_eq(label, list_get(provided, 0)) then true else effect_in_row(label, advance(provided))
    }
}
};
def effect_row_name_syms(ns: List(CST)): List(String) = {
  if int_eq(list_length(ns), 0) then list_empty[String]() else {
    match list_get(ns, 0) {
      case Symbol(s, _) => list_insert_first(effect_row_name_syms(advance(ns)), s);
      case _ => effect_row_name_syms(advance(ns))
    }
  }
};
def peel_effect_row_cst(ret_ty: CST): Pair = {
  // Expander encoding: AppCST #effect_row [ret; ListLiteral names]
  match ret_ty {
    case AppCST(f, args, _) => {
      match f {
        case Symbol(n, _) => {
          if bool_and(string_eq(n, "#effect_row"), int_eq(list_length(args), 2)) then {
            let inner = list_get(args, 0);
            match list_get(args, 1) {
              case ListLiteral(names, _) => Pair.MkPair(inner, effect_row_name_syms(names));
              case _ => Pair.MkPair(ret_ty, list_empty[String]())
            }
          } else Pair.MkPair(ret_ty, list_empty[String]())
        };
        case _ => Pair.MkPair(ret_ty, list_empty[String]())
      }
    };
    case _ => Pair.MkPair(ret_ty, list_empty[String]())
  }
};
def charge_call_effs(fTy: AST): Unit = {
  let call_effs = match fTy {
    case AstFunTy(_, _, _, e) => effect_labels(e);
    case AstPi(_, _, _, e) => effect_labels(e);
    case _ => list_empty[String]()
  };
  let s = get_elab_state();
  match s {
    case MkElabState(e, nv, sub, ex, ef, act, pending) => {
      put_elab_state(ElabState.MkElabState(e, nv, sub, ex, ef, act, merge_effects(pending, call_effs)))
    }
  }
};
def module_exports_of(asts: List(AST)): List(Pair) = {
  if int_eq(list_length(asts), 0) then list_empty[Pair]() else {
    let rest = module_exports_of(advance(asts));
    match list_get(asts, 0) {
      case AstDef(n, tps, ps, ret, _, effs) =>
        list_insert_first(rest, Pair.MkPair(n, AST.AstFunTy(tps, ps, ret, effs)));
      case AstSigVal(n, tps, ps, ret, effs) =>
        list_insert_first(rest, Pair.MkPair(n, AST.AstFunTy(tps, ps, ret, effs)));
      case AstTypeDecl(n, defs) =>
        list_insert_first(rest, Pair.MkPair(n, AST.AstTypeDecl(n, defs)));
      case AstModule(n, _, seal, body) => {
        let ty = if int_eq(list_length(seal), 0) then AST.AstModTy(module_exports_of(body)) else {
          match list_get(seal, 0) {
            case AstModTy(ex) => AST.AstModTy(ex);
            case _ => AST.AstModTy(module_exports_of(body))
          }
        };
        list_insert_first(rest, Pair.MkPair(n, ty))
      };
      case AstSignature(n, decls) =>
        list_insert_first(rest, Pair.MkPair(n, AST.AstSignature(n, decls)));
      case AstSpan(_, inner) => {
        let one = list_empty[AST]();
        let with_inner = list_insert_first(one, inner);
        let head_ex = module_exports_of(with_inner);
        if int_eq(list_length(head_ex), 0) then rest else list_insert_first(rest, list_get(head_ex, 0))
      };
      case _ => rest
    }
  }
};
def lookup_export(exports: List(Pair), field: String): AST = {
  if int_eq(list_length(exports), 0) then AST.AstError(string_concat("module has no export: ", field)) else {
    match list_get(exports, 0) {
      case MkPair(n, ty) => {
        if string_eq(n, field) then ty else lookup_export(advance(exports), field)
      }
    }
  }
};
def keep_sealed(sealed: List(Pair), ls: List(AST)): List(AST) = {
  if int_eq(list_length(ls), 0) then list_empty[AST]() else {
    let rest = keep_sealed(sealed, advance(ls));
    match list_get(ls, 0) {
      case AstDef(n, tps, ps, rt, b, effs) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case _ => list_insert_first(rest, AST.AstDef(n, tps, ps, rt, b, effs))
        }
      };
      case AstTypeDecl(n, defs) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case AstTypeDecl(_, defs2) => list_insert_first(rest, AST.AstTypeDecl(n, defs2));
          case _ => list_insert_first(rest, AST.AstTypeDecl(n, defs))
        }
      };
      case AstModule(n, params, seal, body) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case _ => list_insert_first(rest, AST.AstModule(n, params, seal, body))
        }
      };
      case AstSignature(n, decls) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case _ => list_insert_first(rest, AST.AstSignature(n, decls))
        }
      };
      case AstEnum(n, tps, variants) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case _ => list_insert_first(rest, AST.AstEnum(n, tps, variants))
        }
      };
      case AstRecord(n, tps, fields) => {
        match lookup_export(sealed, n) {
          case AstError(_) => rest;
          case _ => list_insert_first(rest, AST.AstRecord(n, tps, fields))
        }
      };
      case AstSpan(sp, inner) => {
        let kept_inner = keep_sealed(sealed, list_insert_first(list_empty[AST](), inner));
        if int_eq(list_length(kept_inner), 0) then rest else list_insert_first(rest, AST.AstSpan(sp, list_get(kept_inner, 0)))
      };
      case _ => rest
    }
  }
};
def strip_span(t: AST): AST = {
  match t {
    case AstSpan(_, inner) => strip_span(inner);
    case _ => t
  }
};
def unpack_inline(x: String, eAst: AST, bAst: AST): OptionAST = {
  match strip_span(eAst) {
    case AstPack(m, _) => {
      match m {
        case AstRef(n) => OptionAST.SomeAST(rename_free(x, n, bAst));
        case AstModule(n, _, _, _) => OptionAST.SomeAST(rename_free(x, n, bAst));
        case _ => OptionAST.NoneAST
      }
    };
    case _ => OptionAST.NoneAST
  }
};
def wrap_unpack(x: String, sigAst: AST, eAst: AST, bAst: AST, bTy: AST): Pair = {
  match unpack_inline(x, eAst, bAst) {
    case SomeAST(inlined) => Pair.MkPair(inlined, bTy);
    case OptionAST.NoneAST => Pair.MkPair(AST.AstUnpack(x, sigAst, eAst, bAst), bTy)
  }
};
def refs_compat(n1: String, n2: String): Bool = {
  if string_eq(n1, n2) then true
  else if bool_and(bool_or(string_eq(n1, "Int"), string_eq(n1, "Integer")), bool_or(string_eq(n2, "Int"), string_eq(n2, "Integer"))) then true
  else if bool_and(bool_or(string_eq(n1, "Bool"), string_eq(n1, "Boolean")), bool_or(string_eq(n2, "Bool"), string_eq(n2, "Boolean"))) then true
  else if bool_and(bool_or(string_eq(n1, "Type"), string_eq(n1, "TypeUniverse")), bool_or(string_eq(n2, "Type"), string_eq(n2, "TypeUniverse"))) then true
  else false
};
def types_compat(t1: AST, t2: AST): Bool = {
  let a = strip_span(whnf(t1));
  let b = strip_span(whnf(t2));
  match a {
    case AstRef(n1) => {
      match b {
        case AstRef(n2) => bool_or(refs_compat(n1, n2), bool_or(string_eq(n1, "Any"), bool_or(string_eq(n2, "Any"), bool_or(string_eq(n1, "Unknown"), string_eq(n2, "Unknown")))));
        case _ => bool_or(string_eq(n1, "Any"), string_eq(n1, "Unknown"))
      }
    };
    case AstUniverse(l1) => {
      match b {
        case AstUniverse(l2) => int_eq(l1, l2);
        case AstRef(n2) => bool_or(string_eq(n2, "Any"), string_eq(n2, "Unknown"));
        case _ => false
      }
    };
    case AstFieldAccess(_, f1) => {
      match b {
        case AstFieldAccess(_, f2) => string_eq(f1, f2);
        case AstRef(n2) => string_eq(f1, n2);
        case _ => false
      }
    };
    case _ => {
      match b {
        case AstRef(n2) => bool_or(string_eq(n2, "Any"), string_eq(n2, "Unknown"));
        case _ => false
      }
    }
  }
};
def types_match_seal_params(a: List(Pair), b: List(Pair)): Bool = {
  if int_eq(list_length(a), 0) then int_eq(list_length(b), 0) else {
    if int_eq(list_length(b), 0) then false else {
      match list_get(a, 0) {
        case MkPair(_, t) => {
          match list_get(b, 0) {
            case MkPair(_, u) => {
              if types_match_seal(t, u) then types_match_seal_params(advance(a), advance(b)) else false
            }
          }
        }
      }
    }
  }
};
def types_match_seal_list(a: List(AST), b: List(AST)): Bool = {
  if int_eq(list_length(a), 0) then int_eq(list_length(b), 0) else {
    if int_eq(list_length(b), 0) then false else {
      if types_match_seal(list_get(a, 0), list_get(b, 0)) then types_match_seal_list(advance(a), advance(b)) else false
    }
  }
};
def types_match_seal(t1: AST, t2: AST): Bool = {
  match t1 {
    case AstSpan(_, i1) => types_match_seal(i1, t2);
    case _ => {
      let t2p = strip_span(t2);
      if types_compat(t1, t2p) then true else {
        match t1 {
          case AstFunTy(_, p1, r1, _) => {
            match t2p {
              case AstFunTy(_, p2, r2, _) => bool_and(types_match_seal_params(p1, p2), types_match_seal(r1, r2));
              case _ => false
            }
          };
          case AstPi(_, a1, r1, _) => {
            match t2p {
              case AstPi(_, a2, r2, _) => bool_and(types_match_seal(a1, a2), types_match_seal(r1, r2));
              case _ => false
            }
          };
          case AstApp(f1, a1) => {
            match t2p {
              case AstApp(f2, a2) => bool_and(types_match_seal(f1, f2), types_match_seal_list(a1, a2));
              case _ => false
            }
          };
          case AstTuple(xs) => {
            match t2p {
              case AstTuple(ys) => types_match_seal_list(xs, ys);
              case _ => false
            }
          };
          case AstTypeDecl(n1, d1) => {
            match t2p {
              case AstTypeDecl(n2, d2) => {
                if bool_not(string_eq(n1, n2)) then false else {
                  if int_eq(list_length(d1), 0) then int_eq(list_length(d2), 0)
                  else if int_eq(list_length(d2), 0) then false
                  else types_match_seal(list_get(d1, 0), list_get(d2, 0))
                }
              };
              case _ => false
            }
          };
          case AstRef(n1) => {
            match t2p {
              case AstRef(n2) => refs_compat(n1, n2);
              case _ => string_eq(n1, "Any")
            }
          };
          case AstUniverse(l1) => {
            match t2p {
              case AstUniverse(l2) => int_eq(l1, l2);
              case AstRef(n2) => string_eq(n2, "Any");
              case _ => false
            }
          };
          case _ => {
            match t2p {
              case AstRef(n2) => string_eq(n2, "Any");
              case _ => false
            }
          }
        }
      }
    }
  }
};
def find_pair_ty(ls: List(Pair), name: String): OptionAST = {
  if int_eq(list_length(ls), 0) then OptionAST.NoneAST else {
    match list_get(ls, 0) {
      case MkPair(n, ty) => {
        if string_eq(n, name) then OptionAST.SomeAST(ty) else find_pair_ty(advance(ls), name)
      }
    }
  }
};
def filter_subst_drop(subs: List(Pair), name: String): List(Pair) = {
  if int_eq(list_length(subs), 0) then list_empty[Pair]() else {
    match list_get(subs, 0) {
      case MkPair(n, ty) => {
        let rest = filter_subst_drop(advance(subs), name);
        if string_eq(n, name) then rest else list_insert_first(rest, Pair.MkPair(n, ty))
      }
    }
  }
};
def seal_type_substs_fuel(fuel: Integer, sig_decls: List(AST), full: List(Pair)): List(Pair) = {
  if int_eq(fuel, 0) then list_empty[Pair]() else {
    if int_eq(list_length(sig_decls), 0) then list_empty[Pair]() else {
      let fuel2 = int_sub(fuel, 1);
      match list_get(sig_decls, 0) {
        case AstTypeDecl(n, _) => {
          let rest = seal_type_substs_fuel(fuel2, advance(sig_decls), full);
          match lookup_export(full, n) {
            case AstTypeDecl(_, defs) => {
              if int_eq(list_length(defs), 0) then rest
              else list_insert_first(rest, Pair.MkPair(n, list_get(defs, 0)))
            };
            case _ => rest
          }
        };
        case AstSpan(_, inner) =>
          seal_type_substs_fuel(fuel2, list_insert_first(advance(sig_decls), inner), full);
        case _ => seal_type_substs_fuel(fuel2, advance(sig_decls), full)
      }
    }
  }
};
def seal_type_substs(sig_decls: List(AST), full: List(Pair)): List(Pair) = {
  seal_type_substs_fuel(int_mul(int_add(ast_list_size(sig_decls), 1), 2), sig_decls, full)
};
def apply_seal_subst_params_fuel(fuel: Integer, subs: List(Pair), params: List(Pair), ret: AST): Pair = {
  if int_eq(list_length(params), 0) then Pair.MkPair(list_empty[Pair](), apply_seal_subst_fuel(fuel, subs, ret)) else {
    match list_get(params, 0) {
      case MkPair(pn, pty) => {
        let pty2 = apply_seal_subst_fuel(fuel, subs, pty);
        let s2 = filter_subst_drop(subs, pn);
        match apply_seal_subst_params_fuel(fuel, s2, advance(params), ret) {
          case MkPair(ps2, r2) => Pair.MkPair(list_insert_first(ps2, Pair.MkPair(pn, pty2)), r2)
        }
      }
    }
  }
};
def apply_seal_subst_fuel(fuel: Integer, subs: List(Pair), t: AST): AST = {
  if int_eq(fuel, 0) then t else {
    let fuel2 = int_sub(fuel, 1);
    match t {
      case AstRef(n) => {
        match find_pair_ty(subs, n) {
          case SomeAST(def) => def;
          case OptionAST.NoneAST => t
        }
      };
      case AstFunTy(tps, params, ret, effs) => {
        match apply_seal_subst_params_fuel(fuel2, subs, params, ret) {
          case MkPair(ps2, r2) => AST.AstFunTy(tps, ps2, r2, effs)
        }
      };
      case AstPi(n, a, r, e) => {
        let a2 = apply_seal_subst_fuel(fuel2, subs, a);
        let s2 = filter_subst_drop(subs, n);
        AST.AstPi(n, a2, apply_seal_subst_fuel(fuel2, s2, r), e)
      };
      case AstApp(f, args) =>
        AST.AstApp(apply_seal_subst_fuel(fuel2, subs, f), list_map(args, \x => apply_seal_subst_fuel(fuel2, subs, x)));
      case AstTuple(xs) => AST.AstTuple(list_map(xs, \x => apply_seal_subst_fuel(fuel2, subs, x)));
      case AstSpan(sp, i) => AST.AstSpan(sp, apply_seal_subst_fuel(fuel2, subs, i));
      case AstTypeDecl(n, defs) => {
        if int_eq(list_length(defs), 0) then t
        else AST.AstTypeDecl(n, list_insert_first(list_empty[AST](), apply_seal_subst_fuel(fuel2, subs, list_get(defs, 0))))
      };
      case AstModTy(ex) => {
        AST.AstModTy(list_map(ex, \p => {
          match p {
            case MkPair(n, ty) => Pair.MkPair(n, apply_seal_subst_fuel(fuel2, subs, ty));
            case _ => p
          }
        }))
      };
      case _ => t
    }
  }
};
def apply_seal_subst(subs: List(Pair), t: AST): AST = apply_seal_subst_fuel(int_add(ast_size(t), 1), subs, t);
def apply_seal_subst_params(subs: List(Pair), params: List(Pair)): List(Pair) = {
  if int_eq(list_length(params), 0) then list_empty[Pair]() else {
    match list_get(params, 0) {
      case MkPair(n, ty) => list_insert_first(apply_seal_subst_params(subs, advance(params)), Pair.MkPair(n, apply_seal_subst(subs, ty)));
      case _ => apply_seal_subst_params(subs, advance(params))
    }
  }
};
def apply_type_eqs(decls: List(AST), eqs: List(Pair)): List(AST) = {
  if int_eq(list_length(decls), 0) then list_empty[AST]() else {
    let rest = apply_type_eqs(advance(decls), eqs);
    match list_get(decls, 0) {
      case AstTypeDecl(n, defs) => {
        match find_pair_ty(eqs, n) {
          case SomeAST(ty) => list_insert_first(rest, AST.AstTypeDecl(n, list_insert_first(list_empty[AST](), ty)));
          case OptionAST.NoneAST => list_insert_first(rest, AST.AstTypeDecl(n, defs))
        }
      };
      case AstSpan(sp, inner) => {
        match inner {
          case AstTypeDecl(n, defs) => {
            match find_pair_ty(eqs, n) {
              case SomeAST(ty) => list_insert_first(rest, AST.AstSpan(sp, AST.AstTypeDecl(n, list_insert_first(list_empty[AST](), ty))));
              case OptionAST.NoneAST => list_insert_first(rest, AST.AstSpan(sp, AST.AstTypeDecl(n, defs)))
            }
          };
          case _ => list_insert_first(rest, list_get(decls, 0))
        }
      };
      case AstSigVal(n, tps, params, ret, effs) => {
        let params2 = apply_seal_subst_params(eqs, params);
        let ret2 = apply_seal_subst(eqs, ret);
        list_insert_first(rest, AST.AstSigVal(n, tps, params2, ret2, effs))
      };
      case _ => list_insert_first(rest, list_get(decls, 0))
    }
  }
};
def apply_sig_with(base: AST, eqs: List(Pair)): AST = {
  match base {
    case AstSignature(name, decls) => AST.AstSignature(name, apply_type_eqs(decls, eqs));
    case AstSigWith(b, eqs2) => apply_sig_with(b, list_concat(eqs2, eqs));
    case AstSpan(_, inner) => apply_sig_with(inner, eqs);
    case _ => AST.AstSigWith(base, eqs)
  }
};
def flatten_sig_decls(fuel: Integer, ds: List(AST)): List(AST) = {
  if int_eq(fuel, 0) then ds else {
    if int_eq(list_length(ds), 0) then list_empty[AST]() else {
      let fuel2 = int_sub(fuel, 1);
      match list_get(ds, 0) {
        case AstSpan(_, inner) => flatten_sig_decls(fuel2, list_insert_first(advance(ds), inner));
        case AstSigWith(base, eqs) => {
          match apply_sig_with(base, eqs) {
            case AstSignature(_, decls) => flatten_sig_decls(fuel2, list_concat(decls, advance(ds)));
            case other => list_insert_first(flatten_sig_decls(fuel2, advance(ds)), other)
          }
        };
        case x => list_insert_first(flatten_sig_decls(fuel2, advance(ds)), x)
      }
    }
  }
};
def sig_decls_fuel(ds: List(AST)): Integer = int_mul(int_add(ast_list_size(ds), 1), 4);
def abstract_type_names(ds: List(AST), subs: List(Pair)): List(String) = {
  if int_eq(list_length(ds), 0) then list_empty[String]() else {
    let rest = abstract_type_names(advance(ds), subs);
    match list_get(ds, 0) {
      case AstTypeDecl(n, _) => {
        match find_pair_ty(subs, n) {
          case SomeAST(_) => rest;
          case OptionAST.NoneAST => list_insert_first(rest, n)
        }
      };
      case AstSpan(_, inner) => {
        match inner {
          case AstTypeDecl(n, _) => {
            match find_pair_ty(subs, n) {
              case SomeAST(_) => rest;
              case OptionAST.NoneAST => list_insert_first(rest, n)
            }
          };
          case _ => rest
        }
      };
      case _ => rest
    }
  }
};
def mark_abstract_ty(names: List(String), t: AST): AST = {
  match t {
    case AstRef(n) => {
      if string_in_list(n, names) then AST.AstApp(AST.AstRef("#abstract"), list_insert_first(list_empty[AST](), AST.AstRef(n))) else t
    };
    case AstApp(f, args) => AST.AstApp(mark_abstract_ty(names, f), list_map(args, \x => mark_abstract_ty(names, x)));
    case AstTuple(xs) => AST.AstTuple(list_map(xs, \x => mark_abstract_ty(names, x)));
    case AstSpan(sp, i) => AST.AstSpan(sp, mark_abstract_ty(names, i));
    case _ => t
  }
};
def mark_abstract_params(names: List(String), ps: List(Pair)): List(Pair) = {
  if int_eq(list_length(ps), 0) then list_empty[Pair]() else {
    match list_get(ps, 0) {
      case MkPair(n, ty) => list_insert_first(mark_abstract_params(names, advance(ps)), Pair.MkPair(n, mark_abstract_ty(names, ty)));
      case _ => mark_abstract_params(names, advance(ps))
    }
  }
};
def mark_abstract_export_ty(names: List(String), ty: AST): AST = {
  match ty {
    case AstFunTy(tps, ps, r, es) => AST.AstFunTy(tps, mark_abstract_params(names, ps), mark_abstract_ty(names, r), es);
    case AstSpan(sp, i) => AST.AstSpan(sp, mark_abstract_export_ty(names, i));
    case _ => ty
  }
};
def mark_abstract_exports(names: List(String), ps: List(Pair)): List(Pair) = {
  if int_eq(list_length(ps), 0) then list_empty[Pair]() else {
    match list_get(ps, 0) {
      case MkPair(n, ty) => list_insert_first(mark_abstract_exports(names, advance(ps)), Pair.MkPair(n, mark_abstract_export_ty(names, ty)));
      case _ => mark_abstract_exports(names, advance(ps))
    }
  }
};
def seal_cons_export(n: String, ty: AST, rest_res: Pair): Pair = {
  match rest_res {
    case MkPair(msg, xs) => {
      if string_eq(msg, "ok") then Pair.MkPair("ok", list_insert_first(xs, Pair.MkPair(n, ty)))
      else Pair.MkPair(msg, list_empty[Pair]())
    }
  }
};
def seal_sigval_member(opaque: Bool, n: String, tps: List(String), params: List(Pair), ret: AST, effs: List(String), subs: List(Pair), found: AST, rest_res: Pair): Pair = {
  let params2 = apply_seal_subst_params(subs, params);
  let ret2 = apply_seal_subst(subs, ret);
  let exported = if opaque then AST.AstFunTy(tps, params, ret, effs) else AST.AstFunTy(tps, params2, ret2, effs);
  match found {
    case AstError(_) => Pair.MkPair(string_concat("signature requires missing value: ", n), list_empty[Pair]());
    case AstFunTy(_, impl_params, impl_ret, impl_effs) => {
      let impl_params2 = apply_seal_subst_params(subs, impl_params);
      let impl_ret2 = apply_seal_subst(subs, impl_ret);
      if effect_row_subsumes(impl_effs, effs) then {
        if bool_and(types_match_seal_params(params2, impl_params2), types_match_seal(ret2, impl_ret2)) then
          seal_cons_export(n, exported, rest_res)
        else Pair.MkPair(string_concat("type mismatch for signature member: ", n), list_empty[Pair]())
      } else Pair.MkPair(string_concat("effect row too large for signature member: ", n), list_empty[Pair]())
    };
    case AstPi(_, impl_arg, impl_ret, impl_effs) => {
      let impl_arg2 = apply_seal_subst(subs, impl_arg);
      let impl_ret2 = apply_seal_subst(subs, impl_ret);
      if effect_row_subsumes(impl_effs, effs) then {
        if int_eq(list_length(params2), 1) then {
          match list_get(params2, 0) {
            case MkPair(_, sig_arg) => {
              if bool_and(types_match_seal(sig_arg, impl_arg2), types_match_seal(ret2, impl_ret2)) then
                seal_cons_export(n, exported, rest_res)
              else Pair.MkPair(string_concat("type mismatch for signature member: ", n), list_empty[Pair]())
            }
          }
        } else Pair.MkPair(string_concat("type mismatch for signature member: ", n), list_empty[Pair]())
      } else Pair.MkPair(string_concat("effect row too large for signature member: ", n), list_empty[Pair]())
    };
    case _ => Pair.MkPair(string_concat("type mismatch for signature member: ", n), list_empty[Pair]())
  }
};
def seal_exports_check_flat(opaque: Bool, full: List(Pair), subs: List(Pair), sig_decls: List(AST)): Pair = {
  // Abstract components are signature type components with no manifest;
  // derive that from the signature itself (not the implementation's manifests).
  if int_eq(list_length(sig_decls), 0) then Pair.MkPair("ok", list_empty[Pair]()) else {
    let rest = advance(sig_decls);
    match list_get(sig_decls, 0) {
      case AstSigVal(n, tps, params, ret, effs) =>
        seal_sigval_member(opaque, n, tps, params, ret, effs, subs, lookup_export(full, n), seal_exports_check_flat(opaque, full, subs, rest));
      case AstDef(n, _, _, _, _, _) => {
        let found = lookup_export(full, n);
        match found {
          case AstError(_) => Pair.MkPair(string_concat("signature requires missing value: ", n), list_empty[Pair]());
          case _ => seal_cons_export(n, found, seal_exports_check_flat(opaque, full, subs, rest))
        }
      };
      case AstTypeDecl(n, sig_defs) => {
        let found = lookup_export(full, n);
        match found {
          case AstError(_) => Pair.MkPair(string_concat("signature requires missing type: ", n), list_empty[Pair]());
          case AstTypeDecl(_, impl_defs) => {
            let manifest_ok = {
              if int_eq(list_length(sig_defs), 0) then true
              else if int_eq(list_length(impl_defs), 0) then false
              else types_match_seal(apply_seal_subst(subs, list_get(sig_defs, 0)), list_get(impl_defs, 0))
            };
            if bool_not(manifest_ok) then Pair.MkPair(string_concat("manifest type mismatch for: ", n), list_empty[Pair]()) else {
              // Manifest sig types stay visible under opaque; only abstract type t is hidden.
              let exported = if int_eq(list_length(sig_defs), 0) then {
                if opaque then AST.AstTypeDecl(n, list_empty[AST]()) else AST.AstTypeDecl(n, impl_defs)
              } else AST.AstTypeDecl(n, list_insert_first(list_empty[AST](), apply_seal_subst(subs, list_get(sig_defs, 0))));
              seal_cons_export(n, exported, seal_exports_check_flat(opaque, full, subs, rest))
            }
          };
          case _ => Pair.MkPair(string_concat("signature type component is not a type: ", n), list_empty[Pair]())
        }
      };
      case AstModule(n, _, _, body_spec) => {
        let found = lookup_export(full, n);
        match found {
          case AstModTy(impl_ex) => {
            let nested_subs = seal_type_substs(body_spec, impl_ex);
            match seal_exports_check_flat(opaque, impl_ex, nested_subs, body_spec) {
              case MkPair(nested_msg, nested_ex) => {
                if string_eq(nested_msg, "ok") then {
                  seal_cons_export(n, AST.AstModTy(nested_ex), seal_exports_check_flat(opaque, full, subs, rest))
                } else Pair.MkPair(string_concat("nested module signature mismatch for ", string_concat(n, string_concat(": ", nested_msg))), list_empty[Pair]())
              }
            }
          };
          case AstError(_) => Pair.MkPair(string_concat("signature requires missing module: ", n), list_empty[Pair]());
          case _ => Pair.MkPair(string_concat("signature module component is not a module: ", n), list_empty[Pair]())
        }
      };
      case AstSignature(_, decls) => {
        match seal_exports_check_flat(opaque, full, subs, decls) {
          case MkPair(msg, xs) => {
            if string_eq(msg, "ok") then {
              match seal_exports_check_flat(opaque, full, subs, rest) {
                case MkPair(rest_msg, ys) => {
                  if string_eq(rest_msg, "ok") then Pair.MkPair("ok", list_concat(xs, ys)) else Pair.MkPair(rest_msg, list_empty[Pair]())
                }
              }
            } else Pair.MkPair(msg, list_empty[Pair]())
          }
        }
      };
      case AstSigWith(base, eqs) => {
        match apply_sig_with(base, eqs) {
          case AstSignature(_, decls) => {
            match seal_exports_check_flat(opaque, full, subs, decls) {
              case MkPair(msg, xs) => {
                if string_eq(msg, "ok") then {
                  match seal_exports_check_flat(opaque, full, subs, rest) {
                    case MkPair(rest_msg, ys) => {
                      if string_eq(rest_msg, "ok") then Pair.MkPair("ok", list_concat(xs, ys)) else Pair.MkPair(rest_msg, list_empty[Pair]())
                    }
                  }
                } else Pair.MkPair(msg, list_empty[Pair]())
              }
            }
          };
          case _ => Pair.MkPair("invalid signature enrichment under sealing", list_empty[Pair]())
        }
      };
      case AstModTy(exports) => {
        let fake_decls = list_map(exports, \p => modty_fake_sigval(p));
        match seal_exports_check_flat(opaque, full, subs, fake_decls) {
          case MkPair(msg, xs) => {
            if string_eq(msg, "ok") then {
              match seal_exports_check_flat(opaque, full, subs, rest) {
                case MkPair(rest_msg, ys) => {
                  if string_eq(rest_msg, "ok") then Pair.MkPair("ok", list_concat(xs, ys)) else Pair.MkPair(rest_msg, list_empty[Pair]())
                }
              }
            } else Pair.MkPair(msg, list_empty[Pair]())
          }
        }
      };
      case _ => Pair.MkPair("invalid signature declaration under sealing", list_empty[Pair]())
    }
  }
};
def seal_exports_check(opaque: Bool, full: List(Pair), decls: List(AST)): Pair = {
  let flat = flatten_sig_decls(sig_decls_fuel(decls), decls);
  let subs = seal_type_substs(flat, full);
  seal_exports_check_flat(opaque, full, subs, flat)
};
def apply_sig_seal(opaque: Bool, full_ex: List(Pair), body_ast: List(AST), sTy: AST, seal_node: AST): Pair = {
  match sTy {
    case AstSignature(_, decls) => {
      match seal_exports_check(opaque, full_ex, decls) {
        case MkPair(msg, sealed) => {
          if string_eq(msg, "ok") then {
            let sig_subs = seal_type_substs(decls, module_exports_of(decls));
            let abstracts = abstract_type_names(decls, sig_subs);
            let sealed2 = if opaque then mark_abstract_exports(abstracts, sealed) else sealed;
            let body2 = if opaque then keep_sealed(sealed2, body_ast) else body_ast;
            Pair.MkPair(AST.AstModTy(sealed2), Pair.MkPair(seal_node, body2))
          } else Pair.MkPair(AST.AstError(msg), Pair.MkPair(seal_node, body_ast))
        }
      }
    };
    case AstSigWith(base, eqs) => {
      match apply_sig_with(base, eqs) {
        case AstSignature(_, decls) => {
          match seal_exports_check(opaque, full_ex, decls) {
            case MkPair(msg, sealed) => {
              if string_eq(msg, "ok") then {
                let body2 = if opaque then keep_sealed(sealed, body_ast) else body_ast;
                Pair.MkPair(AST.AstModTy(sealed), Pair.MkPair(seal_node, body2))
              } else Pair.MkPair(AST.AstError(msg), Pair.MkPair(seal_node, body_ast))
            }
          }
        };
        case _ => Pair.MkPair(AST.AstError("invalid signature enrichment for sealing"), Pair.MkPair(seal_node, body_ast))
      }
    };
    case AstModTy(ex) => Pair.MkPair(AST.AstModTy(ex), Pair.MkPair(seal_node, body_ast));
    case _ => Pair.MkPair(AST.AstModTy(full_ex), Pair.MkPair(seal_node, body_ast))
  }
};
def sig_type_component_names(ds: List(AST)): List(String) = {
  if int_eq(list_length(ds), 0) then list_empty[String]() else {
    let rest = sig_type_component_names(advance(ds));
    match list_get(ds, 0) {
      case AstTypeDecl(n, _) => list_insert_first(rest, n);
      case _ => rest
    }
  }
};
def check_with_eq_names(es: List(Pair), names: List(String)): String = {
  if int_eq(list_length(es), 0) then "ok" else {
    match list_get(es, 0) {
      case MkPair(n, _) => {
        if string_in_list(n, names) then check_with_eq_names(advance(es), names)
        else string_concat("unknown type component in with type: ", n)
      }
    }
  }
};
def elab_sig_with_eqs(env: List(Pair), eqs: List(Pair)): List(Pair) = {
  if int_eq(list_length(eqs), 0) then list_empty[Pair]() else {
    match list_get(eqs, 0) {
      case MkPair(n, ty_cst) => {
        match elaborate(env, ty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse"))) {
          case MkPair(tAst, _) => list_insert_first(elab_sig_with_eqs(env, advance(eqs)), Pair.MkPair(n, tAst))
        }
      }
    }
  }
};
def seal_is_applicative(seal: List(AST)): Bool = {
  if int_eq(list_length(seal), 0) then false else {
    match list_get(seal, 0) {
      case AstRef(n) => string_eq(n, "#applicative");
      case AstApp(f, _) => {
        match f {
          case AstRef(n) => string_eq(n, "#applicative");
          case _ => false
        }
      };
      case _ => false
    }
  }
};
def elab_functor_args(env: List(Pair), args: List(CST)): Pair = {
  if int_eq(list_length(args), 0) then Pair.MkPair(list_empty[AST](), list_empty[AST]()) else {
    match elaborate(env, list_get(args, 0), OptionAST.NoneAST) {
      case MkPair(a, ty) => {
        match elab_functor_args(env, advance(args)) {
          case MkPair(rest_a, rest_t) =>
            Pair.MkPair(list_insert_first(rest_a, a), list_insert_first(rest_t, ty))
        }
      }
    }
  }
};
def arg_exports_of(aty: AST): List(Pair) = {
  match strip_span(aty) {
    case AstModTy(ex) => ex;
    case AstModule(_, _, _, b) => module_exports_of(b);
    case AstSignature(_, decls) => module_exports_of(decls);
    case _ => list_empty[Pair]()
  }
};
def resolve_functor_formal(env: List(Pair), psig: AST): AST = {
  let p0 = match strip_span(psig) {
    case AstSigWith(base, eqs) => apply_sig_with(base, eqs);
    case other => other
  };
  match strip_span(p0) {
    case AstRef(n) => {
      match resolve_hygiene(env, n, list_empty[Integer]()) {
        case MkPair(ty, _) => {
          match strip_span(ty) {
            case AstSignature(_, _) => ty;
            case AstSigWith(base, eqs) => apply_sig_with(base, eqs);
            case AstModTy(_) => ty;
            case AstError(_) => p0;
            case _ => p0
          }
        }
      }
    };
    case other => other
  }
};
def modty_as_fake_decls(sex: List(Pair)): List(AST) = {
  if int_eq(list_length(sex), 0) then list_empty[AST]() else {
    let rest = modty_as_fake_decls(advance(sex));
    match list_get(sex, 0) {
      case MkPair(n, ty) => {
        match ty {
          case AstFunTy(tps, params, ret, effs) => list_insert_first(rest, AST.AstSigVal(n, tps, params, ret, effs));
          case AstTypeDecl(_, defs) => list_insert_first(rest, AST.AstTypeDecl(n, defs));
          case other => list_insert_first(rest, other)
        }
      }
    }
  }
};
def check_functor_args(env: List(Pair), ps: List(Pair), arg_tys: List(AST)): String = {
  if int_eq(list_length(ps), 0) then {
    if int_eq(list_length(arg_tys), 0) then "ok" else "functor arity mismatch"
  } else if int_eq(list_length(arg_tys), 0) then "functor arity mismatch" else {
    match list_get(ps, 0) {
      case MkPair(pn, psig) => {
        let psig2 = resolve_functor_formal(env, psig);
        let aty = strip_span(list_get(arg_tys, 0));
        let msg = match psig2 {
          case AstSignature(_, decls) => {
            match seal_exports_check(true, arg_exports_of(aty), decls) {
              case MkPair(m, _) => m
            }
          };
          case AstModTy(sex) => {
            match seal_exports_check(true, arg_exports_of(aty), modty_as_fake_decls(sex)) {
              case MkPair(m, _) => m
            }
          };
          case _ => {
            if types_compat(psig2, aty) then "ok"
            else string_concat("functor argument mismatch for parameter: ", pn)
          }
        };
        if string_eq(msg, "ok") then check_functor_args(env, advance(ps), advance(arg_tys)) else msg
      }
    }
  }
};
def functor_subst_ref(old: String, new_name: String, t: AST): AST = {
  match t {
    case AstRef(n) => {
      if string_eq(n, old) then AST.AstRef(new_name) else t
    };
    case AstFunTy(tps, params, ret, effs) =>
      AST.AstFunTy(tps, list_map(params, \p => {
        match p {
          case MkPair(n, ty) => Pair.MkPair(n, functor_subst_ref(old, new_name, ty));
          case _ => p
        }
      }), functor_subst_ref(old, new_name, ret), effs);
    case AstPi(n, a, r, e) =>
      AST.AstPi(n, functor_subst_ref(old, new_name, a), functor_subst_ref(old, new_name, r), e);
    case AstTypeDecl(n, defs) => {
      if int_eq(list_length(defs), 0) then t
      else AST.AstTypeDecl(n, list_insert_first(list_empty[AST](), functor_subst_ref(old, new_name, list_get(defs, 0))))
    };
    case AstApp(f, args) =>
      AST.AstApp(functor_subst_ref(old, new_name, f), list_map(args, \a => functor_subst_ref(old, new_name, a)));
    case AstSpan(sp, i) => AST.AstSpan(sp, functor_subst_ref(old, new_name, i));
    case AstModTy(ex) =>
      AST.AstModTy(list_map(ex, \p => {
        match p {
          case MkPair(n, ty) => Pair.MkPair(n, functor_subst_ref(old, new_name, ty));
          case _ => p
        }
      }));
    case _ => t
  }
};
def subst_exports_params(ps: List(Pair), arg_asts: List(AST), ex: List(Pair)): List(Pair) = {
  if int_eq(list_length(ps), 0) then ex else {
    if int_eq(list_length(arg_asts), 0) then ex else {
      match list_get(ps, 0) {
        case MkPair(pn, _) => {
          let new_name = match list_get(arg_asts, 0) {
            case AstModule(an, _, _, _) => an;
            case AstRef(an) => an;
            case _ => pn
          };
          let ex2 = list_map(ex, \p => {
            match p {
              case MkPair(n, ty) => Pair.MkPair(n, functor_subst_ref(pn, new_name, ty));
              case _ => p
            }
          });
          subst_exports_params(advance(ps), advance(arg_asts), ex2)
        }
      }
    }
  }
};
def functor_app_result_ty(seal: List(AST), body: List(AST), ex0: List(Pair)): AST = {
  if int_eq(list_length(seal), 0) then AST.AstModTy(ex0) else {
    match list_get(seal, 0) {
      case AstSignature(_, decls) => {
        match seal_exports_check(true, ex0, decls) {
          case MkPair(msg, xs) => {
            if string_eq(msg, "ok") then AST.AstModTy(xs) else AST.AstError(msg)
          }
        }
      };
      case AstApp(f, inners) => {
        match f {
          case AstRef(tag) => {
            if bool_and(string_eq(tag, "#applicative"), bool_not(int_eq(list_length(inners), 0))) then {
              match list_get(inners, 0) {
                case AstSignature(_, decls) => {
                  match seal_exports_check(true, ex0, decls) {
                    case MkPair(msg, xs) => {
                      if string_eq(msg, "ok") then AST.AstModTy(xs) else AST.AstError(msg)
                    }
                  }
                };
                case _ => AST.AstModTy(ex0)
              }
            } else AST.AstModTy(ex0)
          };
          case _ => AST.AstModTy(ex0)
        }
      };
      case AstSigWith(base, eqs) => {
        match apply_sig_with(base, eqs) {
          case AstSignature(_, decls) => {
            match seal_exports_check(true, ex0, decls) {
              case MkPair(msg, xs) => {
                if string_eq(msg, "ok") then AST.AstModTy(xs) else AST.AstError(msg)
              }
            }
          };
          case _ => AST.AstModTy(ex0)
        }
      };
      case AstModTy(e) => AST.AstModTy(e);
      case _ => AST.AstModTy(ex0)
    }
  }
};
def effect_row_subsumes(needed: List(String), provided: List(String)): Bool = {
  if int_eq(list_length(needed), 0) then true else {
    let n = list_get(needed, 0);
    if is_row_var(n) then effect_row_subsumes(advance(needed), provided) else {
      if effect_in_row(n, provided) then effect_row_subsumes(advance(needed), provided) else false
    }
}
};
def effect_rows_compatible(e1: List(String), e2: List(String)): Bool = {
  if effect_row_subsumes(e1, e2) then true else effect_row_subsumes(e2, e1)
};
def effect_labels(es: List(String)): List(String) = {
  if int_eq(list_length(es), 0) then list_empty[String]() else {
    if is_row_var(list_get(es, 0)) then effect_labels(advance(es)) else list_insert_first(effect_labels(advance(es)), list_get(es, 0))
  }
};
def effects_covered_by(needed: List(String), active: List(String)): Bool = {
  if int_eq(list_length(needed), 0) then true else {
    let n = list_get(needed, 0);
    if is_row_var(n) then effects_covered_by(advance(needed), active) else {
      if string_in_list(n, active) then effects_covered_by(advance(needed), active) else false
    }
}
};
def add_effect(e: String, es: List(String)): List(String) = {
  if string_in_list(e, es) then es else list_insert_first(es, e)
};
def merge_effects(a: List(String), b: List(String)): List(String) = {
  if int_eq(list_length(a), 0) then b else merge_effects(advance(a), add_effect(list_get(a, 0), b))
};
def fresh_row_var(): String = {
  let s = get_elab_state();
  match s {
    case MkElabState(env, next_var, subst, exts, effects, active, pending) => {
      put_elab_state(ElabState.MkElabState(env, int_add(next_var, 1), subst, exts, effects, active, pending));
      string_concat("mu", int_to_string(next_var))
    }
  }
};
def with_open_row(effs: List(String)): List(String) = {
  list_append(effs, fresh_row_var())
};
def elab_extract_vars(args: List(CST)): List(String) = {
  if int_eq(list_length(args), 0) then list_empty[String]() else {
    let a = list_get(args, 0);
    let rest = elab_extract_vars(advance(args));
    match a {
      case Symbol(s, _) => list_insert_first(rest, s);
      case _ => rest
    }
  }
};
def add_vars_to_env(env: List(Pair), vars: List(String), ctx: List(Integer)): List(Pair) = {
  if int_eq(list_length(vars), 0) then env else {
    let v = list_get(vars, 0);
    let rest = add_vars_to_env(env, advance(vars), ctx);
    list_insert_first(rest, Pair.MkPair(Pair.MkPair(v, ctx), fresh_meta()))
  }
};
def abstract_ty_name(ty: AST): String = {
  match ty {
    case AstApp(f, args) => {
      match f {
        case AstRef(n) => {
          if string_eq(n, "#abstract") then {
            if int_eq(list_length(args), 0) then "" else {
              match list_get(args, 0) {
                case AstRef(m) => m;
                case _ => ""
              }
            }
          } else ""
        };
        case _ => ""
      }
    };
    case AstSpan(_, inner) => abstract_ty_name(inner);
    case _ => ""
  }
};
def abstract_mismatch(expected_ty: AST, actual_ty: AST): Bool = {
  let exp = abstract_ty_name(expected_ty);
  if string_eq(exp, "") then false else bool_not(string_eq(abstract_ty_name(actual_ty), exp))
};
def elab_check_args(env: List(Pair), fs: AST, as_: List(CST)): Pair = {
  if int_eq(list_length(as_), 0) then {
    match fs {
      case AstFunTy(_, _, ret_ty, _) => Pair.MkPair(list_empty[AST](), ret_ty);
      case AstPi(_, _, ret_ty, _) => Pair.MkPair(list_empty[AST](), ret_ty);
      case _ => Pair.MkPair(list_empty[AST](), fs)
    }
  } else {
    let a = list_get(as_, 0);
    let rest = advance(as_);
    match fs {
      case AstFunTy(tps, params, ret_ty, effs) => {
        if int_eq(list_length(params), 0) then {
          let aAst_res = elaborate(env, a, OptionAST.NoneAST);
          match aAst_res {
            case MkPair(aAst_expr, _) => {
              let restAst_res = elab_check_args(env, AST.AstRef("Any"), rest);
              match restAst_res {
                case MkPair(restAst_exprs, _) =>
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), AST.AstRef("Any"))
              }
            }
          }
        } else {
          match list_get(params, 0) {
            case MkPair(_, arg_ty) => {
              let aAst_res = elaborate(env, a, OptionAST.SomeAST(arg_ty));
              match aAst_res {
                case MkPair(aAst_expr, a_ty) => {
                  if abstract_mismatch(arg_ty, a_ty) then Pair.MkPair(list_insert_first(list_empty[AST](), AST.AstError(string_concat("opaque type mismatch: ", abstract_ty_name(arg_ty)))), AST.AstRef("Any"))
                  else {
                    let next_fs = if int_eq(list_length(advance(params)), 0) then ret_ty else AST.AstFunTy(tps, advance(params), ret_ty, effs);
                    let restAst_res = elab_check_args(env, next_fs, rest);
                    match restAst_res {
                      case MkPair(restAst_exprs, restAst_ty) =>
                        Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
                    }
                  }
                }
              }
            }
          }
        }
      };
      case AstPi(_, arg_ty, ret_ty, _) => {
        let aAst_res = elaborate(env, a, OptionAST.SomeAST(arg_ty));
        match aAst_res {
          case MkPair(aAst_expr, a_ty) => {
            if abstract_mismatch(arg_ty, a_ty) then Pair.MkPair(list_insert_first(list_empty[AST](), AST.AstError(string_concat("opaque type mismatch: ", abstract_ty_name(arg_ty)))), AST.AstRef("Any"))
            else {
              let restAst_res = elab_check_args(env, ret_ty, rest);
              match restAst_res {
                case MkPair(restAst_exprs, restAst_ty) => {
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
                }
              }
            }
          }
        }
      };
      case AstRef(name) => {
        if string_eq(name, "Any") then {
          let aAst_res = elaborate(env, a, OptionAST.NoneAST);
          match aAst_res {
            case MkPair(aAst_expr, _) => {
              let restAst_res = elab_check_args(env, AST.AstRef("Any"), rest);
              match restAst_res {
                case MkPair(restAst_exprs, _) => {
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), AST.AstRef("Any"))
                }
              }
            }
          }
        } else {
          let argTyM = fresh_meta();
          let retTyM = fresh_meta();
          unify_top(fs, AST.AstPi("x", argTyM, retTyM, list_empty[String]()));
          let aAst_res = elaborate(env, a, OptionAST.SomeAST(argTyM));
          match aAst_res {
            case MkPair(aAst_expr, _) => {
              let restAst_res = elab_check_args(env, retTyM, rest);
              match restAst_res {
                case MkPair(restAst_exprs, restAst_ty) => {
                  Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
                }
              }
            }
          }
        }
};
      case _ => {
        let argTyM = fresh_meta();
        let retTyM = fresh_meta();
        unify_top(fs, AST.AstPi("x", argTyM, retTyM, list_empty[String]()));
        let aAst_res = elaborate(env, a, OptionAST.SomeAST(argTyM));
        match aAst_res {
          case MkPair(aAst_expr, _) => {
            let restAst_res = elab_check_args(env, retTyM, rest);
            match restAst_res {
              case MkPair(restAst_exprs, restAst_ty) => {
                Pair.MkPair(list_insert_first(restAst_exprs, aAst_expr), restAst_ty)
              }
            }
          }
        }
      }
    }
  }
};
def elab_extern_decls(env: List(Pair), decls: List(CST)): Pair = {
  if int_eq(list_length(decls), 0) then Pair.MkPair(list_empty[String](), env) else {
    let d = list_get(decls, 0);
    let rest = advance(decls);
    match d {
      case DefCST(op, _, _, _, _, span) => {
        let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
        let rest_res = elab_extern_decls(new_env, rest);
        match rest_res {
          case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
        }
      };
      case SeqOf(elems, span) => {
        if int_lt(list_length(elems), 2) then elab_extern_decls(env, rest) else {
          match list_get(elems, 0) {
            case Symbol(kw, _) => {
              if string_eq(kw, "def") then {
                match list_get(elems, 1) {
                  case Symbol(op, _) => {
                    let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
                    let rest_res = elab_extern_decls(new_env, rest);
                    match rest_res {
                      case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
                    }
                  };
                  case AppCST(f, _, _) => {
                    match f {
                      case Symbol(op, _) => {
                        let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(op, span_context(span)), AST.AstRef("Any")));
                        let rest_res = elab_extern_decls(new_env, rest);
                        match rest_res {
                          case MkPair(syms, final_env) => Pair.MkPair(list_insert_first(syms, op), final_env)
                        }
                      };
                      case _ => elab_extern_decls(env, rest)
                    }
                  };
                  case _ => elab_extern_decls(env, rest)
                }
              } else elab_extern_decls(env, rest)
            };
            case _ => elab_extern_decls(env, rest)
          }
        }
      };
      case _ => elab_extern_decls(env, rest)
    }
  }
};
def collect_def_binders(ls: List(CST)): List(Pair) = {
  if int_eq(list_length(ls), 0) then list_empty[Pair]() else {
    let x = list_get(ls, 0);
    let rest = collect_def_binders(advance(ls));
    match x {
      case DefCST(name, _, _, _, _, span) =>
        list_insert_first(rest, Pair.MkPair(Pair.MkPair(name, span_context(span)), AST.AstRef("Any")));
      case ModuleCST(name, _, _, _, span) =>
        list_insert_first(rest, Pair.MkPair(Pair.MkPair(name, span_context(span)), AST.AstModTy(list_empty[Pair]())));
      case ModuleAliasCST(name, _, span) =>
        list_insert_first(rest, Pair.MkPair(Pair.MkPair(name, span_context(span)), AST.AstModTy(list_empty[Pair]())));
      case SignatureCST(name, _, span) =>
        list_insert_first(rest, Pair.MkPair(Pair.MkPair(name, span_context(span)), AST.AstSignature(name, list_empty[AST]())));
      case _ => rest
    }
  }
};
def map_elabs(env: List(Pair), ls: List(CST)): Pair = {
  if int_eq(list_length(ls), 0) then Pair.MkPair(list_empty[AST](), env) else {
    let x = list_get(ls, 0);
    let xs = advance(ls);
    match x {
      case LetCST(name, value, _, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, vTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let let_node = AST.AstLet(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, let_node), final_env)
              }
            }
          }
        }
      };
      case VarCST(name, value, _, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, vTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let var_node = AST.AstVar(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, var_node), final_env)
              }
            }
          }
        }
      };
      case AssignCST(name, value, span) => {
        let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
        match valueAst_res {
          case MkPair(vAst, _) => {
            let rest_res = map_elabs(env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                let asg = AST.AstAssign(mangle_name(name, span_context(span)), vAst);
                Pair.MkPair(list_insert_first(restAst, asg), final_env)
              }
            }
          }
        }
      };
      case DefCST(name, _, _, ret_ty, _, span) => {
        let tyAst_res = elaborate(env, ret_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
        match tyAst_res {
          case MkPair(tAst, _) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), tAst));
            let res = elaborate(env, x, OptionAST.NoneAST);
            match res {
              case MkPair(rAst, _) => {
                let rest_res = map_elabs(new_env, xs);
                match rest_res {
                  case MkPair(restAst, final_env) => {
                    Pair.MkPair(list_insert_first(restAst, rAst), final_env)
                  }
                }
              }
            }
          }
        }
      };
      case ImportCST(lang, alias, mod_path, syms, _) => {
        let rest_res = map_elabs(env, xs);
        match rest_res {
          case MkPair(restAst, final_env) => {
            Pair.MkPair(list_insert_first(restAst, AST.AstImport(lang, alias, mod_path, syms)), final_env)
          }
        }
      };
      case ExternCST(lang, mod_path, decls, _) => {
        let ext_res = elab_extern_decls(env, decls);
        match ext_res {
          case MkPair(syms, new_env) => {
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                Pair.MkPair(list_insert_first(restAst, AST.AstImport(lang, "", mod_path, syms)), final_env)
              }
            }
          }
        }
      };
      case ModuleCST(name, _, _, _, span) => {
        let res = elaborate(env, x, OptionAST.NoneAST);
        match res {
          case MkPair(rAst, rTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), rTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) =>
                Pair.MkPair(list_insert_first(restAst, rAst), final_env)
            }
          }
        }
      };
      case ModuleAliasCST(name, _, span) => {
        let res = elaborate(env, x, OptionAST.NoneAST);
        match res {
          case MkPair(rAst, rTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), rTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) =>
                Pair.MkPair(list_insert_first(restAst, rAst), final_env)
            }
          }
        }
      };
      case SignatureCST(name, _, span) => {
        let res = elaborate(env, x, OptionAST.NoneAST);
        match res {
          case MkPair(rAst, rTy) => {
            let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), rTy));
            let rest_res = map_elabs(new_env, xs);
            match rest_res {
              case MkPair(restAst, final_env) =>
                Pair.MkPair(list_insert_first(restAst, rAst), final_env)
            }
          }
        }
      };
      case _ => {
        let res = elaborate(env, x, OptionAST.NoneAST);
        match res {
          case MkPair(rAst, _) => {
            let rest_res = map_elabs(env, xs);
            match rest_res {
              case MkPair(restAst, final_env) => {
                Pair.MkPair(list_insert_first(restAst, rAst), final_env)
              }
            }
          }
        }
      }
    }
  }
};
// SigValCST / ModuleCST formals store (name, ty) pairs already (not raw CST params).
def elab_named_cst_params(env: List(Pair), ps: List(Pair)): List(Pair) = {
  if int_eq(list_length(ps), 0) then list_empty[Pair]() else {
    let rest = elab_named_cst_params(env, advance(ps));
    match list_get(ps, 0) {
      case MkPair(n, ty_cst) => {
        let tyAst_res = elaborate(env, ty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
        match tyAst_res {
          case MkPair(tAst, _) => list_insert_first(rest, Pair.MkPair(n, tAst))
        }
      }
    }
  }
};
def cst_list_has_arrow(xs: List(CST)): Bool = {
  if int_eq(list_length(xs), 0) then false else {
    match list_get(xs, 0) {
      case Symbol(op, _) => {
        if string_eq(op, "->") then true else cst_list_has_arrow(advance(xs))
      };
      case _ => cst_list_has_arrow(advance(xs))
    }
  }
};
def cst_has_arrow(c: CST): Bool = {
  match c {
    case SeqOf(xs, _) => cst_list_has_arrow(xs);
    case _ => false
  }
};
def split_cst_arrow(acc: List(CST), xs: List(CST)): Pair = {
  if int_eq(list_length(xs), 0) then Pair.MkPair(list_reverse(acc), list_empty[CST]()) else {
    let head = list_get(xs, 0);
    match head {
      case Symbol(op, _) => {
        if string_eq(op, "->") then Pair.MkPair(list_reverse(acc), advance(xs))
        else split_cst_arrow(list_insert_first(acc, head), advance(xs))
      };
      case _ => split_cst_arrow(list_insert_first(acc, head), advance(xs))
    }
  }
};
def elab_arrow_binders(env: List(Pair), binders: List(CST)): Pair = {
  if int_eq(list_length(binders), 0) then Pair.MkPair(list_empty[Pair](), env) else {
    let binder = list_get(binders, 0);
    match binder {
      case SeqOf(elems, bsp) => {
        if int_lt(list_length(elems), 2) then Pair.MkPair(list_empty[Pair](), env) else {
          match list_get(elems, 0) {
            case Symbol(name, _) => {
              match list_get(elems, 1) {
                case Symbol(colon, _) => {
                  if string_eq(colon, ":") then {
                    let tys = list_drop_n(2, elems);
                    let ty_cst = if int_eq(list_length(tys), 1) then list_get(tys, 0) else SeqOf(tys, bsp);
                    let ty_res = elaborate(env, ty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                    match ty_res {
                      case MkPair(ty_ast, _) => {
                        let env1 = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(bsp)), ty_ast));
                        let rest = elab_arrow_binders(env1, advance(binders));
                        match rest {
                          case MkPair(rest_params, final_env) => Pair.MkPair(list_insert_first(rest_params, Pair.MkPair(name, ty_ast)), final_env)
                        }
                      }
                    }
                  } else Pair.MkPair(list_empty[Pair](), env)
                };
                case _ => Pair.MkPair(list_empty[Pair](), env)
              }
            };
            case _ => Pair.MkPair(list_empty[Pair](), env)
          }
        }
      };
      case Symbol(name, bsp) => {
        let env1 = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(bsp)), AST.AstRef("Any")));
        let rest = elab_arrow_binders(env1, advance(binders));
        match rest {
          case MkPair(rest_params, final_env) => Pair.MkPair(list_insert_first(rest_params, Pair.MkPair(name, AST.AstRef("Any"))), final_env)
        }
      };
      case _ => Pair.MkPair(list_empty[Pair](), env)
    }
  }
};
def elab_arrow_param_type(env: List(Pair), pty_cst: CST, span: Span): AST = {
  match pty_cst {
    case SeqOf(elems, sp) => {
      let split_res = split_cst_arrow(list_empty[CST](), elems);
      match split_res {
        case MkPair(lhs, rhs) => {
          if int_eq(list_length(lhs), 1) then {
            let lhs_ty = list_get(lhs, 0);
            let ret_cst = if int_eq(list_length(rhs), 1) then list_get(rhs, 0) else SeqOf(rhs, sp);
            match lhs_ty {
              case Tuple(binders, _) => {
                let bind_res = elab_arrow_binders(env, binders);
                match bind_res {
                  case MkPair(params, ret_env) => {
                    let ret_res = elaborate(ret_env, ret_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                    match ret_res {
                      case MkPair(ret_ty, _) => AST.AstFunTy(list_empty[String](), params, ret_ty, list_empty[String]())
                    }
                  }
                }
              };
              case _ => {
                let arg_res = elaborate(env, lhs_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                match arg_res {
                  case MkPair(arg_ty, _) => {
                    let ret_env = list_insert_first(env, Pair.MkPair(Pair.MkPair("_", span_context(sp)), arg_ty));
                    let ret_res = elaborate(ret_env, ret_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                    match ret_res {
                      case MkPair(ret_ty, _) => AST.AstFunTy(list_empty[String](), list_insert_first(list_empty[Pair](), Pair.MkPair("_", arg_ty)), ret_ty, list_empty[String]())
                    }
                  }
                }
              }
            }
          } else AST.AstError("malformed arrow parameter type")
        }
      }
    };
    case _ => AST.AstError("malformed arrow parameter type")
  }
};
def elab_map_params(env: List(Pair), ps: List(CST)): Pair = {
  if int_eq(list_length(ps), 0) then Pair.MkPair(list_empty[Pair](), list_empty[Pair]()) else {
    let p = list_get(ps, 0);
    let rest_res = elab_map_params(env, advance(ps));
    match rest_res {
      case MkPair(restAst, restEnvItems) => {
        match p {
          case Tuple(elems, sp) => {
            if int_eq(list_length(elems), 2) then {
              let pname_cst = list_get(elems, 0);
              let pty_cst = list_get(elems, 1);
              match pname_cst {
                case Symbol(pname, _) => {
                  let tyAst_res = elaborate(env, pty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                  match tyAst_res {
                    case MkPair(tAst, _) => {
                      Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
                    }
                  }
                };
                case _ => rest_res
              }
            } else rest_res
          };
          // Expander extract_params builds SeqOf(name, ":", ty, …)
          case SeqOf(elems, sp) => {
            if int_lt(list_length(elems), 2) then rest_res else {
              match list_get(elems, 0) {
                case Symbol(pname, _) => {
                  match list_get(elems, 1) {
                    case Symbol(kw, _) => {
                      if string_eq(kw, ":") then {
                        let pty_cst = if int_eq(list_length(elems), 3) then list_get(elems, 2) else SeqOf(advance(advance(elems)), sp);
                        let tyAst_res = if cst_has_arrow(pty_cst) then Pair.MkPair(elab_arrow_param_type(env, pty_cst, sp), AST.AstRef("TypeUniverse"))
                          else elaborate(env, pty_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
                        match tyAst_res {
                          case MkPair(tAst, _) => {
                            Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
                          }
                        }
                      } else rest_res
                    };
                    case _ => rest_res
                  }
                };
                case _ => rest_res
              }
            }
          };
          case Symbol(pname, sp) => {
            let tAst = AST.AstRef("Unknown");
            Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pname, tAst)), list_insert_first(restEnvItems, Pair.MkPair(Pair.MkPair(pname, span_context(sp)), tAst)))
          };
          case _ => rest_res
        }
      }
    }
  }
};
def elab_check_targs(env: List(Pair), as_: List(CST)): List(AST) = {
  if int_eq(list_length(as_), 0) then list_empty[AST]() else {
    let a = list_get(as_, 0);
    let rest = elab_check_targs(env, advance(as_));
    let aAst_res = elaborate(env, a, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
    match aAst_res {
      case MkPair(aAst_expr, _) => list_insert_first(rest, aAst_expr)
    }
}
};
def elab_variant(v: CST): Pair = {
  match v {
    case AppCST(f, args, _) => {
      match f {
        case Symbol(op, _) => {
          if string_eq(op, ":") then {
            let lhs = list_get(args, 0);
            let rhs = list_get(args, 1);
            let rhs_res = elaborate(list_empty[Pair](), rhs, OptionAST.NoneAST);
            let ret_ty = match rhs_res {
              case MkPair(ast, _) => ast
            };
            match lhs {
              case AppCST(inner_f, inner_args, _) => {
                match inner_f {
                  case Symbol(vname, _) => {

                    Pair.MkPair(vname, Pair.MkPair(elab_fields(inner_args), ret_ty))
                  };
                  case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), ret_ty))
                }
              };
              case Symbol(vname, _) => Pair.MkPair(vname, Pair.MkPair(list_empty[AST](), ret_ty));
              case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), ret_ty))
            }
          } else Pair.MkPair(op, Pair.MkPair(elab_fields(args), AST.AstRef("Any")))
        };
        case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), AST.AstRef("Any")))
      }
    };
    case Symbol(vname, _) => Pair.MkPair(vname, Pair.MkPair(list_empty[AST](), AST.AstRef("Any")));
    case _ => Pair.MkPair("unknown", Pair.MkPair(list_empty[AST](), AST.AstRef("Any")))
  }
};
def elab_variants(vs: List(CST)): List(Pair) = {
  if int_eq(list_length(vs), 0) then list_empty[Pair]() else {
    let v = list_get(vs, 0);
    list_insert_first(elab_variants(advance(vs)), elab_variant(v))
  }
};
def elab_cases(env: List(Pair), expected: OptionAST, cs: List(CST), expr_ty: AST): Pair = {
  if int_eq(list_length(cs), 0) then Pair.MkPair(list_empty[Pair](), AST.AstRef("Any")) else {
    let c = list_get(cs, 0);
    let rest_res = elab_cases(env, expected, advance(cs), expr_ty);
    match c {
      case SeqOf(elems, _) => {
        if int_eq(list_length(elems), 2) then {
          let pat_cst = list_get(elems, 0);
          let body_cst = list_get(elems, 1);
          let pat_ast_res = match pat_cst {
            case Symbol(pname, _) => {
              if string_eq(pname, "_") then PatternAST.PatWildcard else PatternAST.PatVar(pname)
            };
            case FieldAccess(_, field, _) => PatternAST.PatConstructor(field, list_empty[String]());
            case AppCST(f, args, _) => {
              match f {
                case Symbol(cname, _) => PatternAST.PatConstructor(cname, elab_extract_vars(args));
                case FieldAccess(_, field, _) => PatternAST.PatConstructor(field, elab_extract_vars(args));
                case _ => PatternAST.PatWildcard
              }
            };
            case _ => PatternAST.PatWildcard
          };
          let case_env = match pat_ast_res {
            case PatVar(v) => list_insert_first(env, Pair.MkPair(Pair.MkPair(v, list_empty[Integer]()), fresh_meta()));
            case PatConstructor(_, vars) => add_vars_to_env(env, vars, list_empty[Integer]());
            case _ => env
          };
          let old_state = get_elab_state();
          match pat_ast_res {
            case PatConstructor(cname, _) => {
              let ctor_ty = resolve_hygiene(env, cname, list_empty[Integer]());
              match ctor_ty {
                case MkPair(ty, _) => unify_top(expr_ty, ty);
                case _ => ()
              }
            };
            case _ => ()
          };
          let body_ast_res = elaborate(case_env, body_cst, expected);
          // Restore the solver state (but keep next_var so we don't reuse meta IDs)
          let new_state = get_elab_state();
          match old_state {
            case MkElabState(_, _, old_subst, _, _, _, _) => {
              match new_state {
                case MkElabState(new_e, new_nv, _, new_exts, new_effects, new_active, new_pending) => {
                  put_elab_state(ElabState.MkElabState(new_e, new_nv, old_subst, new_exts, new_effects, new_active, new_pending))
                }
              }
            }
          };
          match body_ast_res {
            case MkPair(bAst, bTy) => {
              match rest_res {
                case MkPair(restAst, _) => {
                  Pair.MkPair(list_insert_first(restAst, Pair.MkPair(pat_ast_res, bAst)), bTy)
                }
              }
            }
          }
        } else rest_res
      };
      case _ => rest_res
    }
  }
};
def elab_tuple_elems(env: List(Pair), es: List(CST)): Pair = {
  if int_eq(list_length(es), 0) then Pair.MkPair(list_empty[AST](), AST.AstRef("Unit")) else {
    let e = list_get(es, 0);
    let eAst_res = elaborate(env, e, OptionAST.NoneAST);
    match eAst_res {
      case MkPair(eAst, _) => {
        let rest_res = elab_tuple_elems(env, advance(es));
        match rest_res {
          case MkPair(restAst, _) => {
            Pair.MkPair(list_insert_first(restAst, eAst), AST.AstRef("Tuple"))
          }
        }
      }
    }
  }
};
def get_base_type(t: AST): AST = {
  match t {
    case AstSpan(_, inner) => get_base_type(inner);
    case AstApp(f, _) => get_base_type(f);
    case AstImplicitApp(f, _) => get_base_type(f);
    case _ => t
  }
};
def check_type_match(target: AST, actual: AST): Bool = {
  let bt1 = get_base_type(target);
  let bt2 = get_base_type(actual);
  match bt1 {
    case AstRef(n1) => {
      match bt2 {
        case AstRef(n2) => string_eq(n1, n2);
        case _ => false
      }
    };
    case _ => false
  }
};
def lookup_ext_method(field: String, meths: List(ExtMethod)): String = {
  if int_eq(list_length(meths), 0) then "" else {
    let m = list_get(meths, 0);
    match m {
      case MkExtMethod(n, full) => {
        if string_eq(n, field) then full else lookup_ext_method(field, advance(meths))
      }
    }
  }
};
def find_ext_method(ty: AST, field: String, exts: List(ExtDecl)): String = {
  // Match Rocq: only typed lookup (no any-name fallback that picks StringOps for List).
  find_ext_method_typed(ty, field, exts)
};
def find_ext_method_typed(ty: AST, field: String, exts: List(ExtDecl)): String = {
  if int_eq(list_length(exts), 0) then "" else {
    let ext = list_get(exts, 0);
    match ext {
      case MkExtDecl(_, target_ty, meths) => {
        if check_type_match(target_ty, ty) then {
          let meth_name = lookup_ext_method(field, meths);
          if string_eq(meth_name, "") then find_ext_method_typed(ty, field, advance(exts)) else meth_name
        } else find_ext_method_typed(ty, field, advance(exts))
      }
    }
  }
};
def find_ext_method_any(field: String, exts: List(ExtDecl)): String = {
  if int_eq(list_length(exts), 0) then "" else {
    let ext = list_get(exts, 0);
    match ext {
      case MkExtDecl(_, _, meths) => {
        let meth_name = lookup_ext_method(field, meths);
        if string_eq(meth_name, "") then find_ext_method_any(field, advance(exts)) else meth_name
      }
    }
  }
};
def extract_ext_methods(meths: List(CST), ext_name: String): List(ExtMethod) = {
  if int_eq(list_length(meths), 0) then list_empty[ExtMethod]() else {
    let m = list_get(meths, 0);
    let rest = extract_ext_methods(advance(meths), ext_name);
    match m {
      case DefCST(n, _, _, _, _, _) => {
        let full = string_append(string_append(ext_name, "_"), n);
        list_insert_first(rest, ExtMethod.MkExtMethod(n, full))
      };
      case _ => rest
    }
  }
};
def elab_ext_methods(env: List(Pair), meths: List(CST), ext_name: String): List(AST) = {
  if int_eq(list_length(meths), 0) then list_empty[AST]() else {
    let m = list_get(meths, 0);
    let rest = elab_ext_methods(env, advance(meths), ext_name);
    match m {
      case DefCST(n, tps, ps, rt, b, sp) => {
        let full_name = string_append(string_append(ext_name, "_"), n);
        let mod_m = CST.DefCST(full_name, tps, ps, rt, b, sp);
        let res = elaborate(env, mod_m, OptionAST.NoneAST);
        match res {
          case MkPair(ast, _) => list_insert_first(rest, ast)
        }
};
      case _ => rest
    }
  }
};
def elab_stmt_list(env: List(Pair), xs: List(CST)): List(AST) = {
  if int_eq(list_length(xs), 0) then list_empty[AST]() else {
    let hd_res = elaborate(env, list_get(xs, 0), OptionAST.NoneAST);
    let tl = elab_stmt_list(env, advance(xs));
    match hd_res {
      case MkPair(ast, _) => list_insert_first(tl, ast)
    }
  }
};
def zonk_list(fuel: Integer, l: List(AST)): List(AST) = {
  if int_eq(list_length(l), 0) then list_empty[AST]() else {
    let hd = zonk(fuel, list_get(l, 0));
    let tl = zonk_list(fuel, advance(l));
    list_insert_first(tl, hd)
  }
};
def zonk(fuel: Integer, expr: AST): AST = {
  if int_eq(fuel, 0) then expr else {
    match expr {
      case AstMeta(m) => {
        let s = get_elab_state();
        match s {
          case MkElabState(_, _, subst, _, _, _, _) => {
            let v_opt = lookup_meta(m, subst);
            match v_opt {
              case SomeAST(v) => zonk(int_sub(fuel, 1), v);
              case OptionAST.NoneAST => expr
            }
          }
        }
      };
      case AstApp(f, args) => AST.AstApp(zonk(int_sub(fuel, 1), f), zonk_list(int_sub(fuel, 1), args));
      case AstPi(n, ty, ret, effs) => AST.AstPi(n, zonk(int_sub(fuel, 1), ty), zonk(int_sub(fuel, 1), ret), effs);
      case AstLam(n, ty, body) => AST.AstLam(n, zonk(int_sub(fuel, 1), ty), zonk(int_sub(fuel, 1), body));
      case AstBlock(stmts, tail) => AST.AstBlock(zonk_list(int_sub(fuel, 1), stmts), zonk(int_sub(fuel, 1), tail));
      case AstTuple(elems) => AST.AstTuple(zonk_list(int_sub(fuel, 1), elems));
      case AstLet(n, v) => AST.AstLet(n, zonk(int_sub(fuel, 1), v));
      case AstIf(c, t, e) => AST.AstIf(zonk(int_sub(fuel, 1), c), zonk(int_sub(fuel, 1), t), zonk(int_sub(fuel, 1), e));
      case _ => expr
    }
  }
};
def expand_signature_member(env: List(Pair), member: AST): AST = {
  match member {
    case AstModule(n, params, seal, refs) => {
      if int_eq(list_length(refs), 1) then {
        match list_get(refs, 0) {
          case AstRef(ref_name) => {
            match resolve_hygiene(env, ref_name, list_empty[Integer]()) {
              case MkPair(ty, _) => {
                match ty {
                  case AstSignature(_, ref_decls) => AST.AstModule(n, params, seal, ref_decls);
                  case _ => member
                }
              }
            }
          };
          case _ => member
        }
      } else member
    };
    case _ => member
  }
};
def modty_fake_sigval(pair: Pair): AST = {
  match pair {
    case MkPair(n, ty) => AST.AstSigVal(n, list_empty[String](), list_empty[Pair](), ty, list_empty[String]())
  }
};
def elaborate(env: List[Pair], expr: CST, expected: OptionAST): Pair = {
  match expr {
    case Symbol(name, span) => {
      let res = resolve_hygiene(env, name, span_context(span));
      match res {
        case MkPair(ty, resolved_ctx) => {
          match ty {
            case AstError(_) => {
              if is_allowed_unbound(name) then Pair.MkPair(AST.AstRef(name), AST.AstRef("Any"))
              else if is_type_expected(expected) then Pair.MkPair(AST.AstRef(name), AST.AstRef("Type"))
              else Pair.MkPair(AST.AstError(string_concat("Unbound variable: ", name)), AST.AstRef("Any"))
            };
            case _ => {
              match expected {
                case SomeAST(exp) => {
                  unify_top(ty, exp);
                  Pair.MkPair(AST.AstRef(mangle_name(name, resolved_ctx)), ty)
                };
                case OptionAST.NoneAST => Pair.MkPair(AST.AstRef(mangle_name(name, resolved_ctx)), ty)
              }
            }
          }
        }
      }
    };
    case StringLiteral(s, _) => {
      let str_ty = AST.AstRef("String");
      match expected {
        case SomeAST(exp) => {
          if unify_ok(str_ty, exp) then Pair.MkPair(AST.AstStringLit(s), str_ty)
          else Pair.MkPair(AST.AstError("Type mismatch"), str_ty)
        };
        case OptionAST.NoneAST => Pair.MkPair(AST.AstStringLit(s), str_ty)
      }
    };
    case IntegerLiteral(s, _) => {
      let int_ty = AST.AstRef("Int");
      match expected {
        case SomeAST(exp) => {
          if unify_ok(int_ty, exp) then Pair.MkPair(AST.AstIntLit(string_to_int(s)), int_ty)
          else Pair.MkPair(AST.AstError("Type mismatch"), int_ty)
        };
        case OptionAST.NoneAST => Pair.MkPair(AST.AstIntLit(string_to_int(s)), int_ty)
      }
    };
    case BoolLiteral(b, _) => {
      let bool_ty = AST.AstRef("Bool");
      match expected {
        case SomeAST(exp) => {
          if unify_ok(bool_ty, exp) then Pair.MkPair(AST.AstBoolLit(b), bool_ty)
          else Pair.MkPair(AST.AstError("Type mismatch"), bool_ty)
        };
        case OptionAST.NoneAST => Pair.MkPair(AST.AstBoolLit(b), bool_ty)
      }
    };
    case SeqOf(elems, _) => {
      if int_eq(list_length(elems), 0) then Pair.MkPair(AST.AstError("Empty SeqOf"), AST.AstRef("Any")) else {
        let f = list_get(elems, 0);
        let args = advance(elems);
        let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
        match funcAst_res {
          case MkPair(fAst, fTy) => {
            let args_res = elab_check_args(env, fTy, args);
            match args_res {
              case MkPair(argsAst, argsTy) => {
                charge_call_effs(fTy);
                match expected {
                  case SomeAST(exp) => unify_top(argsTy, exp);
                  case OptionAST.NoneAST => ()
                };
                Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
              }
            }
          }
        }
      }
};
    case Block(stmts, tail, _) => {
      let env_with_defs = append_env(collect_def_binders(stmts), env);
      let stmtsRes = map_elabs(env_with_defs, stmts);
      match stmtsRes {
        case MkPair(stmtsAst, final_env) => {
          let retAst_res = elaborate(final_env, tail, OptionAST.NoneAST);
          match retAst_res {
            case MkPair(rAst, rTy) => {
              Pair.MkPair(AST.AstBlock(stmtsAst, rAst), rTy)
            }
          }
        }
      }
    };
    case LetCST(name, value, next, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, vTy) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
          let bodyAst_res = elaborate(new_env, next, expected);
          match bodyAst_res {
            case MkPair(bAst, bTy) => {
              let stmts = list_insert_first(list_empty[AST](), AST.AstLet(mangle_name(name, span_context(span)), vAst));
              Pair.MkPair(AST.AstBlock(stmts, bAst), bTy)
            }
          }
        }
      }
    };
    case VarCST(name, value, next, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, vTy) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(name, span_context(span)), vTy));
          let bodyAst_res = elaborate(new_env, next, expected);
          match bodyAst_res {
            case MkPair(bAst, bTy) => {
              let stmts = list_insert_first(list_empty[AST](), AST.AstVar(mangle_name(name, span_context(span)), vAst));
              Pair.MkPair(AST.AstBlock(stmts, bAst), bTy)
            }
          }
        }
      }
    };
    case AssignCST(name, value, span) => {
      let valueAst_res = elaborate(env, value, OptionAST.NoneAST);
      match valueAst_res {
        case MkPair(vAst, _) => Pair.MkPair(AST.AstAssign(mangle_name(name, span_context(span)), vAst), AST.AstRef("Unit"))
      }
};
    case BoxCST(inner, _) => {
      let s0 = get_elab_state();
      match s0 {
        case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
          put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
          let inner_res = elaborate(env, inner, OptionAST.NoneAST);
          match inner_res {
            case MkPair(iAst, innerTy) => {
              let s1 = get_elab_state();
              match s1 {
                case MkElabState(e1, nv1, sub1, ex1, ef1, act1, caps) => {
                  put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, pend0));
                  let sealed = effects_covered_by(caps, act1);
                  if sealed then {
                    let box_ty = AST.AstPi("x", AST.AstRef("Unit"), innerTy, list_empty[String]());
                    Pair.MkPair(AST.AstBox(iAst, caps), box_ty)
                  } else Pair.MkPair(AST.AstError("Missing capability for box"), AST.AstRef("Any"))
                }
              }
            }
          }
        }
      }
    };
    case UnboxCST(inner, _) => {
      let inner_res = elaborate(env, inner, OptionAST.NoneAST);
      match inner_res {
        case MkPair(iAst, iTy) => {
          let caps = match iTy {
            case AstPi(_, _, _, effs) => effect_labels(effs);
            case AstFunTy(_, _, _, effs) => effect_labels(effs);
            case _ => list_empty[String]()
          };
          let s = get_elab_state();
          match s {
            case MkElabState(e, nv, sub, ex, ef, act, pending) => {
              put_elab_state(ElabState.MkElabState(e, nv, sub, ex, ef, act, merge_effects(pending, caps)));
              let ret_ty = match iTy {
                case AstPi(_, _, ret_ty, _) => ret_ty;
                case AstFunTy(_, _, ret_ty, _) => ret_ty;
                case _ => iTy
              };
              Pair.MkPair(AST.AstUnbox(iAst), ret_ty)
            }
          }
        }
      }
    };
    case IfCST(cond, thenB, elseB, _) => {
      // Guard must be Bool (mirrors CoreChecker's if-condition rule).
      let condAst_res = elaborate(env, cond, OptionAST.NoneAST);
      match condAst_res {
        case MkPair(cAst, cTy) => {
          let cond_ast = if ty_is_definitely_not_bool(cTy) then AST.AstError("If condition is not Bool") else cAst;
          let thenAst_res = elaborate(env, thenB, expected);
          match thenAst_res {
            case MkPair(tAst, tTy) => {
              let elseAst_res = elaborate(env, elseB, expected);
              match elseAst_res {
                case MkPair(eAst, _) => {
                  Pair.MkPair(AST.AstIf(cond_ast, tAst, eAst), tTy)
                }
              }
            }
          }
        }
      }
    };
    case DefCST(name, type_params, params, ret_ty, body, span) => {
      let params_res = elab_map_params(env, params);
      match params_res {
        case MkPair(paramsAst, envItems) => {
          match peel_effect_row_cst(ret_ty) {
            case MkPair(ret_cst, decl_effs) => {
              let retAst_res = elaborate(env, ret_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
              match retAst_res {
                case MkPair(rAst, _) => {
                  let fun_ty0 = AST.AstFunTy(type_params, paramsAst, rAst, decl_effs);
                  let body_env = list_insert_first(append_env(envItems, env), Pair.MkPair(Pair.MkPair(name, span_context(span)), fun_ty0));
                  let s0 = get_elab_state();
                  match s0 {
                    case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
                      put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
                      let bodyAst_res = elaborate(body_env, body, OptionAST.SomeAST(rAst));
                      match bodyAst_res {
                        case MkPair(bAst, _) => {
                          let s1 = get_elab_state();
                          match s1 {
                            case MkElabState(e1, nv1, sub1, ex1, ef1, act1, body_effs) => {
                              let open_effs = with_open_row(body_effs);
                              let recursive = free_in(name, bAst);
                              let total = check_terminates(name, param_names(paramsAst), bAst);
                              let needs_div = bool_and(recursive, bool_not(total));
                              if int_eq(list_length(decl_effs), 0) then {
                                // Unannotated: open-infer; charge body effects to pending.
                                let effs = if needs_div then add_effect("div", open_effs) else open_effs;
                                put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, merge_effects(pend0, body_effs)));
                                let fun_ty = AST.AstFunTy(type_params, paramsAst, rAst, effs);
                                Pair.MkPair(AST.AstDef(name, type_params, paramsAst, rAst, bAst, effs), fun_ty)
                              } else {
                                // Annotated closed row: latent on FunTy only.
                                put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, pend0));
                                if bool_and(needs_div, bool_not(string_in_list("div", decl_effs))) then {
                                  Pair.MkPair(AST.AstError(string_concat("Termination check failed: recursive function must declare div: ", name)), AST.AstRef("Any"))
                                } else if effect_row_subsumes(body_effs, decl_effs) then {
                                  let fun_ty = AST.AstFunTy(type_params, paramsAst, rAst, decl_effs);
                                  Pair.MkPair(AST.AstDef(name, type_params, paramsAst, rAst, bAst, decl_effs), fun_ty)
                                } else Pair.MkPair(AST.AstError(string_concat("effect row too large for declared annotation on: ", name)), AST.AstRef("Any"))
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    case LamCST(arg_name, opt_arg_ty, body, span) => {
      let argTyAst_res = match opt_arg_ty {
        case Error(_, _) => {
          let m = fresh_meta();
          Pair.MkPair(m, AST.AstRef("TypeUniverse"))
        };
        case _ => elaborate(env, opt_arg_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")))
      };
      match argTyAst_res {
        case MkPair(argTyAst, _) => {
          let new_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(arg_name, span_context(span)), argTyAst));
          if is_type_expected(expected) then {
            let bodyAst_res = elaborate(new_env, body, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
            match bodyAst_res {
              case MkPair(bAst, _) => {
                let piTy = AST.AstPi(arg_name, argTyAst, bAst, list_empty[String]());
                Pair.MkPair(piTy, AST.AstRef("Type"))
              }
            }
          } else {
          let s0 = get_elab_state();
          match s0 {
            case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
              put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, act0, list_empty[String]()));
              let bodyAst_res = elaborate(new_env, body, OptionAST.NoneAST);
              match bodyAst_res {
                case MkPair(bAst, bTy) => {
                  let s1 = get_elab_state();
                  match s1 {
                    case MkElabState(e1, nv1, sub1, ex1, ef1, act1, body_effs) => {
                      // Latent effects on the Pi only — not performed at lambda creation.
                      let open_effs = with_open_row(body_effs);
                      put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act1, pend0));
                      let arrTy = AST.AstPi(arg_name, argTyAst, bTy, open_effs);
                      Pair.MkPair(AST.AstLam(mangle_name(arg_name, span_context(span)), argTyAst, bAst), arrTy)
                    }
                  }
                }
              }
            }
          }
          }
        }
      }
    };
    case AppCST(f, args, span) => {
      match f {
        case FieldAccess(expr, field, fsp) => {
          let exprAst_res = elaborate(env, expr, OptionAST.NoneAST);
          match exprAst_res {
            case MkPair(eAst, eTy) => {
              match eTy {
                case AstModTy(exports) => {
                  let ty0 = lookup_export(exports, field);
                  match ty0 {
                    case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                    case _ => {
                      charge_call_effs(ty0);
                      let args_res = elab_check_args(env, ty0, args);
                      match args_res {
                        case MkPair(argsAst, argsTy) => {
                          match expected {
                            case SomeAST(exp) => unify_top(argsTy, exp);
                            case OptionAST.NoneAST => ()
                          };
                          Pair.MkPair(AST.AstApp(AST.AstFieldAccess(eAst, field), argsAst), argsTy)
                        }
                      }
                    }
                  }
                };
                case _ => {
                  let state = get_elab_state();
                  let full_name = match state {
                    case MkElabState(_, _, _, exts, _, _, _) => find_ext_method(eTy, field, exts)
                  };
                  if string_eq(full_name, "") then {
                    let funcAst = AST.AstFieldAccess(eAst, field);
                    let args_res = elab_check_args(env, AST.AstRef("Any"), args);
                    match args_res {
                      case MkPair(argsAst, argsTy) => Pair.MkPair(AST.AstApp(funcAst, argsAst), argsTy)
                    }
                  } else {
                    let new_cst = AppCST(Symbol(full_name, fsp), list_insert_first(args, expr), span);
                    elaborate(env, new_cst, expected)
                  }
                }
              }
            }
          }
        };
        case ImplicitAppCST(inner_func, targs, _) => {
          // Match Rocq: erase [A,B] telescope; keep only the inner function in the App.
          let funcAst_res = elaborate(env, inner_func, OptionAST.NoneAST);
          match funcAst_res {
            case MkPair(fAst, fTy) => {
              let _targsAst = elab_check_targs(env, targs);
              let args_res = elab_check_args(env, fTy, args);
              match args_res {
                case MkPair(argsAst, argsTy) => {
                  charge_call_effs(fTy);
                  match expected {
                    case SomeAST(exp) => unify_top(argsTy, exp);
                    case OptionAST.NoneAST => ()
                  };
                  Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
                }
              }
            }
          }
        };
        case _ => {
          let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
          match funcAst_res {
            case MkPair(fAst, fTy) => {
              let args_res = elab_check_args(env, fTy, args);
              match args_res {
                case MkPair(argsAst, argsTy) => {
                  charge_call_effs(fTy);
                  match expected {
                    case SomeAST(exp) => unify_top(argsTy, exp);
                    case OptionAST.NoneAST => ()
                  };
                  Pair.MkPair(AST.AstApp(fAst, argsAst), argsTy)
                }
              }
            }
          }
        }
      }
    };
    case ImplicitAppCST(f, targs, _) => {
      // Standalone implicit application f[A,B] — used in type position only
      let funcAst_res = elaborate(env, f, OptionAST.NoneAST);
      match funcAst_res {
        case MkPair(fAst, _) => {
          let targsAst_res = elab_check_targs(env, targs);
          Pair.MkPair(AST.AstImplicitApp(fAst, targsAst_res), AST.AstRef("TypeUniverse"))
        }
      }
    };
    case EnumCST(name, type_params, variants, _) => {
      let vs = elab_variants(variants);
      Pair.MkPair(AST.AstEnum(name, type_params, vs), AST.AstRef("Unit"))
    };
    case MatchCST(expr, cases, _) => {
      let exprAst_res = elaborate(env, expr, OptionAST.NoneAST);
      match exprAst_res {
        case MkPair(eAst, eTy) => {
          let cases_res = elab_cases(env, expected, cases, eTy);
          match cases_res {
            case MkPair(cAsts, cTy) => {
              Pair.MkPair(AST.AstMatch(eAst, cAsts), cTy)
            }
          }
        }
      }
    };
    case Tuple(elems, _) => {
      let res = elab_tuple_elems(env, elems);
      match res {
        case MkPair(asts, ty) => Pair.MkPair(AST.AstTuple(asts), ty)
      }
};
    case ListLiteral(elems, _) => {
      let res = elab_tuple_elems(env, elems);
      match res {
        case MkPair(asts, _) => Pair.MkPair(AST.AstTuple(asts), AST.AstRef("List"))
      }
};
    case RecordCST(name, type_params, fields, _) => {
      Pair.MkPair(AST.AstRecord(name, type_params, elab_record_fields(env, fields)), AST.AstRef("Unit"))
    };
    case FieldAccess(expr, field, _) => {
      let eAst_res = elaborate(env, expr, OptionAST.NoneAST);
      match eAst_res {
        case MkPair(eAst, eTy) => {
          match eTy {
            case AstModTy(exports) => {
              let ty = lookup_export(exports, field);
              match ty {
                case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                case AstTypeDecl(_, defs) => {
                  if is_type_expected(expected) then {
                    if int_eq(list_length(defs), 0) then Pair.MkPair(AST.AstRef(field), AST.AstRef("TypeUniverse"))
                    else Pair.MkPair(list_get(defs, 0), AST.AstRef("TypeUniverse"))
                  } else Pair.MkPair(AST.AstError(string_concat("type component used as value: ", field)), AST.AstRef("Any"))
                };
                case _ => {
                  if is_type_expected(expected) then Pair.MkPair(AST.AstRef(field), AST.AstRef("TypeUniverse"))
                  else Pair.MkPair(AST.AstFieldAccess(eAst, field), ty)
                }
              }
            };
            case _ => {
              if is_type_expected(expected) then Pair.MkPair(AST.AstRef(field), AST.AstRef("TypeUniverse"))
              else Pair.MkPair(AST.AstFieldAccess(eAst, field), AST.AstRef("Any"))
            }
          }
        }
      }
};
    case ExtensionCST(ext_name, tparams, target_ty, meths, _) => {
      let targetTy_res = elaborate(env, target_ty, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
      match targetTy_res {
        case MkPair(tAst, _) => {
          let state = get_elab_state();
          match state {
            case MkElabState(e, next_var, subst, exts, effects, active, pending) => {
              let ext_meths = extract_ext_methods(meths, ext_name);
              let new_ext = ExtDecl.MkExtDecl(ext_name, tAst, ext_meths);
              put_elab_state(ElabState.MkElabState(e, next_var, subst, list_insert_first(exts, new_ext), effects, active, pending));
              let meths_res = elab_ext_methods(env, meths, ext_name);
              Pair.MkPair(AST.AstExtension(ext_name, tparams, tAst, meths_res), AST.AstRef("Unit"))
            }
          }
        }
      }
    };
    case Error(msg, _) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
    case Comment(_, _) => Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"));
    case MacroDefCST(_, _, _) => Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"));
    case ImportCST(lang, alias, mod_path, syms, _) => {
      Pair.MkPair(AST.AstImport(lang, alias, mod_path, syms), AST.AstRef("Unit"))
    };
    case ExternCST(lang, mod_path, decls, _) => {
      let ext_res = elab_extern_decls(env, decls);
      match ext_res {
        case MkPair(syms, _) => Pair.MkPair(AST.AstImport(lang, "", mod_path, syms), AST.AstRef("Unit"))
      }
    };
    case EffectCST(name, _, decls, _) => {

      let ops = elab_ops(env, decls);
      let s = get_elab_state();
      match s {
        case MkElabState(e, next_var, subst, exts, effects, active, pending) => {
          put_elab_state(ElabState.MkElabState(e, next_var, subst, exts, list_insert_first(effects, EffectDecl.MkEffectDecl(name, ops)), active, pending));
          Pair.MkPair(AST.AstRef("Unit"), AST.AstRef("Unit"))
        }
      }
    };
    case DoCST(op, args, _) => {
      let op_name = match op {
        case Symbol(n, _) => n;
        case _ => ""
      };

      let s = get_elab_state();
      match s {
        case MkElabState(e, next_var, subst, exts, effects, active, pending) => {

          match find_op(op_name, effects) {
            case MkPair(eff, ret_ty) => {
              if string_eq(eff, "") then Pair.MkPair(AST.AstError(string_concat("Unknown effect operation: ", op_name)), AST.AstRef("Any")) else {
                put_elab_state(ElabState.MkElabState(e, next_var, subst, exts, effects, active, list_insert_first(pending, eff)));
                Pair.MkPair(AST.AstDo(AST.AstRef(string_concat(eff, string_concat("/", op_name))), elab_args(env, args)), ret_ty)
              }
}
          }
        }
      }
    };
    case HandleCST(body, eff, shallow, multishot, handlers, _) => {
      if string_eq(eff, "io") then Pair.MkPair(AST.AstError("io is not a user-handleable effect"), AST.AstRef("Any")) else {
      let s0 = get_elab_state();
      match s0 {
        case MkElabState(e0, nv0, sub0, ex0, ef0, act0, pend0) => {
          put_elab_state(ElabState.MkElabState(e0, nv0, sub0, ex0, ef0, list_insert_first(act0, eff), list_empty[String]()));
          let body_elab = elaborate(env, body, OptionAST.NoneAST);
          let s1 = get_elab_state();
          match s1 {
            case MkElabState(e1, nv1, sub1, ex1, ef1, _, pend1) => {
              put_elab_state(ElabState.MkElabState(e1, nv1, sub1, ex1, ef1, act0, merge_pending(pend0, filter_pending(eff, pend1))));
              match body_elab {
                case MkPair(body_ast, body_ty) => {
                  let ret_c = find_return_clause(handlers);
                  let op_cs = drop_return_clauses(handlers);
                  // Plotkin-style return: elaborate under binder typed as body_ty; answer is clause type.
                  let ret_elab = match ret_c {
                    case Error(_, _) => Pair.MkPair(AST.AstRef("Unit"), body_ty);
                    case SeqOf(elems, _) => {
                      let body_c = list_get(elems, int_sub(list_length(elems), 1));
                      let x = "x";
                      let henv = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, list_empty[Integer]()), body_ty));
                      match elaborate(henv, body_c, OptionAST.NoneAST) {
                        case MkPair(h_ast, h_ty) => Pair.MkPair(AST.AstLam(x, body_ty, h_ast), h_ty)
                      }
                    };
                    case _ => Pair.MkPair(AST.AstRef("Unit"), body_ty)
                  };
                  match ret_elab {
                    case MkPair(ret_fn, answer_ty) => {
                      let hsOps = elab_hs(env, op_cs, answer_ty);
                      let hsRet = match ret_c {
                        case Error(_, _) => hsOps;
                        case _ => list_insert_first(hsOps, Pair.MkPair("return", ret_fn))
                      };
                      let hs1 = if shallow then list_insert_first(hsRet, Pair.MkPair("__chester_shallow__", AST.AstBoolLit(true))) else hsRet;
                      let hs = if multishot then list_insert_first(hs1, Pair.MkPair("__chester_multishot__", AST.AstBoolLit(true))) else hs1;
                      let msg = check_handler_complete(eff, lookup_effect_ops(eff, ef1), hs);
                      if string_eq(msg, "ok") then Pair.MkPair(AST.AstHandle(body_ast, eff, hs), answer_ty)
                      else Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"))
                    }
                  }
                }
              }
            }
          }
        }
      }
      }
    };
    case SigValCST(name, type_params, params, ret_ty, _) => {
      let paramsAst = elab_named_cst_params(env, params);
      match peel_effect_row_cst(ret_ty) {
        case MkPair(ret_cst, decl_effs) => {
          let retAst_res = elaborate(env, ret_cst, OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
          match retAst_res {
            case MkPair(rAst, _) =>
              Pair.MkPair(AST.AstSigVal(name, type_params, paramsAst, rAst, decl_effs), AST.AstRef("Unit"))
          }
        }
      }
    };
    case TypeDeclCST(name, def, _) => {
      if int_eq(list_length(def), 0) then Pair.MkPair(AST.AstTypeDecl(name, list_empty[AST]()), AST.AstRef("TypeUniverse")) else {
        let ty_res = elaborate(env, list_get(def, 0), OptionAST.SomeAST(AST.AstRef("TypeUniverse")));
        match ty_res {
          case MkPair(tAst, _) =>
            Pair.MkPair(AST.AstTypeDecl(name, list_insert_first(list_empty[AST](), tAst)), AST.AstRef("TypeUniverse"))
        }
      }
    };
    case ModuleCST(name, params, seal, body, _) => {
      // Slice: body exports + name/effect sealing. Not F-ing stamps / Fω.
      let fparams_res = elab_module_params(env, params);
      let params_ast = match fparams_res { case MkPair(psA, _) => psA };
      let body_env = match fparams_res { case MkPair(_, e) => e };
      let body_asts = elab_stmt_list(body_env, body);
      let full_ex = module_exports_of(body_asts);
      if int_eq(list_length(seal), 0) then {
        let mod_ty = if int_eq(list_length(params), 0) then AST.AstModTy(full_ex) else AST.AstModule(name, params_ast, list_empty[AST](), body_asts);
        Pair.MkPair(AST.AstModule(name, params_ast, list_empty[AST](), body_asts), mod_ty)
      } else {
        let seal0 = list_get(seal, 0);
        match seal0 {
          case Symbol("#applicative", _) => {
            let seal_asts = list_insert_first(list_empty[AST](), AST.AstRef("#applicative"));
            Pair.MkPair(AST.AstModule(name, params_ast, seal_asts, body_asts), AST.AstModule(name, params_ast, seal_asts, body_asts))
          };
          case AppCST(f, inners, _) => {
            match f {
              case Symbol(tag, _) => {
                let opaque = string_eq(tag, "#opaque");
                let transparent = string_eq(tag, "#transparent");
                if bool_or(opaque, transparent) then {
                  if int_eq(list_length(inners), 0) then Pair.MkPair(AST.AstError("seal missing signature"), AST.AstRef("Any")) else {
                    let s_res = elaborate(env, list_get(inners, 0), OptionAST.NoneAST);
                    match s_res {
                      case MkPair(sAst, sTy) => {
                        let seal_node = AST.AstApp(AST.AstRef(tag), list_insert_first(list_empty[AST](), sAst));
                        match apply_sig_seal(opaque, full_ex, body_asts, sTy, seal_node) {
                          case MkPair(mod_ty, rest) => {
                            match rest {
                              case MkPair(s_node, body2) => {
                                match mod_ty {
                                  case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                                  case _ => {
                                    let seal_asts = list_insert_first(list_empty[AST](), s_node);
                                    let out_ty = if int_eq(list_length(params), 0) then mod_ty else AST.AstModule(name, params_ast, seal_asts, body2);
                                    Pair.MkPair(AST.AstModule(name, params_ast, seal_asts, body2), out_ty)
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                } else {
                  let s_res = elaborate(env, seal0, OptionAST.NoneAST);
                  match s_res {
                    case MkPair(sAst, sTy) => {
                      match apply_sig_seal(true, full_ex, body_asts, sTy, sAst) {
                        case MkPair(mod_ty, rest) => {
                          match rest {
                            case MkPair(s_node, body2) => {
                              match mod_ty {
                                case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                                case _ => {
                                  let seal_asts = list_insert_first(list_empty[AST](), s_node);
                                  let out_ty = if int_eq(list_length(params), 0) then mod_ty else AST.AstModule(name, params_ast, seal_asts, body2);
                                  Pair.MkPair(AST.AstModule(name, params_ast, seal_asts, body2), out_ty)
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              };
              case _ => {
                let s_res = elaborate(env, seal0, OptionAST.NoneAST);
                match s_res {
                  case MkPair(sAst, sTy) => {
                    match apply_sig_seal(true, full_ex, body_asts, sTy, sAst) {
                      case MkPair(mod_ty, rest) => {
                        match rest {
                          case MkPair(s_node, body2) => {
                            match mod_ty {
                              case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                              case _ => {
                                let seal_asts = list_insert_first(list_empty[AST](), s_node);
                                let out_ty = if int_eq(list_length(params), 0) then mod_ty else AST.AstModule(name, params_ast, seal_asts, body2);
                                Pair.MkPair(AST.AstModule(name, params_ast, seal_asts, body2), out_ty)
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          };
          case _ => {
            let s_res = elaborate(env, seal0, OptionAST.NoneAST);
            match s_res {
              case MkPair(sAst, sTy) => {
                match apply_sig_seal(true, full_ex, body_asts, sTy, sAst) {
                  case MkPair(mod_ty, rest) => {
                    match rest {
                      case MkPair(s_node, body2) => {
                        match mod_ty {
                          case AstError(msg) => Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"));
                          case _ => {
                            let seal_asts = list_insert_first(list_empty[AST](), s_node);
                            let out_ty = if int_eq(list_length(params), 0) then mod_ty else AST.AstModule(name, params_ast, seal_asts, body2);
                            Pair.MkPair(AST.AstModule(name, params_ast, seal_asts, body2), out_ty)
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    case SignatureCST(name, body, _) => {
      let decls0 = elab_stmt_list(env, body);
      // signature Alias = Base with type … → single AstSigWith; store enriched decls.
      let decls = if int_eq(list_length(decls0), 1) then {
        match list_get(decls0, 0) {
          case AstSigWith(base, eqs) => {
            match apply_sig_with(base, eqs) {
              case AstSignature(_, ds) => flatten_sig_decls(sig_decls_fuel(ds), ds);
              case _ => decls0
            }
          };
          case _ => decls0
        }
      } else decls0;
      let decls2 = list_map(decls, \member => expand_signature_member(env, member));
      Pair.MkPair(AST.AstSignature(name, decls2), AST.AstSignature(name, decls2))
    };
    case SigWithCST(base, eqs, _) => {
      match elaborate(env, base, OptionAST.NoneAST) {
        case MkPair(baseAst, baseTy) => {
          let eqsAst = elab_sig_with_eqs(env, eqs);
          let sig_view = match strip_span(baseTy) {
            case AstSigWith(b, eqs0) => apply_sig_with(b, eqs0);
            case other => other
          };
          let flat_decls = match sig_view {
            case AstSignature(_, decls) => flatten_sig_decls(sig_decls_fuel(decls), decls);
            case _ => list_empty[AST]()
          };
          let names = sig_type_component_names(flat_decls);
          let msg = check_with_eq_names(eqsAst, names);
          if string_eq(msg, "ok") then {
            let base_for_with = match strip_span(baseTy) {
              case AstSignature(_, _) => sig_view;
              case AstSigWith(_, _) => sig_view;
              case _ => baseAst
            };
            let with_ast = AST.AstSigWith(base_for_with, eqsAst);
            let enriched = apply_sig_with(base_for_with, eqsAst);
            Pair.MkPair(with_ast, enriched)
          } else Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"))
        }
      }
    };
    case ModuleAliasCST(name, rhs, _) => {
      let rhs_res = elaborate(env, rhs, OptionAST.NoneAST);
      match rhs_res {
        case MkPair(rAst, rTy) => {
          let body = match rAst {
            case AstModule(_, _, _, b) => b;
            case _ => list_insert_first(list_empty[AST](), rAst)
          };
          Pair.MkPair(AST.AstModule(name, list_empty[Pair](), list_empty[AST](), body), rTy)
        }
      }
    };
    case PackCST(m, s, _) => {
      let m_res = elaborate(env, m, OptionAST.NoneAST);
      let s_res = elaborate(env, s, OptionAST.NoneAST);
      match m_res {
        case MkPair(mAst, mTy) => {
          match s_res {
            case MkPair(sAst, sTy) => {
              let mex = match strip_span(mTy) {
                case AstModTy(ex) => ex;
                case AstModule(_, _, _, body) => module_exports_of(body);
                case _ => module_exports_of(list_insert_first(list_empty[AST](), mAst))
              };
              let sig_view = match strip_span(sTy) {
                case AstSigWith(base, eqs) => apply_sig_with(base, eqs);
                case other => other
              };
              match sig_view {
                case AstSignature(_, decls) => {
                  match seal_exports_check(true, mex, decls) {
                    case MkPair(msg, sealed) => {
                      if string_eq(msg, "ok") then Pair.MkPair(AST.AstPack(mAst, sAst), AST.AstModTy(sealed))
                      else Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"))
                    }
                  }
                };
                case AstModTy(ex) => Pair.MkPair(AST.AstPack(mAst, sAst), AST.AstModTy(ex));
                case _ => Pair.MkPair(AST.AstPack(mAst, sAst), sTy)
              }
            }
          }
        }
      }
    };
    case UnpackCST(x, sig, e, body, span) => {
      match elaborate(env, sig, OptionAST.NoneAST) {
        case MkPair(sigAst, sigTy) => {
          match elaborate(env, e, OptionAST.NoneAST) {
            case MkPair(eAst, eTy) => {
              let sig_view = match strip_span(sigTy) {
                case AstSigWith(base, eqs) => apply_sig_with(base, eqs);
                case other => other
              };
              match sig_view {
                case AstSignature(_, decls) => {
                  match strip_span(eTy) {
                    case AstModTy(ex) => {
                      match seal_exports_check(true, ex, decls) {
                        case MkPair(msg, sealed) => {
                          if string_eq(msg, "ok") then {
                            let modty = AST.AstModTy(sealed);
                            let body_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, span_context(span)), modty));
                            match elaborate(body_env, body, expected) {
                              case MkPair(bAst, bTy) => wrap_unpack(x, sigAst, eAst, bAst, bTy)
                            }
                          } else Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"))
                        }
                      }
                    };
                    case other => {
                      let expected_mod = AST.AstModTy(module_exports_of(decls));
                      if types_compat(other, expected_mod) then {
                        let body_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, span_context(span)), expected_mod));
                        match elaborate(body_env, body, expected) {
                          case MkPair(bAst, bTy) => wrap_unpack(x, sigAst, eAst, bAst, bTy)
                        }
                      } else Pair.MkPair(AST.AstError("unpack value does not match signature"), AST.AstRef("Any"))
                    }
                  }
                };
                case AstModTy(ex) => {
                  let body_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, span_context(span)), AST.AstModTy(ex)));
                  match elaborate(body_env, body, expected) {
                    case MkPair(bAst, bTy) => wrap_unpack(x, sigAst, eAst, bAst, bTy)
                  }
                };
                case _ => {
                  let body_env = list_insert_first(env, Pair.MkPair(Pair.MkPair(x, span_context(span)), AST.AstModTy(list_empty[Pair]())));
                  match elaborate(body_env, body, expected) {
                    case MkPair(bAst, bTy) => wrap_unpack(x, sigAst, eAst, bAst, bTy)
                  }
                }
              }
            }
          }
        }
      }
    };
    case FunctorAppCST(f, args, _) => {
      match elaborate(env, f, OptionAST.NoneAST) {
        case MkPair(fAst, fTy) => {
          match elab_functor_args(env, args) {
            case MkPair(args_asts, args_tys) => {
              match fTy {
                case AstModule(fname, fparams, seal, body) => {
                  if int_eq(list_length(fparams), 0) then
                    Pair.MkPair(AST.AstFunctorApp(fAst, args_asts), AST.AstModTy(module_exports_of(body)))
                  else {
                    let msg = check_functor_args(env, fparams, args_tys);
                    if string_eq(msg, "ok") then {
                      let is_app = seal_is_applicative(seal);
                      let arg_name = if int_eq(list_length(args_asts), 0) then "Arg" else {
                        match list_get(args_asts, 0) {
                          case AstModule(an, _, _, _) => an;
                          case AstRef(an) => an;
                          case _ => "Arg"
                        }
                      };
                      let pref = if is_app then string_concat(fname, string_concat("__", arg_name)) else {
                        let s = get_elab_state();
                        match s {
                          case MkElabState(e, nv, sub, ex, ef, act, pending) => {
                            put_elab_state(ElabState.MkElabState(e, int_add(nv, 1), sub, ex, ef, act, pending));
                            string_concat(fname, string_concat("_g", int_to_string(nv)))
                          }
                        }
                      };
                      let ex0 = subst_exports_params(fparams, args_asts, module_exports_of(body));
                      let out_ty = functor_app_result_ty(seal, body, ex0);
                      match out_ty {
                        case AstError(err) => Pair.MkPair(AST.AstError(err), AST.AstRef("Any"));
                        case _ => Pair.MkPair(AST.AstModule(pref, list_empty[Pair](), seal, body), out_ty)
                      }
                    } else Pair.MkPair(AST.AstError(msg), AST.AstRef("Any"))
                  }
                };
                case AstModTy(_) => Pair.MkPair(AST.AstFunctorApp(fAst, args_asts), AST.AstModTy(list_empty[Pair]()));
                case _ => Pair.MkPair(AST.AstFunctorApp(fAst, args_asts), AST.AstModTy(list_empty[Pair]()))
              }
            }
          }
        }
      }
    };
    case _ => Pair.MkPair(AST.AstError("Unsupported CST in self-hosted elaborator"), AST.AstRef("Any"))
  }
};
def check_pending(ps: List(String), res: Pair): Pair = {
  if int_eq(list_length(ps), 0) then res else {
    let e = list_get(ps, 0);
    // div = termination classifier; io = ambient top-level capability (not handleable).
    if bool_or(is_row_var(e), bool_or(string_eq(e, "div"), string_eq(e, "io"))) then check_pending(advance(ps), res) else {
      Pair.MkPair(AST.AstError(string_concat("Unhandled effect: ", e)), AST.AstRef("Any"))
    }
}
};
def elaborate_top(env: List(Pair), expr: CST, expected: OptionAST): Pair = {
  let res = elaborate(env, expr, expected);
  let s = get_elab_state();
  match s {
    case MkElabState(_, _, _, _, _, _, pending) => check_pending(pending, res)
  }
};
