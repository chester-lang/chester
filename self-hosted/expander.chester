def get_body(idx: Integer, acc: List(CST), clen: Integer, celems: List(CST)): List(CST) = {
  // Stop at the next `case` so missing semicolons between arms do not swallow later cases.
  if int_eq(idx, clen) then list_reverse(acc) else {
    let tok = list_get(celems, idx);
    match tok {
      case Symbol(s, _) => {
        if string_eq(s, "case") then list_reverse(acc)
        else get_body(int_add(idx, 1), list_insert_first(acc, tok), clen, celems)
      };
      case _ => get_body(int_add(idx, 1), list_insert_first(acc, tok), clen, celems)
    }
  }
};
def expand_if_get_rest(idx: Integer, acc: List(CST), len: Integer, elems: List(CST)): List(CST) = {
                          if int_eq(idx, len) then list_reverse(acc) else expand_if_get_rest(int_add(idx, 1), list_insert_first(acc, list_get(elems, idx)), len, elems)
                        };
def extract_cases(cs: List(CST)): List(CST) = {
                  if int_eq(list_length(cs), 0) then list_empty[CST]() else {
                    let c = list_get(cs, 0);
                    let rest_cs = advance(cs);
                    let rest_extracted = extract_cases(rest_cs);
                    match c {
                      case SeqOf(celems, csp) => {
                        let clen = list_length(celems);
                        if int_lt(clen, 4) then rest_extracted else {
                          let ctok0 = list_get(celems, 0);
                          match ctok0 {
                            case Symbol(csym, _) => {
                              if string_eq(csym, "case") then {
                                let ctok1 = list_get(celems, 1);
                                match ctok1 {
                                  case Symbol(psym, _) => {
                                    if string_eq(psym, "_") then {
                                      let ctok2 = list_get(celems, 2);
                                      match ctok2 {
                                        case Symbol(arrsym, _) => {
                                          if string_eq(arrsym, "=>") then {
                                            let body_elems = get_body(3, list_empty[CST](), clen, celems);
                                            let body_cst = if int_eq(list_length(body_elems), 0) then Tuple(list_empty[CST](), csp) else if int_eq(list_length(body_elems), 1) then list_get(body_elems, 0) else SeqOf(body_elems, csp);
                                            let new_case = SeqOf(list_insert_first(list_insert_first(list_empty[CST](), body_cst), ctok1), csp);
                                            list_insert_first(rest_extracted, new_case)
                                          } else rest_extracted
                                        };
                                        case _ => rest_extracted
                                      }
                                    } else {
                                      // case var => body
                                      let ctok2 = list_get(celems, 2);
                                      match ctok2 {
                                        case Symbol(arrsym, _) => {
                                          if string_eq(arrsym, "=>") then {
                                            let body_elems = get_body(3, list_empty[CST](), clen, celems);
                                            let body_cst = if int_eq(list_length(body_elems), 0) then Tuple(list_empty[CST](), csp) else if int_eq(list_length(body_elems), 1) then list_get(body_elems, 0) else SeqOf(body_elems, csp);
                                            let new_case = SeqOf(list_insert_first(list_insert_first(list_empty[CST](), body_cst), ctok1), csp);
                                            list_insert_first(rest_extracted, new_case)
                                          } else rest_extracted
                                        };
                                        case _ => rest_extracted
                                      }
                                    }
                                  };
                                  case AppCST(_, _, _) => {
                                    let ctok2 = list_get(celems, 2);
                                    match ctok2 {
                                      case Symbol(arrsym, _) => {
                                        if string_eq(arrsym, "=>") then {
                                          let body_elems = get_body(3, list_empty[CST](), clen, celems);
                                          let body_cst = if int_eq(list_length(body_elems), 0) then Tuple(list_empty[CST](), csp) else if int_eq(list_length(body_elems), 1) then list_get(body_elems, 0) else SeqOf(body_elems, csp);
                                          let new_case = SeqOf(list_insert_first(list_insert_first(list_empty[CST](), body_cst), ctok1), csp);
                                          list_insert_first(rest_extracted, new_case)
                                        } else rest_extracted
                                      };
                                      case _ => rest_extracted
                                    }
                                  };
                                  // case Ctor.Variant => body  OR  case Ctor.Variant(args) => body
                                  case FieldAccess(_, _, _) => {
                                    let ctok2 = list_get(celems, 2);
                                    match ctok2 {
                                      case Symbol(arrsym, _) => {
                                        if string_eq(arrsym, "=>") then {
                                          let body_elems = get_body(3, list_empty[CST](), clen, celems);
                                          let body_cst = if int_eq(list_length(body_elems), 0) then Tuple(list_empty[CST](), csp) else if int_eq(list_length(body_elems), 1) then list_get(body_elems, 0) else SeqOf(body_elems, csp);
                                          let new_case = SeqOf(list_insert_first(list_insert_first(list_empty[CST](), body_cst), ctok1), csp);
                                          list_insert_first(rest_extracted, new_case)
                                        } else rest_extracted
                                      };
                                      case Tuple(_, _) => {
                                        // case Ctor.Variant(args) => body — elems: case, FieldAccess, Tuple, =>, body
                                        if int_lt(clen, 5) then rest_extracted else {
                                          let ctok3 = list_get(celems, 3);
                                          match ctok3 {
                                            case Symbol(arrsym, _) => {
                                              if string_eq(arrsym, "=>") then {
                                                let body_elems = get_body(4, list_empty[CST](), clen, celems);
                                                let body_cst = if int_eq(list_length(body_elems), 0) then Tuple(list_empty[CST](), csp) else if int_eq(list_length(body_elems), 1) then list_get(body_elems, 0) else SeqOf(body_elems, csp);
                                                // Keep FieldAccess + Tuple as App for elab_cases
                                                let pat = AppCST(ctok1, match ctok2 { case Tuple(args, _) => args; case _ => list_empty[CST]() }, csp);
                                                let new_case = SeqOf(list_insert_first(list_insert_first(list_empty[CST](), body_cst), pat), csp);
                                                list_insert_first(rest_extracted, new_case)
                                              } else rest_extracted
                                            };
                                            case _ => rest_extracted
                                          }
                                        }
                                      };
                                      case _ => rest_extracted
                                    }
                                  };
                                  case _ => rest_extracted
                                }
                              } else rest_extracted
                            };
                            case _ => rest_extracted
                          }
                        }
                      };
                      case _ => rest_extracted
                    }
                  }
                };
def methods_of_block_2(meths: List(CST), tail: CST, op_env: List(OpEnvEntry)): List(CST) = {
                                match tail {
                                  case Symbol(u, _) => {
                                    if string_eq(u, "Unit") then meths else list_append(meths, tail)
                                  };
                                  case _ => list_append(meths, tail)
                                }
                              };
def methods_of_block_1(b: CST, op_env: List(OpEnvEntry)): List(CST) = {
                  match b {
                    case Block(meths, tail, _) => {
                      match tail {
                        case Symbol(u, _) => {
                          if string_eq(u, "Unit") then meths else list_append(meths, tail)
                        };
                        case _ => list_append(meths, tail)
                      }
                    };
                    case _ => list_empty[CST]()
                  }
                };
def extract_import_syms_from_block(stmts: List(CST)): List(String) = {
  if int_eq(list_length(stmts), 0) then list_empty[String]() else {
    let s = list_get(stmts, 0);
    let rest = extract_import_syms_from_block(advance(stmts));
    match s {
      case Symbol(n, _) => list_insert_first(rest, n);
      case _ => rest
    }
  }
};
def extract_import_syms(rest: List(CST)): List(String) = {
  if int_eq(list_length(rest), 0) then list_empty[String]() else {
    match list_get(rest, 0) {
      case Block(syms, _, _) => extract_import_syms_from_block(syms);
      case _ => list_empty[String]()
    }
  }
};
// Drop the first n elements of a list (for leftover SeqOf elems after a form).
def list_drop_n(n: Integer, ls: List(CST)): List(CST) = {
  if int_eq(n, 0) then ls else {
    if int_eq(list_length(ls), 0) then list_empty[CST]() else list_drop_n(int_sub(n, 1), advance(ls))
  }
};
// When a keyword form is glued into one SeqOf with following stmts (no ';'),
// re-queue leftover elems as the next statement — mirrors Rocq keeping `stmt`.
def cont_with_leftover(elems: List(CST), consumed: Integer, sp: Span, rest_ss: List(CST)): List(CST) = {
  let leftover = list_drop_n(consumed, elems);
  if int_eq(list_length(leftover), 0) then rest_ss else {
    let node = if int_eq(list_length(leftover), 1) then list_get(leftover, 0) else SeqOf(leftover, sp);
    list_insert_first(rest_ss, node)
  }
};
def process_stmt_keep(fuel: Integer, env: List(MacroEnvEntry), op_env: List(OpEnvEntry), m: Integer, s: CST, rest_ss: List(CST)): ExpandResultList = {
  let res_s = expand_cst(fuel, env, op_env, m, s);
  match res_s {
    case Res(fst_cst, next_m) => {
      let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
      match res_rest {
        case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
      }
    }
  }
};
def extract_tparams(ts: List(CST)): List(String) = {
                  if int_eq(list_length(ts), 0) then list_empty[String]() else {
                    match list_get(ts, 0) {
                      case Symbol(v, _) => list_insert_first(extract_tparams(advance(ts)), v);
                      case _ => extract_tparams(advance(ts))
                    }
                  }
                };
def extract_targs(ts: List(CST)): List(String) = {
                              if int_eq(list_length(ts), 0) then list_empty[String]() else {
                                let t0 = list_get(ts, 0);
                                let rest = extract_targs(advance(ts));
                                match t0 {
                                  case Symbol(tn, _) => list_insert_first(rest, tn);
                                  case _ => list_insert_first(rest, "T")
                                }
                              }
                            };
def extract_params(as_list: List(CST), op_env: List(OpEnvEntry)): List(CST) = {
                              if int_eq(list_length(as_list), 0) then list_empty[CST]() else {
                                let a0 = list_get(as_list, 0);
                                let rest = extract_params(advance(as_list), op_env);
                                match a0 {
                                  case Symbol(pn, psp) => list_insert_first(rest, SeqOf(list_insert_first(list_insert_first(list_insert_first(list_empty[CST](), Symbol("Unknown", psp)), Symbol(":", psp)), Symbol(pn, psp)), psp));
                                  case SeqOf(_, _) => list_insert_first(rest, a0);
                                  case _ => list_insert_first(rest, SeqOf(list_insert_first(list_insert_first(list_insert_first(list_empty[CST](), Symbol("Unknown", Span(0, 0, list_empty[Integer]()))), Symbol(":", Span(0, 0, list_empty[Integer]()))), Symbol("unknown", Span(0, 0, list_empty[Integer]()))), Span(0, 0, list_empty[Integer]())))
                                }
                              }
                            };

// The Self-Hosted Macro Expander
enum PatternCST {
  case PatWildcardCST(span: Span);
  case PatConstructorCST(vname: String, vars: List(String), span: Span);
  case PatVarCST(vname: String, span: Span)
};
enum MacroCase {
  case CasePair(pat: PatternCST, body: CST)
};
enum OpFixity {
  case InfixL(d: Integer);
  case InfixR(d: Integer);
  case Prefix(d: Integer);
  case Postfix(d: Integer)
};
enum OpRel {
  case TighterThan(other: String);
  case LooserThan(other: String);
  case SameAs(other: String)
};
enum RelResult {
  case RelTighter(d: Integer);
  case RelLooser(d: Integer);
  case RelSameL(d: Integer);
  case RelSameR(d: Integer);
  case RelIncomparable(d: Integer)
};
enum OpEnvEntry {
  case OpEntry(name: String, fixity: OpFixity, rels: List(OpRel))
};
enum MacroEnvEntry {
  case Entry(name: String, cases: List(MacroCase))
};
enum SubstEntry {
  case Sub(name: String, value: CST)
};
def add_mark_span(mark: Integer, s: Span): Span = {
  Span(Span_start(s), Span_end(s), list_insert_first(Span_context(s), mark))
};
def add_mark_cst(mark: Integer, c: CST): CST = {
  match c {
    case Symbol(n, s) => Symbol(n, add_mark_span(mark, s));
    case Tuple(elems, s) => Tuple(add_mark_cst_list(mark, elems), add_mark_span(mark, s));
    case ListLiteral(elems, s) => ListLiteral(add_mark_cst_list(mark, elems), add_mark_span(mark, s));
    case Block(stmts, tail, s) => Block(add_mark_cst_list(mark, stmts), add_mark_cst(mark, tail), add_mark_span(mark, s));
    case StringLiteral(v, s) => StringLiteral(v, add_mark_span(mark, s));
    case IntegerLiteral(v, s) => IntegerLiteral(v, add_mark_span(mark, s));
    case SeqOf(elems, s) => SeqOf(add_mark_cst_list(mark, elems), add_mark_span(mark, s));
    case FieldAccess(expr, f, s) => FieldAccess(add_mark_cst(mark, expr), f, add_mark_span(mark, s));
    case LetCST(n, v, next, s) => LetCST(n, add_mark_cst(mark, v), add_mark_cst(mark, next), add_mark_span(mark, s));
    case IfCST(cond, tb, eb, s) => IfCST(add_mark_cst(mark, cond), add_mark_cst(mark, tb), add_mark_cst(mark, eb), add_mark_span(mark, s));
    case DefCST(n, tps, params, rt, body, s) => DefCST(n, tps, add_mark_cst_list(mark, params), add_mark_cst(mark, rt), add_mark_cst(mark, body), add_mark_span(mark, s));
    case LamCST(n, argty, body, s) => LamCST(n, add_mark_cst(mark, argty), add_mark_cst(mark, body), add_mark_span(mark, s));
    case AppCST(f, args, s) => AppCST(add_mark_cst(mark, f), add_mark_cst_list(mark, args), add_mark_span(mark, s));
    case ImplicitAppCST(f, targs, s) => ImplicitAppCST(add_mark_cst(mark, f), add_mark_cst_list(mark, targs), add_mark_span(mark, s));
    case EnumCST(n, tps, vars, s) => EnumCST(n, tps, add_mark_cst_list(mark, vars), add_mark_span(mark, s));
    case MatchCST(expr, cases, s) => MatchCST(add_mark_cst(mark, expr), add_mark_cst_list(mark, cases), add_mark_span(mark, s));
    case RecordCST(n, tps, fields, s) => RecordCST(n, tps, add_mark_cst_list(mark, fields), add_mark_span(mark, s));
    case Comment(t, s) => Comment(t, add_mark_span(mark, s));
    case MacroDefCST(n, cases, s) => MacroDefCST(n, add_mark_cst_list(mark, cases), add_mark_span(mark, s));
    case Error(m, s) => Error(m, add_mark_span(mark, s));
    case _ => c
  }
};
def add_mark_cst_list(mark: Integer, ls: List(CST)): List(CST) = {
  if int_eq(list_length(ls), 0) then list_empty[CST]() else list_insert_first(add_mark_cst_list(mark, advance(ls)), add_mark_cst(mark, list_get(ls, 0)))
};
enum MacroLookupResult {
  case Found(cases: List(MacroCase));
  case NotFound
};
def lookup_macro(name: String, env: List(MacroEnvEntry)): MacroLookupResult = {
  if int_eq(list_length(env), 0) then MacroLookupResult.NotFound else {
    let entry = list_get(env, 0);
    match entry {
      case Entry(n, cases) => {
        if string_eq(name, n) then MacroLookupResult.Found(cases) else lookup_macro(name, advance(env))
      };
      case _ => lookup_macro(name, advance(env))
    }
}
};
def lookup_subst(n: String, subst: List(SubstEntry)): CST = {
  if int_eq(list_length(subst), 0) then Error("Not found", Span(0, 0, list_empty[Integer]())) else {
    let entry = list_get(subst, 0);
    match entry {
      case Sub(k, v) => {
        if string_eq(n, k) then v else lookup_subst(n, advance(subst))
      };
      case _ => lookup_subst(n, advance(subst))
    }
}
};
def has_subst(n: String, subst: List(SubstEntry)): Bool = {
  if int_eq(list_length(subst), 0) then false else {
    let entry = list_get(subst, 0);
    match entry {
      case Sub(k, _) => {
        if string_eq(n, k) then true else has_subst(n, advance(subst))
      };
      case _ => has_subst(n, advance(subst))
    }
}
};
def subst_cst(subst: List(SubstEntry), c: CST): CST = {
  match c {
    case Symbol(n, _) => {
      if has_subst(n, subst) then lookup_subst(n, subst) else c
    };
    case Tuple(elems, s) => Tuple(subst_cst_list(subst, elems), s);
    case ListLiteral(elems, s) => ListLiteral(subst_cst_list(subst, elems), s);
    case Block(stmts, tail, s) => Block(subst_cst_list(subst, stmts), subst_cst(subst, tail), s);
    case SeqOf(elems, s) => SeqOf(subst_cst_list(subst, elems), s);
    case FieldAccess(expr, f, s) => FieldAccess(subst_cst(subst, expr), f, s);
    case LetCST(n, v, next, s) => LetCST(n, subst_cst(subst, v), subst_cst(subst, next), s);
    case IfCST(cond, tb, eb, s) => IfCST(subst_cst(subst, cond), subst_cst(subst, tb), subst_cst(subst, eb), s);
    case DefCST(n, tps, params, rt, body, s) => DefCST(n, tps, subst_cst_list(subst, params), subst_cst(subst, rt), subst_cst(subst, body), s);
    case LamCST(n, argty, body, s) => LamCST(n, subst_cst(subst, argty), subst_cst(subst, body), s);
    case AppCST(f, args, s) => AppCST(subst_cst(subst, f), subst_cst_list(subst, args), s);
    case ImplicitAppCST(f, targs, s) => ImplicitAppCST(subst_cst(subst, f), subst_cst_list(subst, targs), s);
    case EnumCST(n, tps, vars, s) => EnumCST(n, tps, subst_cst_list(subst, vars), s);
    case MatchCST(expr, cases, s) => MatchCST(subst_cst(subst, expr), subst_cst_list(subst, cases), s);
    case RecordCST(n, tps, fields, s) => RecordCST(n, tps, subst_cst_list(subst, fields), s);
    case MacroDefCST(n, cases, s) => MacroDefCST(n, subst_cst_list(subst, cases), s);
    case _ => c
  }
};
def subst_cst_list(subst: List(SubstEntry), ls: List(CST)): List(CST) = {
  if int_eq(list_length(ls), 0) then list_empty[CST]() else list_insert_first(subst_cst_list(subst, advance(ls)), subst_cst(subst, list_get(ls, 0)))
};
enum ZipResult {
  case Zipped(subst: List(SubstEntry));
  case ZipFailed(d: Integer)
};
def zip_args(vs: List(String), as_: List(CST)): ZipResult = {
  if int_eq(list_length(vs), 0) then {
    if int_eq(list_length(as_), 0) then ZipResult.Zipped(list_empty[SubstEntry]()) else ZipResult.ZipFailed(0)
} else {
    if int_eq(list_length(as_), 0) then ZipResult.ZipFailed(0) else {
      let v = list_get(vs, 0);
      let a = list_get(as_, 0);
      let tail_res = zip_args(advance(vs), advance(as_));
      match tail_res {
        case Zipped(tail_subst) => ZipResult.Zipped(list_insert_first(tail_subst, SubstEntry.Sub(v, a)));
        case _ => ZipResult.ZipFailed
      }
    }
  }
};
enum MacroMatchResult {
  case Matched(cst: CST);
  case NoMatch
};
def apply_macro(cases: List(MacroCase), args: List(CST), mark: Integer): MacroMatchResult = {
  if int_eq(list_length(cases), 0) then MacroMatchResult.NoMatch else {
    let c = list_get(cases, 0);
    match c {
      case CasePair(pat, template) => {
        match pat {
          case PatWildcardCST(_) => MacroMatchResult.Matched(template);
          case PatConstructorCST(_, vars, _) => {
            let zip_res = zip_args(vars, args);
            match zip_res {
              case Zipped(subst) => MacroMatchResult.Matched(add_mark_cst(mark, subst_cst(subst, template)));
              case _ => apply_macro(advance(cases), args, mark)
            }
          };
          case _ => apply_macro(advance(cases), args, mark)
        }
      };
      case _ => apply_macro(advance(cases), args, mark)
    }
  }
};
def split_at_eq(acc: List(CST), ls: List(CST)): List(List(CST)) = {
  if int_eq(list_length(ls), 0) then list_empty[List(CST)]() else {
    let x = list_get(ls, 0);
    let rest = advance(ls);
    // assuming advance is provided in TS mock
    match x {
      case Symbol(s, _) => {
        if string_eq(s, "=") then {
          let res = list_empty[List(CST)]();
          list_append(list_append(res, acc), rest)
} else split_at_eq(list_append(acc, x), rest)
      };
      case _ => split_at_eq(list_append(acc, x), rest)
    }
}
};
def collapse_apps(elems: List(CST), acc: List(CST)): List(CST) = {
  if int_eq(list_length(elems), 0) then acc else {
    let x = list_get(elems, 0);
    let rest = advance(elems);
    match x {
      case Symbol(s, sp) => {
        if string_eq(s, ".") then {
          if int_eq(list_length(rest), 0) then collapse_apps(rest, list_append(acc, x)) else {
            let next_x = list_get(rest, 0);
            match next_x {
              case Symbol(field, _) => {
                let acc_len = list_length(acc);
                if int_eq(acc_len, 0) then {
                  collapse_apps(advance(rest), list_append(list_append(acc, x), next_x))
} else {
                  let expr = list_get(acc, int_sub(acc_len, 1));
                  let new_acc = list_drop_last(acc);
                  let node = FieldAccess(expr, field, sp);
                  collapse_apps(advance(rest), list_append(new_acc, node))
                }
};
              case _ => collapse_apps(rest, list_append(acc, x))
            }
}
} else {
          collapse_apps(rest, list_append(acc, x))
        }
};
      case Tuple(args, sp) => {
        let acc_len = list_length(acc);
        if int_eq(acc_len, 0) then collapse_apps(rest, list_append(acc, x)) else {
          let func_val = list_get(acc, int_sub(acc_len, 1));
          let skip = match func_val {
            case Symbol(kw, _) => {
              bool_or(string_eq(kw, "then"), bool_or(string_eq(kw, "else"), bool_or(string_eq(kw, "case"), bool_or(string_eq(kw, "if"), bool_or(string_eq(kw, "match"), bool_or(string_eq(kw, "=>"), bool_or(string_eq(kw, "="), bool_or(string_eq(kw, ":"), string_eq(kw, "->")))))))))
            };
            case _ => false
          };
          if skip then collapse_apps(rest, list_append(acc, x)) else {
            let new_acc = list_drop_last(acc);
            let node = AppCST(func_val, args, sp);
            collapse_apps(rest, list_append(new_acc, node))
          }
        }
      };
      case ListLiteral(targs, sp) => {
        let acc_len = list_length(acc);
        if int_eq(acc_len, 0) then collapse_apps(rest, list_append(acc, x)) else {
          let func_val = list_get(acc, int_sub(acc_len, 1));
          let new_acc = list_drop_last(acc);
          let node = ImplicitAppCST(func_val, targs, sp);
          collapse_apps(rest, list_append(new_acc, node))
        }
};
      case _ => collapse_apps(rest, list_append(acc, x))
    }
}
};
enum OptionCST {
  case SomeCST(cst: CST);
  case NoneCST()
};

def expand_if(elems: List(CST), op_env: List(OpEnvEntry), span: Span): OptionCST = {
  let len = list_length(elems);
  if int_lt(len, 4) then OptionCST.NoneCST else {
    let tok0 = list_get(elems, 0);
    match tok0 {
      case Symbol(s0, _) => {
        if string_eq(s0, "if") then {
          let cond = list_get(elems, 1);
          let tok2 = list_get(elems, 2);
          match tok2 {
            case Symbol(s2, _) => {
              if string_eq(s2, "then") then {
                let thenB = list_get(elems, 3);
                if int_eq(len, 4) then {
                  OptionCST.SomeCST(IfCST(cond, thenB, Tuple(list_empty[CST](), span), span))
                } else if int_lt(len, 6) then {
                  OptionCST.NoneCST
                } else {
                  let tok4 = list_get(elems, 4);
                  match tok4 {
                    case Symbol(s4, _) => {
                      if string_eq(s4, "else") then {
                        let rest = expand_if_get_rest(5, list_empty[CST](), len, elems);
                        let else_if_res = expand_if(rest, op_env, span);
                        match else_if_res {
                          case SomeCST(else_if_cst) => OptionCST.SomeCST(IfCST(cond, thenB, else_if_cst, span));
                          case NoneCST() => {
                            if int_eq(list_length(rest), 0) then OptionCST.NoneCST
                            else if int_eq(list_length(rest), 1) then OptionCST.SomeCST(IfCST(cond, thenB, list_get(rest, 0), span))
                            else OptionCST.SomeCST(IfCST(cond, thenB, SeqOf(rest, span), span))
                          }
                        }
                      } else OptionCST.NoneCST
                    };
                    case _ => OptionCST.NoneCST
                  }
                }
              } else OptionCST.NoneCST
            };
            case _ => OptionCST.NoneCST
          }
        } else OptionCST.NoneCST
      };
      case _ => OptionCST.NoneCST
    }
  }
};
enum PrattResult {
  case Parsed(expr: CST, rest: List(CST));
  case PrattError(msg: String)
};
def pratt_parse(fuel: Integer, elems: List(CST), left_op: String, op_env: List(OpEnvEntry)): PrattResult = {
  if int_eq(fuel, 0) then PrattResult.PrattError("Out of fuel") else if int_eq(list_length(elems), 0) then PrattResult.PrattError("Unexpected end of expression") else {
    let lhs = list_get(elems, 0);
    let rest = advance(elems);
    pratt_loop(int_sub(fuel, 1), lhs, rest, left_op, op_env)
  }
};
def pratt_loop(fuel: Integer, lhs: CST, elems: List(CST), left_op: String, op_env: List(OpEnvEntry)): PrattResult = {
  if int_eq(fuel, 0) then PrattResult.PrattError("Out of fuel") else if int_eq(list_length(elems), 0) then PrattResult.Parsed(lhs, elems) else {
    let next_tok = list_get(elems, 0);
    match next_tok {
      case Symbol(op, sp) => {
        let entry = lookup_op(op, op_env);
        match entry {
          case FoundOp(fixity, rels) => {
        let _dummy_fixity = fixity;
        let _dummy_rels = rels;
            if string_eq(left_op, "") then {
              let rhs_res = pratt_parse(int_sub(fuel, 1), advance(elems), op, op_env);
              match rhs_res {
                case Parsed(rhs, rest_after) => {
                  let args = list_insert_first(list_insert_first(list_empty[CST](), rhs), lhs);
                  let new_lhs = AppCST(Symbol(op_to_fn(op), sp), args, sp);
                  pratt_loop(int_sub(fuel, 1), new_lhs, rest_after, left_op, op_env)
                };
                case PrattError(msg) => PrattResult.PrattError(msg)
              }
} else {
              let rel = get_relation(left_op, op, op_env);
              match rel {
                case RelTighter(_) => PrattResult.Parsed(lhs, elems);
                case RelSameL(_) => PrattResult.Parsed(lhs, elems);
                case RelSameR(_) => {
                  let rhs_res = pratt_parse(int_sub(fuel, 1), advance(elems), op, op_env);
                  match rhs_res {
                    case Parsed(rhs, rest_after) => {
                      let args = list_insert_first(list_insert_first(list_empty[CST](), rhs), lhs);
                      let new_lhs = AppCST(Symbol(op_to_fn(op), sp), args, sp);
                      pratt_loop(int_sub(fuel, 1), new_lhs, rest_after, left_op, op_env)
                    };
                    case PrattError(msg) => PrattResult.PrattError(msg)
                  }
};
                case _ => PrattResult.Parsed(lhs, elems);
                case RelLooser(_) => {
                  let rhs_res = pratt_parse(int_sub(fuel, 1), advance(elems), op, op_env);
                  match rhs_res {
                    case Parsed(rhs, rest_after) => {
                      let args = list_insert_first(list_insert_first(list_empty[CST](), rhs), lhs);
                      let new_lhs = AppCST(Symbol(op_to_fn(op), sp), args, sp);
                      pratt_loop(int_sub(fuel, 1), new_lhs, rest_after, left_op, op_env)
                    };
                    case PrattError(msg) => PrattResult.PrattError(msg)
                  }
};
                case _ => PrattResult.Parsed(lhs, elems);
                case RelSameR(_) => {
                  let rhs_res = pratt_parse(int_sub(fuel, 1), advance(elems), op, op_env);
                  match rhs_res {
                    case Parsed(rhs, rest_after) => {
                      let args = list_insert_first(list_insert_first(list_empty[CST](), rhs), lhs);
                      let new_lhs = AppCST(Symbol(op_to_fn(op), sp), args, sp);
                      pratt_loop(int_sub(fuel, 1), new_lhs, rest_after, left_op, op_env)
                    };
                    case PrattError(msg) => PrattResult.PrattError(msg)
                  }
};
                case _ => PrattResult.Parsed(lhs, elems);
                case RelIncomparable(_) => PrattResult.PrattError("Ambiguous precedence")
              }
}
          };
          case _ => PrattResult.Parsed(lhs, elems)
        }
};
      case _ => PrattResult.Parsed(lhs, elems)
    }
}
};
def expand_seq_expr(elems: List(CST), op_env: List(OpEnvEntry), span: Span): CST = {
  let collapsed = collapse_apps(elems, list_empty[CST]());
  let if_res = expand_if(collapsed, op_env, span);
  match if_res {
    case SomeCST(if_cst) => if_cst;
    case NoneCST() => {
      let len = list_length(collapsed);
      if int_eq(len, 0) then Tuple(list_empty[CST](), span) else if int_eq(len, 1) then list_get(collapsed, 0) else {
        let first = list_get(collapsed, 0);
    match first {
      case Symbol(s, sp) => {
        if string_eq(s, get_backslash_char()) then {
          if int_lt(len, 4) then SeqOf(collapsed, span) else {
            let arg_tok = list_get(collapsed, 1);
            let arrow_tok = list_get(collapsed, 2);
            let body_rest = advance(advance(advance(collapsed)));
            let body = if int_eq(list_length(body_rest), 0) then Tuple(list_empty[CST](), span)
              else if int_eq(list_length(body_rest), 1) then list_get(body_rest, 0)
              else SeqOf(body_rest, span);
            match arg_tok {
              case Symbol(arg_name, _) => {
                match arrow_tok {
                  case Symbol(arr, _) => {
                    if string_eq(arr, "=>") then LamCST(arg_name, Error("None", sp), body, span)
                    else SeqOf(collapsed, span)
                  };
                  case _ => SeqOf(collapsed, span)
                }
              };
              case _ => SeqOf(collapsed, span)
            }
          }
} else if string_eq(s, "match") then {
          if int_lt(len, 3) then Error("Incomplete match", span) else {
            let expr = list_get(collapsed, 1);
            let blk = list_get(collapsed, 2);
            match blk {
              case Block(_, _, _) => {
                // Include block tail (last case often lives there without trailing ';').
                MatchCST(expr, extract_cases(methods_of_block_1(blk, op_env)), span)
              };
              case _ => Error("Expected block for match cases", span)
            }
          }
        } else if string_eq(s, "perform") then {
          if int_eq(len, 2) then {
            match list_get(collapsed, 1) {
              case AppCST(op, args, _) => CST.DoCST(op, args, span);
              case _ => SeqOf(collapsed, span)
            }
          } else SeqOf(collapsed, span)
        } else if string_eq(s, "box") then {
          let rest = advance(collapsed);
          if int_eq(list_length(rest), 1) then CST.BoxCST(list_get(rest, 0), span)
          else CST.BoxCST(SeqOf(rest, span), span)
        } else if string_eq(s, "unbox") then {
          let rest = advance(collapsed);
          if int_eq(list_length(rest), 1) then CST.UnboxCST(list_get(rest, 0), span)
          else CST.UnboxCST(SeqOf(rest, span), span)
        } else if string_eq(s, "handle") then {
          if int_eq(len, 5) then {
            let body_block = list_get(collapsed, 1);
            let with_tok = list_get(collapsed, 2);
            let eff_tok = list_get(collapsed, 3);
            let handler_block = list_get(collapsed, 4);
            match with_tok {
              case Symbol(w, _) => {
                if string_eq(w, "with") then {
                  match eff_tok {
                    case Symbol(eff_name, _) => {
                      match body_block {
                        case Block(bs, bt, _) => {
                          match handler_block {
                            case Block(hs, ht, _) => {
                              CST.HandleCST(CST.Block(bs, bt, Span(0, 0, list_empty[Integer]())), eff_name, methods_of_block_2(hs, ht, op_env), span)
                            };
                            case _ => SeqOf(collapsed, span)
                          }
                        };
                        case _ => SeqOf(collapsed, span)
                      }
                    };
                    case _ => SeqOf(collapsed, span)
                  }
                } else SeqOf(collapsed, span)
              };
              case _ => SeqOf(collapsed, span)
            }
          } else SeqOf(collapsed, span)
        } else {
          // Match Rocq: leave unconsumed forms as SeqOf so process_stmts can
          // recognize def/let/enum/etc. Only commit to Pratt when it consumes all.
          let pr = pratt_parse(1000, collapsed, "", op_env);
          match pr {
            case Parsed(expr, rest) => {
              if int_eq(list_length(rest), 0) then expr else SeqOf(collapsed, span)
            };
            case PrattError(_) => SeqOf(collapsed, span)
          }
}
      };
      case _ => {
        let pr = pratt_parse(1000, collapsed, "", op_env);
        match pr {
          case Parsed(expr, rest) => {
            if int_eq(list_length(rest), 0) then expr else SeqOf(collapsed, span)
          };
          case PrattError(_) => SeqOf(collapsed, span)
        }
}
    }
}
  }
  }
};
enum ExpandResult {
  case Res(cst: CST, mark: Integer)
};
enum ExpandResultList {
  case ResList(csts: List(CST), mark: Integer)
};
def extract_vars(args: List(CST)): List(String) = {
  if int_eq(list_length(args), 0) then list_empty[String]() else {
    let first = list_get(args, 0);
    let rest = extract_vars(advance(args));
    match first {
      case Symbol(vname, _) => list_insert_first(rest, vname);
      case _ => rest
    }
}
};
def extract_variants(vs: List(CST)): List(CST) = {
  if int_eq(list_length(vs), 0) then list_empty[CST]() else {
    let v = list_get(vs, 0);
    let vrest = extract_variants(advance(vs));
    match v {
      case SeqOf(raw_elems, sp) => {
        let _dummy_sp = sp;
        let elems = collapse_apps(raw_elems, list_empty[CST]());
        if int_eq(list_length(elems), 4) then {
          let kw = list_get(elems, 0);
          let head = list_get(elems, 1);
          let colon = list_get(elems, 2);
          let ret_ty = list_get(elems, 3);
          match kw {
            case Symbol(kw_name, _) => {
              if string_eq(kw_name, "case") then {
                match colon {
                  case Symbol(colon_name, _) => {
                    if string_eq(colon_name, ":") then {
                      match head {
                        case AppCST(_, _, _) => {
                          list_insert_first(vrest, CST.AppCST(CST.Symbol(":", Span(0, 0, list_empty[Integer]())), list_insert_first(list_insert_first(list_empty[CST](), ret_ty), head), Span(0, 0, list_empty[Integer]())))
                        };
                        case Symbol(_, _) => {
                          list_insert_first(vrest, CST.AppCST(CST.Symbol(":", Span(0, 0, list_empty[Integer]())), list_insert_first(list_insert_first(list_empty[CST](), ret_ty), head), Span(0, 0, list_empty[Integer]())))
                        };
                        case _ => vrest
                      }
} else vrest
                  };
                  case _ => vrest
                }
} else vrest
            };
            case _ => vrest
          }
} else if int_eq(list_length(elems), 2) then {
          let kw = list_get(elems, 0);
          let head = list_get(elems, 1);
          match kw {
            case Symbol(kw_name, _) => {
              if string_eq(kw_name, "case") then {
                match head {
                  case AppCST(_, _, _) => { list_insert_first(vrest, head) };
                  case Symbol(_, _) => { list_insert_first(vrest, head) };
                  case _ => { vrest }
                }
              } else vrest
            };
            case _ => vrest
          }
} else vrest
      };
      case _ => vrest
    }
}
};
def extract_macro_cases(cs: List(CST)): List(MacroCase) = {
  if int_eq(list_length(cs), 0) then list_empty[MacroCase]() else {
    let x = list_get(cs, 0);
    let r = extract_macro_cases(advance(cs));
    match x {
      case SeqOf(elems, sp) => {
        let _dummy_sp = sp;
        if int_eq(list_length(elems), 0) then list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x)) else {
          let first = list_get(elems, 0);
          match first {
            case Symbol(sym_case, _) => {
              if string_eq(sym_case, "case") then {
                let vname_node = list_get(elems, 1);
                let args_node = list_get(elems, 2);
                match vname_node {
                  case Symbol(vname, _) => {
                    match args_node {
                      case Tuple(args_cst, _) => {
                        let body_cst = list_get(elems, 4);
                        list_insert_first(r, MacroCase.CasePair(PatternCST.PatConstructorCST(vname, extract_vars(args_cst), Span(0, 0, list_empty[Integer]())), body_cst))
                      };
                      case _ => list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x))
                    }
                  };
                  case _ => list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x))
                }
              } else {
                list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x))
              }
            };
            case _ => list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x))
          }
        }
      };
      case _ => list_insert_first(r, MacroCase.CasePair(PatternCST.PatWildcardCST(Span(0, 0, list_empty[Integer]())), x))
    }
  }
};
def map_expand(ls: List(CST), fuel: Integer, env: List(MacroEnvEntry), op_env: List(OpEnvEntry), m: Integer): ExpandResultList = {
  if int_eq(list_length(ls), 0) then ExpandResultList.ResList(list_empty[CST](), m) else {
    let x = list_get(ls, 0);
    let res_x = expand_cst(fuel, env, op_env, m, x);
    match res_x {
      case Res(fst_cst, next_m) => {
        let res_rest = map_expand(advance(ls), fuel, env, op_env, next_m);
        match res_rest {
          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
        }
      }
    }
  }
};
enum LookupOp {
  case FoundOp(fixity: OpFixity, rels: List(OpRel));
  case NotFoundOp
};
// Rocq op_to_fn: rewrite infix symbols to stdlib function names.
def op_to_fn(op: String): String = {
  if string_eq(op, "+") then "int_add"
  else if string_eq(op, "-") then "int_sub"
  else if string_eq(op, "*") then "int_mul"
  else if string_eq(op, "/") then "int_div"
  else if string_eq(op, "%") then "int_mod"
  else if string_eq(op, "<") then "int_lt"
  else if string_eq(op, ">") then "int_gt"
  else if string_eq(op, "<=") then "int_le"
  else if string_eq(op, ">=") then "int_ge"
  else if string_eq(op, "==") then "int_eq"
  else if string_eq(op, "!=") then "int_eq"
  else op
};
// Rocq op_prec: built-in precedence when op_env has no entry.
def builtin_op_fixity(op: String): LookupOp = {
  if string_eq(op, "+") then LookupOp.FoundOp(OpFixity.InfixL(10), list_empty[OpRel]())
  else if string_eq(op, "-") then LookupOp.FoundOp(OpFixity.InfixL(10), list_empty[OpRel]())
  else if string_eq(op, "*") then LookupOp.FoundOp(OpFixity.InfixL(20), list_empty[OpRel]())
  else if string_eq(op, "/") then LookupOp.FoundOp(OpFixity.InfixL(20), list_empty[OpRel]())
  else if string_eq(op, "%") then LookupOp.FoundOp(OpFixity.InfixL(20), list_empty[OpRel]())
  else if string_eq(op, "<") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else if string_eq(op, ">") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else if string_eq(op, "<=") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else if string_eq(op, ">=") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else if string_eq(op, "==") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else if string_eq(op, "!=") then LookupOp.FoundOp(OpFixity.InfixL(5), list_empty[OpRel]())
  else LookupOp.NotFoundOp
};
def lookup_op(name: String, env: List(OpEnvEntry)): LookupOp = {
  if int_eq(list_length(env), 0) then builtin_op_fixity(name) else {
    let first = list_get(env, 0);
    match first {
      case OpEntry(n, fixity, rels) => {
        let _dummy_fixity = fixity;
        if string_eq(n, name) then LookupOp.FoundOp(fixity, rels) else lookup_op(name, advance(env))
      }
    }
  }
};
def has_looser_than(rels: List(OpRel), target: String): Bool = {
  if int_eq(list_length(rels), 0) then false else {
    let r = list_get(rels, 0);
    let found = match r {
      case LooserThan(other) => string_eq(other, target);
      case _ => false
    };
    if found then true else has_looser_than(advance(rels), target)
  }
};
def has_same_as(rels: List(OpRel), target: String): Bool = {
  if int_eq(list_length(rels), 0) then false else {
    let r = list_get(rels, 0);
    let found = match r {
      case SameAs(other) => string_eq(other, target);
      case _ => false
    };
    if found then true else has_same_as(advance(rels), target)
  }
};
// Forward declare is_tighter_than to break cycles isn't supported, we need them ordered,
// wait, Chester doesn't have forward declarations but supports mutual recursion if they are at top level?
// Actually, Chester resolves all defs globally! So order doesn't matter.
def check_rels_for_tighter(fuel: Integer, rels: List(OpRel), target: String, env: List(OpEnvEntry)): Bool = {
  if int_eq(list_length(rels), 0) then false else {
    let r = list_get(rels, 0);
    let rest = advance(rels);
    let found = match r {
      case TighterThan(other) => is_tighter_than(fuel, other, target, env);
      case SameAs(other) => is_tighter_than(fuel, other, target, env);
      case _ => false
    };
    if found then true else check_rels_for_tighter(fuel, rest, target, env)
  }
};
def check_env_for_looser(fuel: Integer, current: String, target: String, env_idx: Integer, env: List(OpEnvEntry)): Bool = {
  if int_eq(env_idx, list_length(env)) then false else {
    let entry = list_get(env, env_idx);
    let found = match entry {
      case OpEntry(n, fixity, rels) => {
        let _dummy_fixity = fixity;
        if has_looser_than(rels, current) then is_tighter_than(fuel, n, target, env) else if has_same_as(rels, current) then is_tighter_than(fuel, n, target, env) else false
      }
};
    if found then true else check_env_for_looser(fuel, current, target, int_add(env_idx, 1), env)
  }
};
def is_tighter_than(fuel: Integer, start: String, target: String, env: List(OpEnvEntry)): Bool = {
  if int_eq(fuel, 0) then false else if string_eq(start, target) then true else {
    let next_fuel = int_sub(fuel, 1);
    let entry = lookup_op(start, env);
    let found_forward = match entry {
      case FoundOp(fixity, rels) => {
        let _dummy_fixity = fixity;
        check_rels_for_tighter(next_fuel, rels, target, env)
      };
      case _ => false
    };
    if found_forward then true else check_env_for_looser(next_fuel, start, target, 0, env)
  }
};
def get_relation(op1: String, op2: String, env: List(OpEnvEntry)): RelResult = {
  let t12 = is_tighter_than(100, op1, op2, env);
  let t21 = is_tighter_than(100, op2, op1, env);
  if bool_and(t12, t21) then {
    // they are same
    let entry = lookup_op(op1, env);
    match entry {
      case FoundOp(fixity, rels) => {
        let _dummy_fixity = fixity;
        let _dummy_rels = rels;
                              match fixity {
          case InfixL(_) => RelResult.RelSameL;
          case InfixR(_) => RelResult.RelSameR;
          case _ => RelResult.RelSameL;
          // fallback
        }
      };
      case _ => RelResult.RelSameL
    }
} else if t12 then RelResult.RelTighter(0) else if t21 then RelResult.RelLooser(0) else RelResult.RelIncomparable(0)
};
def parse_op_rels_loop(elems: List(CST)): List(OpRel) = {
  if int_lt(list_length(elems), 2) then list_empty[OpRel]() else {
    let rel_sym = list_get(elems, 0);
    let target = list_get(elems, 1);
    let rest = advance(advance(elems));
    let parsed_target = match target {
      case StringLiteral(val, _) => val;
      case _ => ""
    };
    let parsed_rel = match rel_sym {
      case Symbol(s, _) => {
        if string_eq(s, "same_as") then OpRel.SameAs(parsed_target) else if string_eq(s, "tighter_than") then OpRel.TighterThan(parsed_target) else if string_eq(s, "looser_than") then OpRel.LooserThan(parsed_target) else OpRel.SameAs("")
      };
      case _ => OpRel.SameAs("")
    };
    let tail_rels = parse_op_rels_loop(rest);
    list_insert_first(tail_rels, parsed_rel)
  }
};
def parse_op_decl(fixity: OpFixity, elems: List(CST), fuel: Integer, env: List(MacroEnvEntry), op_env: List(OpEnvEntry), m: Integer, rest_ss: List(CST)): ExpandResultList = {
  let name_node = list_get(elems, 1);
  let op_name = match name_node {
    case StringLiteral(val, _) => val;
    case _ => ""
  };
  let rels = parse_op_rels_loop(advance(advance(elems)));
  let new_op_entry = OpEnvEntry.OpEntry(op_name, fixity, rels);
  let new_op_env = list_insert_first(op_env, new_op_entry);
  process_stmts(fuel, env, new_op_env, m, rest_ss)
};
def parse_ext_type_params(c: CST): List(String) = {
  match c {
    case ListLiteral(elems, _) => extract_type_params(elems);
    case _ => list_empty[String]()
  }
};
def extract_type_params(elems: List(CST)): List(String) = {
  if int_eq(list_length(elems), 0) then list_empty[String]() else {
    let first = list_get(elems, 0);
    let rest = extract_type_params(advance(elems));
    match first {
      case Symbol(s, _) => list_insert_first(rest, s);
      case _ => rest
    }
}
};
def extract_ext_target(elems: List(CST), start_idx: Integer, end_idx: Integer, span: Span): CST = {
  if int_eq(start_idx, end_idx) then Error("No target type", span) else if int_eq(int_add(start_idx, 1), end_idx) then list_get(elems, start_idx) else {
    let slice_len = int_sub(end_idx, start_idx);
    // Actually we can just pack it into a SeqOf and let it be collapsed later?
    // Wait, the target type could be `List(T)`, which parses as SeqOf.
    // We can just construct a SeqOf manually for the slice.
    let slice = list_empty[CST]();
    // It's easier to just pass the sublist, but Chester doesn't have a built-in sublist.
    // Let's just create it recursively.
    build_sublist(elems, start_idx, end_idx, span)
  }
};
def build_sublist(elems: List(CST), curr: Integer, end_idx: Integer, span: Span): CST = {
  if int_eq(curr, end_idx) then Tuple(list_empty[CST](), span) else { // Empty seq
    let next_cst = build_sublist(elems, int_add(curr, 1), end_idx, span);
    let head = list_get(elems, curr);
    match next_cst {
      case Tuple(_, _) => SeqOf(list_insert_first(list_empty[CST](), head), span);
      case SeqOf(ls, _) => SeqOf(list_insert_first(ls, head), span);
      case _ => SeqOf(list_insert_first(list_insert_first(list_empty[CST](), next_cst), head), span)
    }
}
};
def process_stmts(fuel: Integer, env: List(MacroEnvEntry), op_env: List(OpEnvEntry), m: Integer, ss: List(CST)): ExpandResultList = {
  if int_eq(list_length(ss), 0) then ExpandResultList.ResList(list_empty[CST](), m) else {
    let s = list_get(ss, 0);
    let rest_ss = advance(ss);
    match s {
      case SeqOf(elems, sp) => {
        if int_eq(list_length(elems), 0) then {
          let res_s = expand_cst(fuel, env, op_env, m, s);
          match res_s {
            case Res(fst_cst, next_m) => {
              let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
              match res_rest {
                case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
              }
}
          }
} else {
          // Collapse main()/f[T] before recognizing def/enum/effect/… forms
          // (Rocq expand_seq_expr collapses; process_stmts then sees AppCST).
          let elems = collapse_apps(elems, list_empty[CST]());
          let first = list_get(elems, 0);
          match first {
            case Symbol(sym, _) => {
              if string_eq(sym, "infixl") then {
                parse_op_decl(OpFixity.InfixL(0), elems, fuel, env, op_env, m, rest_ss)
} else if string_eq(sym, "infixr") then {
                parse_op_decl(OpFixity.InfixR(0), elems, fuel, env, op_env, m, rest_ss)
} else if string_eq(sym, "prefix") then {
                parse_op_decl(OpFixity.Prefix(0), elems, fuel, env, op_env, m, rest_ss)
} else if string_eq(sym, "postfix") then {
                parse_op_decl(OpFixity.Postfix(0), elems, fuel, env, op_env, m, rest_ss)

                } else if string_eq(sym, "extension") then {
              let len = list_length(elems);
              let name_node = list_get(elems, 1);
              let ext_name = match name_node {
                case Symbol(n, _) => n;
                case ImplicitAppCST(inner, _, _) => {
                  match inner {
                    case Symbol(n, _) => n;
                    case _ => ""
                  }
                };
                case _ => ""
              };
              let has_tparams = match list_get(elems, 2) {
                case ListLiteral(_, _) => true;
                case _ => false
              };
              let tparams = parse_ext_type_params(list_get(elems, 2));
              let on_idx = if has_tparams then 3 else 2;
              let target_ty = extract_ext_target(elems, int_add(on_idx, 1), int_sub(len, 1), Span(0, 0, list_empty[Integer]()));
              let block_node = list_get(elems, int_sub(len, 1));
              match block_node {
                case Block(_, _, _) => {
                  // Match Rocq: methods_of_block then process_stmts (keeps last method in tail).
                  let raw_meths = methods_of_block_1(block_node, op_env);
                  let processed = process_stmts(fuel, env, op_env, m, raw_meths);
                  match processed {
                    case ResList(meths, m2) => {
                      let ext_cst = ExtensionCST(ext_name, tparams, target_ty, meths, sp);
                      let res_rest = process_stmts(fuel, env, op_env, m2, rest_ss);
                      match res_rest {
                        case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, ext_cst), final_m)
                      }
                    }
                  }
                };
                case _ => {
                  let ext_cst = ExtensionCST(ext_name, tparams, target_ty, list_empty[CST](), sp);
                  let res_rest = process_stmts(fuel, env, op_env, m, rest_ss);
                  match res_rest {
                    case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, ext_cst), final_m)
                  }
                }
              }
            } else if string_eq(sym, "enum") then {
                let name_node = list_get(elems, 1);
                match name_node {
                  case Symbol(enum_name, _) => {
                    let block_node = list_get(elems, 2);
                    match block_node {
                      case Block(variants, tail, _) => {
                        let all_variants = match tail {
                          case Symbol(u, _) => {
                            if string_eq(u, "Unit") then variants else list_append(variants, tail)
                          };
                          case _ => list_append(variants, tail)
                        };
                        let extracted = extract_variants(all_variants);
                        let enum_cst = CST.EnumCST(enum_name, list_empty[String](), extracted, sp);
                        let cont = cont_with_leftover(elems, 3, sp, rest_ss);
                        let res_rest = process_stmts(fuel, env, op_env, m, cont);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, enum_cst), final_m)
                        }
};
                      case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                    }
};
                  case ImplicitAppCST(inner_sym, targs, _) => {
                    let enum_name = match inner_sym {
                      case Symbol(n, _) => n;
                      case _ => ""
                    };
                    let block_node = list_get(elems, 2);
                    match block_node {
                      case Block(variants, tail, _) => {
                        let all_variants = match tail {
                          case Symbol(u, _) => {
                            if string_eq(u, "Unit") then variants else list_append(variants, tail)
                          };
                          case _ => list_append(variants, tail)
                        };
                        let extracted = extract_variants(all_variants);
                        let enum_cst = CST.EnumCST(enum_name, targs, extracted, sp);
                        let cont = cont_with_leftover(elems, 3, sp, rest_ss);
                        let res_rest = process_stmts(fuel, env, op_env, m, cont);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, enum_cst), final_m)
                        }
};
                      case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                    }
};
                  case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                }
} else if string_eq(sym, "macro") then {
                let name_node = list_get(elems, 1);
                let block_node = list_get(elems, 2);
                match name_node {
                  case Symbol(mac_name, _) => {
                    match block_node {
                      case Block(_, _, _) => {
                        let extracted = extract_macro_cases(methods_of_block_1(block_node, op_env));
                        let new_env_entry = MacroEnvEntry.Entry(mac_name, extracted);
                        let new_env = list_insert_first(env, new_env_entry);
                        process_stmts(fuel, new_env, op_env, m, rest_ss)
                      };
                      case _ => {
                        let res_s = expand_cst(fuel, env, op_env, m, s);
                        match res_s {
                          case Res(fst_cst, next_m) => {
                            let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                            match res_rest {
                              case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                            }
}
                        }
}
                    }
};
                  case _ => {
                    let res_s = expand_cst(fuel, env, op_env, m, s);
                    match res_s {
                      case Res(fst_cst, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                        }
}
                    }
}
                }
} else if string_eq(sym, "effect") then {
                let name_node = list_get(elems, 1);
                match name_node {
                  case Symbol(eff_name, _) => {
                    let has_targs = match list_get(elems, 2) {
                      case ListLiteral(_, _) => true;
                      case _ => false
                    };
                    let block_idx = if has_targs then 3 else 2;
                    let tparams = if has_targs then {
                      match list_get(elems, 2) {
                        case ListLiteral(targs, _) => extract_tparams(targs);
                        case _ => list_empty[String]()
                      }
                    } else list_empty[String]();
                    let block_node = list_get(elems, block_idx);
                    match block_node {
                      case Block(_, _, _) => {
                        let meths = methods_of_block_1(block_node, op_env);
                        let processed = process_stmts(fuel, env, op_env, m, meths);
                        match processed {
                          case ResList(decl_csts, m2) => {
                            let eff_cst = CST.EffectCST(eff_name, tparams, decl_csts, sp);
                            let cont = cont_with_leftover(elems, int_add(block_idx, 1), sp, rest_ss);
                            let res_rest = process_stmts(fuel, env, op_env, m2, cont);
                            match res_rest {
                              case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, eff_cst), final_m)
                            }
}
                        }
};
                      case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                    }
};
                  case ImplicitAppCST(inner, targs, _) => {
                    match inner {
                      case Symbol(eff_name, _) => {
                        let block_node = list_get(elems, 2);
                        match block_node {
                          case Block(_, _, _) => {
                            let meths = methods_of_block_1(block_node, op_env);
                            let processed = process_stmts(fuel, env, op_env, m, meths);
                            match processed {
                              case ResList(decl_csts, m2) => {
                                let eff_cst = CST.EffectCST(eff_name, extract_tparams(targs), decl_csts, sp);
                                let cont = cont_with_leftover(elems, 3, sp, rest_ss);
                                let res_rest = process_stmts(fuel, env, op_env, m2, cont);
                                match res_rest {
                                  case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, eff_cst), final_m)
                                }
}
                            }
};
                          case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                        }
};
                      case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                    }
};
                  case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                }
} else if string_eq(sym, "perform") then {
                let app_node = list_get(elems, 1);
                match app_node {
                  case AppCST(op, args, _) => {
                    let do_cst = CST.DoCST(op, args, sp);
                    let res_rest = process_stmts(fuel, env, op_env, m, rest_ss);
                    match res_rest {
                      case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, do_cst), final_m)
                    }
};
                  case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                }
} else if string_eq(sym, "handle") then {
                let body_block = list_get(elems, 1);
                match body_block {
                  case Block(body_stmts, tail, sp3) => {
                    let eff_name_node = list_get(elems, 3);
                    match eff_name_node {
                      case Symbol(eff_name, _) => {
                        let handler_block = list_get(elems, 4);
                        match handler_block {
                          case Block(_, _, _) => {
                            let hcases = methods_of_block_1(handler_block, op_env);
                            let processed = process_stmts(fuel, env, op_env, m, hcases);
                            match processed {
                              case ResList(handler_csts, m2) => {
                                let handle_cst = CST.HandleCST(CST.Block(body_stmts, tail, sp3), eff_name, handler_csts, sp);
                                let cont = cont_with_leftover(elems, 5, sp, rest_ss);
                                let res_rest = process_stmts(fuel, env, op_env, m2, cont);
                                match res_rest {
                                  case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, handle_cst), final_m)
                                }
}
                            }
};
                          case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                        }
};
                      case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                    }
};
                  case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                }
} else if string_eq(sym, "def") then {
                let app_node = list_get(elems, 1);
                match app_node {
                  case AppCST(f, args, _) => {
                    let parse_head = match f {
                      case Symbol(n, _) => Pair.MkPair(n, list_empty[String]());
                      case ImplicitAppCST(inner_f, targs, _) => {
                        match inner_f {
                          case Symbol(n, _) => {
                            Pair.MkPair(n, extract_targs(targs))
                          };
                          case _ => Pair.MkPair("", list_empty[String]())
                        }
                      };
                      case _ => Pair.MkPair("", list_empty[String]())
                    };
                    match parse_head {
                      case MkPair(def_name, tparams) => {
                        if string_eq(def_name, "") then {
                          let res_s = expand_cst(fuel, env, op_env, m, s);
                          match res_s {
                            case Res(fst_cst, next_m) => {
                              let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                              match res_rest {
                                case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                              }
}
                          }
} else {
                          let rest_def = advance(advance(elems));
                          let split_res = split_at_eq(list_empty[CST](), rest_def);
                          if int_eq(list_length(split_res), 0) then {
                            let res_s = expand_cst(fuel, env, op_env, m, s);
                            match res_s {
                              case Res(fst_cst, next_m) => {
                                let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                                match res_rest {
                                  case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                                }
}
                            }
} else {
                            let ty_exprs = list_get(split_res, 0);
                            let body_exprs = list_get(split_res, 1);
                            
                            let ty_len = list_length(ty_exprs);
                            let ret_ty = if int_eq(ty_len, 0) then Symbol("Unknown", Span(0, 0, list_empty[Integer]())) else {
                              let c0 = list_get(ty_exprs, 0);
                              match c0 {
                                case Symbol(c0_s, _) => {
                                  if string_eq(c0_s, ":") then expand_seq_expr(advance(ty_exprs), op_env, sp) else Symbol("Unknown", Span(0, 0, list_empty[Integer]()))
                                };
                                case _ => Symbol("Unknown", Span(0, 0, list_empty[Integer]()))
                              }
                            };
                            
                            let body_len = list_length(body_exprs);
                            let body_cst = if int_eq(body_len, 1) then list_get(body_exprs, 0) else expand_seq_expr(body_exprs, op_env, sp);
                            
                            let params = extract_params(args, op_env);
                            
                            let def_cst = DefCST(def_name, tparams, params, ret_ty, body_cst, sp);
                            let res_rest = process_stmts(fuel, env, op_env, m, rest_ss);
                            match res_rest {
                              case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, def_cst), final_m)
                            }
                          }
                        }
                      }
                    }
                  };
                  case _ => {
                    let res_s = expand_cst(fuel, env, op_env, m, s);
                    match res_s {
                      case Res(fst_cst, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                        }
}
                    }
}
                }
} else if string_eq(sym, "let") then {
                let name_node = list_get(elems, 1);
                let val_exprs = advance(advance(advance(elems)));
                match name_node {
                  case Symbol(name, _) => {
                    let val_cst = expand_seq_expr(val_exprs, op_env, sp);
                    let res_val = expand_cst(fuel, env, op_env, m, val_cst);
                    match res_val {
                      case Res(fst_val, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => {
                            let node = LetCST(name, fst_val, Symbol("Unit", sp), Span(0, 0, list_empty[Integer]()));
                            ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                          }
}
                      }
}
                  };
                  case _ => {
                    let res_s = expand_cst(fuel, env, op_env, m, s);
                    match res_s {
                      case Res(fst_cst, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                        }
}
                    }
}
                }
} else if string_eq(sym, "var") then {
                let name_node = list_get(elems, 1);
                let val_exprs = advance(advance(advance(elems)));
                match name_node {
                  case Symbol(name, _) => {
                    let val_cst = expand_seq_expr(val_exprs, op_env, sp);
                    let res_val = expand_cst(fuel, env, op_env, m, val_cst);
                    match res_val {
                      case Res(fst_val, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => {
                            let node = VarCST(name, fst_val, Symbol("Unit", sp), Span(0, 0, list_empty[Integer]()));
                            ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                          }
}
                      }
}
                  };
                  case _ => ExpandResultList.ResList(list_empty[CST](), m)
                }
} else if string_eq(sym, "box") then {
                let inner = expand_seq_expr(advance(elems), op_env, sp);
                let res_i = expand_cst(fuel, env, op_env, m, inner);
                match res_i {
                  case Res(inner2, next_m) => {
                    let node = CST.BoxCST(inner2, sp);
                    let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                    match res_rest {
                      case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                    }
                  }
                }
} else if string_eq(sym, "unbox") then {
                let inner = expand_seq_expr(advance(elems), op_env, sp);
                let res_i = expand_cst(fuel, env, op_env, m, inner);
                match res_i {
                  case Res(inner2, next_m) => {
                    let node = CST.UnboxCST(inner2, sp);
                    let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                    match res_rest {
                      case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                    }
                  }
                }
} else if string_eq(sym, "import") then {
                let rest = advance(elems);
                if int_lt(list_length(rest), 2) then process_stmt_keep(fuel, env, op_env, m, s, rest_ss) else {
                  match list_get(rest, 0) {
                    case Symbol(lang, _) => {
                      let rest1 = advance(rest);
                      match list_get(rest1, 0) {
                        case Symbol(alias, _) => {
                          let rest2 = advance(rest1);
                          if int_eq(list_length(rest2), 0) then process_stmt_keep(fuel, env, op_env, m, s, rest_ss) else {
                            match list_get(rest2, 0) {
                              case StringLiteral(mod_path, _) => {
                                let after_mod = advance(rest2);
                                let syms = extract_import_syms(after_mod);
                                let after = match list_get(after_mod, 0) {
                                  case Block(_, _, _) => advance(after_mod);
                                  case _ => after_mod
                                };
                                let node = ImportCST(lang, alias, mod_path, syms, sp);
                                let cont = cont_with_leftover(elems, int_sub(list_length(elems), list_length(after)), sp, rest_ss);
                                let res_rest = process_stmts(fuel, env, op_env, m, cont);
                                match res_rest {
                                  case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                                }
                              };
                              case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                            }
                          }
                        };
                        case StringLiteral(mod_path, _) => {
                          let after_mod = advance(rest1);
                          let syms = extract_import_syms(after_mod);
                          let after = match list_get(after_mod, 0) {
                            case Block(_, _, _) => advance(after_mod);
                            case _ => after_mod
                          };
                          let node = ImportCST(lang, lang, mod_path, syms, sp);
                          let cont = cont_with_leftover(elems, int_sub(list_length(elems), list_length(after)), sp, rest_ss);
                          let res_rest = process_stmts(fuel, env, op_env, m, cont);
                          match res_rest {
                            case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                          }
                        };
                        case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                      }
                    };
                    case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                  }
                }
} else if string_eq(sym, "extern") then {
                let rest = advance(elems);
                if int_lt(list_length(rest), 3) then process_stmt_keep(fuel, env, op_env, m, s, rest_ss) else {
                  match list_get(rest, 0) {
                    case Symbol(lang, _) => {
                      match list_get(rest, 1) {
                        case StringLiteral(mod_path, _) => {
                          match list_get(rest, 2) {
                            case Block(decls, dtail, _) => {
                              let all_decls = methods_of_block_2(decls, dtail, op_env);
                              let res_decls = map_expand(all_decls, fuel, env, op_env, m);
                              match res_decls {
                                case ResList(decls2, next_m) => {
                                  let node = ExternCST(lang, mod_path, decls2, sp);
                                  let cont = cont_with_leftover(elems, 4, sp, rest_ss);
                                  let res_rest = process_stmts(fuel, env, op_env, next_m, cont);
                                  match res_rest {
                                    case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                                  }
                                }
                              }
                            };
                            case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                          }
                        };
                        case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                      }
                    };
                    case _ => process_stmt_keep(fuel, env, op_env, m, s, rest_ss)
                  }
                }
} else if int_eq(list_length(elems), 3) then {
                let eq_node = list_get(elems, 1);
                match eq_node {
                  case Symbol(eq_s, _) => {
                    if string_eq(eq_s, "=") then {
                      let val_cst = list_get(elems, 2);
                      let res_val = expand_cst(fuel, env, op_env, m, val_cst);
                      match res_val {
                        case Res(v2, next_m) => {
                          let node = CST.AssignCST(sym, v2, sp);
                          let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                          match res_rest {
                            case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, node), final_m)
                          }
                        }
                      }
                    } else {
                      let res_s = expand_cst(fuel, env, op_env, m, s);
                      match res_s {
                        case Res(fst_cst, next_m) => {
                          let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                          match res_rest {
                            case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                          }
}
                      }
                    }
                  };
                  case _ => {
                    let res_s = expand_cst(fuel, env, op_env, m, s);
                    match res_s {
                      case Res(fst_cst, next_m) => {
                        let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                        match res_rest {
                          case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                        }
}
                    }
                  }
                }
} else {
                let res_s = expand_cst(fuel, env, op_env, m, s);
                match res_s {
                  case Res(fst_cst, next_m) => {
                    let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                    match res_rest {
                      case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                    }
}
                }
}
            };
            case _ => {
              let res_s = expand_cst(fuel, env, op_env, m, s);
              match res_s {
                case Res(fst_cst, next_m) => {
                  let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
                  match res_rest {
                    case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
                  }
}
              }
}
          }
}
      };
      case _ => {
        let res_s = expand_cst(fuel, env, op_env, m, s);
        match res_s {
          case Res(fst_cst, next_m) => {
            let res_rest = process_stmts(fuel, env, op_env, next_m, rest_ss);
            match res_rest {
              case ResList(rest_csts, final_m) => ExpandResultList.ResList(list_insert_first(rest_csts, fst_cst), final_m)
            }
}
        }
}
    }
}
};
def expand_cst(fuel: Integer, env: List(MacroEnvEntry), op_env: List(OpEnvEntry), mark: Integer, c: CST): ExpandResult = {
  if int_eq(fuel, 0) then ExpandResult.Res(c, mark) else {
    let next_fuel = int_sub(fuel, 1);
    match c {
      case Block(stmts, tail, sp) => {
        // Rocq: map_expand stmts/tail first so nested Blocks (e.g. def bodies)
        // run process_stmts before the outer SeqOf is turned into DefCST.
        let res_map = map_expand(stmts, next_fuel, env, op_env, mark);
        match res_map {
          case ResList(expanded_stmts, m1) => {
            let res_tail0 = expand_cst(next_fuel, env, op_env, m1, tail);
            match res_tail0 {
              case Res(expanded_tail, m2) => {
                let res_stmts = process_stmts(next_fuel, env, op_env, m2, expanded_stmts);
                match res_stmts {
                  case ResList(new_stmts, next_m) => {
                    let res_tail = process_stmts(next_fuel, env, op_env, next_m, list_insert_first(list_empty[CST](), expanded_tail));
                    match res_tail {
                      case ResList(tail_list, final_m) => {
                        let new_tail = if int_eq(list_length(tail_list), 0) then expanded_tail else list_get(tail_list, 0);
                        let promoted = match new_tail {
                          case Symbol(u, _) => {
                            if string_eq(u, "Unit") then {
                              if int_eq(list_length(new_stmts), 0) then Pair.MkPair(new_stmts, new_tail) else {
                                let last = list_get(new_stmts, int_sub(list_length(new_stmts), 1));
                                match last {
                                  case HandleCST(_, _, _, _) => Pair.MkPair(list_drop_last(new_stmts), last);
                                  case DoCST(_, _, _) => Pair.MkPair(list_drop_last(new_stmts), last);
                                  case _ => Pair.MkPair(new_stmts, new_tail)
                                }
                              }
                            } else Pair.MkPair(new_stmts, new_tail)
                          };
                          case _ => Pair.MkPair(new_stmts, new_tail)
                        };
                        match promoted {
                          case MkPair(stmts2, tail2) => ExpandResult.Res(Block(stmts2, tail2, sp), final_m)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      };
      case Tuple(elems, sp) => {
        let res_elems = map_expand(elems, next_fuel, env, op_env, mark);
        match res_elems {
          case ResList(new_elems, next_m) => ExpandResult.Res(Tuple(new_elems, sp), next_m)
        }
      };
      case ListLiteral(elems, sp) => {
        let res_elems = map_expand(elems, next_fuel, env, op_env, mark);
        match res_elems {
          case ResList(new_elems, next_m) => ExpandResult.Res(ListLiteral(new_elems, sp), next_m)
        }
      };
      case SeqOf(elems, sp) => {
        let res_elems = map_expand(elems, next_fuel, env, op_env, mark);
        match res_elems {
          case ResList(new_elems, next_m) => {
            let expanded = expand_seq_expr(new_elems, op_env, sp);
            // Rocq returns expand_seq_expr directly. Recurse only when it
            // rewrote into a non-SeqOf form (if/match/lam/…).
            match expanded {
              case SeqOf(_, _) => ExpandResult.Res(expanded, next_m);
              case _ => expand_cst(next_fuel, env, op_env, next_m, expanded)
            }
          }
        }
      };
      case FieldAccess(expr, f, sp) => {
        let res_expr = expand_cst(next_fuel, env, op_env, mark, expr);
        match res_expr {
          case Res(new_expr, next_m) => ExpandResult.Res(FieldAccess(new_expr, f, sp), next_m)
        }
      };
      case IfCST(cond, tb, eb, sp) => {
        let res_c = expand_cst(next_fuel, env, op_env, mark, cond);
        match res_c {
          case Res(new_c, m1) => {
            let res_t = expand_cst(next_fuel, env, op_env, m1, tb);
            match res_t {
              case Res(new_t, m2) => {
                let res_e = expand_cst(next_fuel, env, op_env, m2, eb);
                match res_e {
                  case Res(new_e, m3) => ExpandResult.Res(IfCST(new_c, new_t, new_e, sp), m3)
                }
              }
            }
          }
        }
      };
      case LamCST(arg, argty, body, sp) => {
        let res_ty = expand_cst(next_fuel, env, op_env, mark, argty);
        match res_ty {
          case Res(new_ty, m1) => {
            let res_b = expand_cst(next_fuel, env, op_env, m1, body);
            match res_b {
              case Res(new_b, m2) => ExpandResult.Res(LamCST(arg, new_ty, new_b, sp), m2)
            }
          }
        }
      };
      case LetCST(n, v, next, sp) => {
        let res_v = expand_cst(next_fuel, env, op_env, mark, v);
        match res_v {
          case Res(new_v, m1) => {
            let res_n = expand_cst(next_fuel, env, op_env, m1, next);
            match res_n {
              case Res(new_n, m2) => ExpandResult.Res(LetCST(n, new_v, new_n, sp), m2)
            }
          }
        }
      };
      case VarCST(n, v, next, sp) => {
        let res_v = expand_cst(next_fuel, env, op_env, mark, v);
        match res_v {
          case Res(new_v, m1) => {
            let res_n = expand_cst(next_fuel, env, op_env, m1, next);
            match res_n {
              case Res(new_n, m2) => ExpandResult.Res(VarCST(n, new_v, new_n, sp), m2)
            }
          }
        }
      };
      case AssignCST(n, v, sp) => {
        let res_v = expand_cst(next_fuel, env, op_env, mark, v);
        match res_v {
          case Res(new_v, m1) => ExpandResult.Res(AssignCST(n, new_v, sp), m1)
        }
      };
      case BoxCST(inner, sp) => {
        let res_i = expand_cst(next_fuel, env, op_env, mark, inner);
        match res_i {
          case Res(new_i, m1) => ExpandResult.Res(BoxCST(new_i, sp), m1)
        }
      };
      case UnboxCST(inner, sp) => {
        let res_i = expand_cst(next_fuel, env, op_env, mark, inner);
        match res_i {
          case Res(new_i, m1) => ExpandResult.Res(UnboxCST(new_i, sp), m1)
        }
      };
      case ExternCST(lang, mod_path, decls, sp) => {
        let res_decls = map_expand(decls, next_fuel, env, op_env, mark);
        match res_decls {
          case ResList(new_decls, m1) => ExpandResult.Res(ExternCST(lang, mod_path, new_decls, sp), m1)
        }
      };
      case ImportCST(_, _, _, _, _) => ExpandResult.Res(c, mark);
      case MatchCST(expr, cases, sp) => {
        let res_expr = expand_cst(next_fuel, env, op_env, mark, expr);
        match res_expr {
          case Res(new_expr, next_m) => ExpandResult.Res(MatchCST(new_expr, cases, sp), next_m)
        }
      };
      case AppCST(f, args, sp) => {
        match f {
          case Symbol(fname, _) => {
            let lookup_res = lookup_macro(fname, env);
            match lookup_res {
              case Found(cases) => {
                let next_mark = int_add(mark, 1);
                let apply_res = apply_macro(cases, args, next_mark);
                match apply_res {
                  case Matched(expanded) => expand_cst(next_fuel, env, op_env, next_mark, expanded);
                  case _ => {
                    let res_args = map_expand(args, next_fuel, env, op_env, mark);
                    match res_args {
                      case ResList(new_args, final_m) => ExpandResult.Res(AppCST(f, new_args, sp), final_m)
                    }
                  }
                }
              };
              case _ => {
                let res_args = map_expand(args, next_fuel, env, op_env, mark);
                match res_args {
                  case ResList(new_args, final_m) => ExpandResult.Res(AppCST(f, new_args, sp), final_m)
                }
              }
            }
          };
          case _ => {
            let res_expr = expand_cst(next_fuel, env, op_env, mark, f);
            match res_expr {
              case Res(new_expr, next_m) => {
                let res_args = map_expand(args, next_fuel, env, op_env, next_m);
                match res_args {
                  case ResList(new_args, final_m) => ExpandResult.Res(AppCST(new_expr, new_args, sp), final_m)
                }
              }
            }
          }
        }
      };
      case _ => ExpandResult.Res(c, mark)
    }
  }
};
def expand_cst_top(c: CST): CST = {
  let res = expand_cst(100000, list_empty[MacroEnvEntry](), list_empty[OpEnvEntry](), 0, c);
  match res {
    case Res(cst, _) => cst
  }
};
def expander_main(): Any = {
  let cst = Symbol("test", Span(0, 0, list_empty[Integer]()));
  expand_cst_top(cst)
};
// expander_main()
