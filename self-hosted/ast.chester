enum PatternAST {
  case PatWildcard;
  case PatVar(name: String);
  case PatConstructor(name: String, vars: List(String))
};
enum AST {
  case AstRef(name: String);
  case AstMeta(id: Integer);
  case AstUniverse(level: Integer);
  case AstTuple(elems: List(AST));
  case AstStringLit(val: String);
  case AstIntLit(val: Integer);
  case AstBoolLit(val: Bool);
  case AstBlock(stmts: List(AST), tail: AST);
  case AstApp(fn_expr: AST, args: List(AST));
  case AstImplicitApp(fn_expr: AST, args: List(AST));
  case AstLam(argName: String, argTy: AST, body: AST);
  case AstPi(argName: String, argTy: AST, retTy: AST, effs: List(String));
  case AstLet(name: String, value: AST);
  case AstVar(name: String, value: AST);
  case AstAssign(name: String, value: AST);
  case AstIf(cond: AST, then_branch: AST, else_branch: AST);
  case AstDef(name: String, type_params: List(String), params: List(Pair), ret_ty: AST, body: AST);
  case AstFunTy(type_params: List(String), params: List(Pair), ret_ty: AST, effs: List(String));
  case AstEnum(name: String, type_params: List(String), variants: List(Pair));
  case AstMatch(expr: AST, cases: List(Pair));
  case AstRecord(name: String, type_params: List(String), fields: List(Pair));
  case AstFieldAccess(expr: AST, field_name: String);
  case AstExtension(ext_name: String, type_params: List(String), target_ty: AST, methods: List(AST));
  case AstSpan(span: Span, inner: AST);
  case AstError(msg: String);
  case AstDo(op: AST, args: List(AST));
  case AstHandle(body: AST, eff: String, handlers: List(Pair));
  case AstBox(inner: AST, caps: List(String));
  case AstUnbox(inner: AST);
  case AstImport(lang: String, alias: String, mod_path: String, syms: List(String));
  case AstModule(name: String, params: List(Pair), seal: List(AST), body: List(AST));
  case AstSignature(name: String, decls: List(AST));
  case AstFunctorApp(func: AST, args: List(AST));
  case AstModTy(exports: List(Pair));
  case AstSigVal(name: String, type_params: List(String), params: List(Pair), ret_ty: AST);
  case AstTypeDecl(name: String, def: List(AST));
  case AstSigWith(base: AST, eqs: List(Pair));
  case AstPack(mod_expr: AST, sig_expr: AST);
  case AstUnpack(name: String, sig_expr: AST, packed: AST, body: AST);
  case AstFileImport(name: String, path: String)
};
