enum ParseResult[T] {
  case MkParseResult(result: T, remaining: List(Token))
};
def ParseResult_result[T](p: ParseResult(T)): T = match p { case MkParseResult(r, _) => r };
def ParseResult_remaining[T](p: ParseResult(T)): List(Token) = match p { case MkParseResult(_, rem) => rem };
// We need a helper to check if a token is a specific symbol
def is_symbol_token(tok: Token, sym: String): Bool = {
  string_eq(Token_text(tok), sym)
};
// advance removes the first token
// Actually, Chester supports top-level mutual recursion
def parse_tuple_helper(tokens: List(Token), acc: List(CST)): ParseResult(CST) = {
  if int_eq(list_length(tokens), 0) then {
    ParseResult.MkParseResult(CST.Error("Unexpected EOF", Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    match Token_kind(tok) {
      case SymToken(s) => {
        if string_eq(s, ")") then {
          ParseResult.MkParseResult(CST.Tuple(acc, Span(0, 0, list_empty[Integer]())), advance(tokens))
        } else {
          let p = parse_atom_sequence(tokens);
          match ParseResult_result(p) {
            case Error(_, _) => p;
            case _ => {
              if int_eq(list_length(ParseResult_remaining(p)), 0) then {
                ParseResult.MkParseResult(CST.Error("Unexpected EOF in tuple", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
              } else {
                let next_tok = list_get(ParseResult_remaining(p), 0);
                match Token_kind(next_tok) {
                  case SymToken(s2) => {
                    if string_eq(s2, ",") then {
                      parse_tuple_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                    } else if string_eq(s2, ")") then {
                      ParseResult.MkParseResult(CST.Tuple(list_append(acc, ParseResult_result(p)), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                    } else {
                      ParseResult.MkParseResult(CST.Error("Expected ',' or ')'", Token_span(next_tok)), ParseResult_remaining(p))
                    }
                  };
                  case _ => ParseResult.MkParseResult(CST.Error("Expected ',' or ')'", Token_span(next_tok)), ParseResult_remaining(p))
                }
              }
            }
          }
        }
      };
      case _ => {
        let p = parse_atom_sequence(tokens);
        match ParseResult_result(p) {
          case Error(_, _) => p;
          case _ => {
            if int_eq(list_length(ParseResult_remaining(p)), 0) then {
              ParseResult.MkParseResult(CST.Error("Unexpected EOF in tuple", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
            } else {
              let next_tok = list_get(ParseResult_remaining(p), 0);
              match Token_kind(next_tok) {
                case SymToken(s2) => {
                  if string_eq(s2, ",") then {
                    parse_tuple_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                  } else if string_eq(s2, ")") then {
                    ParseResult.MkParseResult(CST.Tuple(list_append(acc, ParseResult_result(p)), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Error("Expected ',' or ')'", Token_span(next_tok)), ParseResult_remaining(p))
                  }
                };
                case _ => ParseResult.MkParseResult(CST.Error("Expected ',' or ')'", Token_span(next_tok)), ParseResult_remaining(p))
              }
            }
          }
        }
      }
    }
  }
};
def parse_tuple(tokens: List(Token)): ParseResult(CST) = {
  parse_tuple_helper(tokens, list_empty[CST]())
};
def parse_list_helper(tokens: List(Token), acc: List(CST)): ParseResult(CST) = {
  if int_eq(list_length(tokens), 0) then {
    ParseResult.MkParseResult(CST.Error("Unexpected EOF", Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    match Token_kind(tok) {
      case SymToken(s) => {
        if string_eq(s, "]") then {
          ParseResult.MkParseResult(CST.ListLiteral(acc, Span(0, 0, list_empty[Integer]())), advance(tokens))
        } else {
          let p = parse_atom_sequence(tokens);
          match ParseResult_result(p) {
            case Error(_, _) => p;
            case _ => {
              if int_eq(list_length(ParseResult_remaining(p)), 0) then {
                ParseResult.MkParseResult(CST.Error("Unexpected EOF in list", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
              } else {
                let next_tok = list_get(ParseResult_remaining(p), 0);
                match Token_kind(next_tok) {
                  case SymToken(s2) => {
                    if string_eq(s2, ",") then {
                      parse_list_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                    } else if string_eq(s2, "]") then {
                      ParseResult.MkParseResult(CST.ListLiteral(list_append(acc, ParseResult_result(p)), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                    } else {
                      ParseResult.MkParseResult(CST.Error("Expected ',' or ']'", Token_span(next_tok)), ParseResult_remaining(p))
                    }
                  };
                  case _ => ParseResult.MkParseResult(CST.Error("Expected ',' or ']'", Token_span(next_tok)), ParseResult_remaining(p))
                }
              }
            }
          }
        }
      };
      case _ => {
        let p = parse_atom_sequence(tokens);
        match ParseResult_result(p) {
          case Error(_, _) => p;
          case _ => {
            if int_eq(list_length(ParseResult_remaining(p)), 0) then {
              ParseResult.MkParseResult(CST.Error("Unexpected EOF in list", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
            } else {
              let next_tok = list_get(ParseResult_remaining(p), 0);
              match Token_kind(next_tok) {
                case SymToken(s2) => {
                  if string_eq(s2, ",") then {
                    parse_list_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                  } else if string_eq(s2, "]") then {
                    ParseResult.MkParseResult(CST.ListLiteral(list_append(acc, ParseResult_result(p)), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Error("Expected ',' or ']'", Token_span(next_tok)), ParseResult_remaining(p))
                  }
                };
                case _ => ParseResult.MkParseResult(CST.Error("Expected ',' or ']'", Token_span(next_tok)), ParseResult_remaining(p))
              }
            }
          }
        }
      }
    }
  }
};
def parse_list(tokens: List(Token)): ParseResult(CST) = {
  parse_list_helper(tokens, list_empty[CST]())
};
def parse_block_helper(tokens: List(Token), acc: List(CST)): ParseResult(CST) = {
  if int_eq(list_length(tokens), 0) then {
    ParseResult.MkParseResult(CST.Error("Unexpected EOF", Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    match Token_kind(tok) {
      case SymToken(s) => {
        if string_eq(s, "}") then {
          ParseResult.MkParseResult(CST.Block(acc, CST.Symbol("Unit", Span(0, 0, list_empty[Integer]())), Span(0, 0, list_empty[Integer]())), advance(tokens))
        } else {
          let p = parse_atom_sequence(tokens);
          match ParseResult_result(p) {
            case Error(_, _) => p;
            case _ => {
              if int_eq(list_length(ParseResult_remaining(p)), 0) then {
                ParseResult.MkParseResult(CST.Error("Unexpected EOF in block", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
              } else {
                let next_tok = list_get(ParseResult_remaining(p), 0);
                match Token_kind(next_tok) {
                  case SymToken(s2) => {
                    if string_eq(s2, ";") then {
                      parse_block_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                    } else if string_eq(s2, "}") then {
                      // tail expression!
                      ParseResult.MkParseResult(CST.Block(acc, ParseResult_result(p), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                    } else {
                      ParseResult.MkParseResult(CST.Error("Expected ';' or '}'", Token_span(next_tok)), ParseResult_remaining(p))
                    }
                  };
                  case _ => ParseResult.MkParseResult(CST.Error("Expected ';' or '}'", Token_span(next_tok)), ParseResult_remaining(p))
                }
              }
            }
          }
        }
      };
      case _ => {
        let p = parse_atom_sequence(tokens);
        match ParseResult_result(p) {
          case Error(_, _) => p;
          case _ => {
            if int_eq(list_length(ParseResult_remaining(p)), 0) then {
              ParseResult.MkParseResult(CST.Error("Unexpected EOF in block", Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
            } else {
              let next_tok = list_get(ParseResult_remaining(p), 0);
              match Token_kind(next_tok) {
                case SymToken(s2) => {
                  if string_eq(s2, ";") then {
                    parse_block_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                  } else if string_eq(s2, "}") then {
                    // tail expression!
                    ParseResult.MkParseResult(CST.Block(acc, ParseResult_result(p), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Error("Expected ';' or '}'", Token_span(next_tok)), ParseResult_remaining(p))
                  }
                };
                case _ => ParseResult.MkParseResult(CST.Error("Expected ';' or '}'", Token_span(next_tok)), ParseResult_remaining(p))
              }
            }
          }
        }
      }
    }
  }
};
def parse_block(tokens: List(Token)): ParseResult(CST) = {
  parse_block_helper(tokens, list_empty[CST]())
};
def is_terminator(tok: Token): Bool = {
  match Token_kind(tok) {
    case EOF() => true;
    case SymToken(s) => {
      let is_rparen = string_eq(s, ")");
      let is_rbrace = string_eq(s, "}");
      let is_rbracket = string_eq(s, "]");
      let is_semi = string_eq(s, ";");
      let is_comma = string_eq(s, ",");
      bool_or(is_rparen, bool_or(is_rbrace, bool_or(is_rbracket, bool_or(is_semi, is_comma))))
    };
    case _ => false
  }
};
def is_block_continue_kw(s: String): Bool = {
  if string_eq(s, "else") then true
  else if string_eq(s, "catch") then true
  else if string_eq(s, "with") then true
  else if string_eq(s, "for") then true
  else if string_eq(s, "same_as") then true
  else if string_eq(s, "tighter_than") then true
  else false
};
def ends_with_block_cst(c: CST): Bool = {
  match c {
    case Block(_, _, _) => true;
    case SeqOf(elems, _) => {
      if int_eq(list_length(elems), 0) then false else {
        match list_get(elems, int_sub(list_length(elems), 1)) {
          case Block(_, _, _) => true;
          case _ => false
        }
      }
    };
    case _ => false
  }
};
def finish_atom_seq(acc: List(CST), tokens: List(Token)): ParseResult(CST) = {
  let len = list_length(acc);
  if int_eq(len, 1) then ParseResult.MkParseResult(list_get(acc, 0), tokens)
  else ParseResult.MkParseResult(CST.SeqOf(acc, Span(0, 0, list_empty[Integer]())), tokens)
};
def parse_atom_sequence_helper(tokens: List(Token), acc: List(CST)): ParseResult(CST) = {
  if int_eq(list_length(tokens), 0) then {
    ParseResult.MkParseResult(CST.Error("Unexpected EOF", Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    if is_terminator(tok) then finish_atom_seq(acc, tokens) else {
      let p = parse_atom(tokens);
      match ParseResult_result(p) {
        case Error(_, _) => p;
        case atom => {
          let new_acc = list_append(acc, atom);
          let rem = ParseResult_remaining(p);
          // Rocq ModeSeq: after `{...}` stop unless a continuation keyword follows
          // (else/catch/with/for/…), so `effect {…} def …` becomes two statements.
          if ends_with_block_cst(atom) then {
            if int_eq(list_length(rem), 0) then finish_atom_seq(new_acc, rem) else {
              let next = list_get(rem, 0);
              match Token_kind(next) {
                case Identifier() => {
                  if is_block_continue_kw(Token_text(next)) then parse_atom_sequence_helper(rem, new_acc)
                  else finish_atom_seq(new_acc, rem)
                };
                case _ => finish_atom_seq(new_acc, rem)
              }
            }
          } else parse_atom_sequence_helper(rem, new_acc)
        }
      }
    }
  }
};
def parse_atom_sequence(tokens: List(Token)): ParseResult(CST) = {
  parse_atom_sequence_helper(tokens, list_empty[CST]())
};
def parse_atom(tokens: List(Token)): ParseResult(CST) = {
  let len = list_length(tokens);
  if int_eq(len, 0) then {
    ParseResult.MkParseResult(CST.Error("Unexpected EOF", Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    let rest = advance(tokens);
    match Token_kind(tok) {
      case Identifier() => ParseResult.MkParseResult(CST.Symbol(Token_text(tok), Token_span(tok)), rest);
      case IntegerLit() => ParseResult.MkParseResult(CST.IntegerLiteral(Token_text(tok), Token_span(tok)), rest);
      case StringLit() => ParseResult.MkParseResult(CST.StringLiteral(Token_text(tok), Token_span(tok)), rest);
      case EOF() => ParseResult.MkParseResult(CST.Error("Unexpected EOF", Token_span(tok)), rest);
      case SymToken(s) => {
        if string_eq(s, "(") then parse_tuple(rest) else if string_eq(s, "{") then parse_block(rest) else if string_eq(s, "[") then parse_list(rest) else ParseResult.MkParseResult(CST.Symbol(Token_text(tok), Token_span(tok)), rest)
      };
      case Whitespace() => ParseResult.MkParseResult(CST.Error("Unexpected whitespace", Token_span(tok)), rest);
      // Whitespace should be filtered
    }
  }
};
def filter_whitespace(tokens: List(Token)): List(Token) = {
  list_filter(tokens, \tok => {
    match Token_kind(tok) {
      case Whitespace() => false;
      case _ => true
    }
  })
};

def parse_program_helper(tokens: List(Token), acc: List(CST)): ParseResult(CST) = {
  if int_eq(list_length(tokens), 0) then {
    ParseResult.MkParseResult(CST.Block(acc, CST.Symbol("Unit", Span(0, 0, list_empty[Integer]())), Span(0, 0, list_empty[Integer]())), tokens)
  } else {
    let tok = list_get(tokens, 0);
    match Token_kind(tok) {
      case EOF() => ParseResult.MkParseResult(CST.Block(acc, CST.Symbol("Unit", Span(0, 0, list_empty[Integer]())), Span(0, 0, list_empty[Integer]())), advance(tokens));
      case _ => {
        let p = parse_atom_sequence(tokens);
        match ParseResult_result(p) {
          case Error(_, _) => p;
          case _ => {
            if int_eq(list_length(ParseResult_remaining(p)), 0) then {
              // Match Rocq: block-ending decls go in stmts with Unit tail
              if ends_with_block_cst(ParseResult_result(p)) then {
                ParseResult.MkParseResult(CST.Block(list_append(acc, ParseResult_result(p)), CST.Symbol("Unit", Span(0, 0, list_empty[Integer]())), Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
              } else {
                ParseResult.MkParseResult(CST.Block(acc, ParseResult_result(p), Span(0, 0, list_empty[Integer]())), ParseResult_remaining(p))
              }
            } else {
              let next_tok = list_get(ParseResult_remaining(p), 0);
              match Token_kind(next_tok) {
                case SymToken(s2) => {
                  if string_eq(s2, ";") then {
                    parse_program_helper(advance(ParseResult_remaining(p)), list_append(acc, ParseResult_result(p)))
                  } else if ends_with_block_cst(ParseResult_result(p)) then {
                    parse_program_helper(ParseResult_remaining(p), list_append(acc, ParseResult_result(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Error("Expected ';' at top level", Token_span(next_tok)), ParseResult_remaining(p))
                  }
                };
                case EOF() => {
                  if ends_with_block_cst(ParseResult_result(p)) then {
                    ParseResult.MkParseResult(CST.Block(list_append(acc, ParseResult_result(p)), CST.Symbol("Unit", Span(0, 0, list_empty[Integer]())), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Block(acc, ParseResult_result(p), Span(0, 0, list_empty[Integer]())), advance(ParseResult_remaining(p)))
                  }
                };
                case _ => {
                  if ends_with_block_cst(ParseResult_result(p)) then {
                    parse_program_helper(ParseResult_remaining(p), list_append(acc, ParseResult_result(p)))
                  } else {
                    ParseResult.MkParseResult(CST.Error("Expected ';' or EOF at top level", Token_span(next_tok)), ParseResult_remaining(p))
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};
def parse(tokens: List(Token)): ParseResult(CST) = {
  let filtered = filter_whitespace(tokens);
  parse_program_helper(filtered, list_empty[CST]())
};
def main_parser(): Any = {
  let tokens = lex("let x = 5;");
  let p = parse(tokens);
  // Just return p to check if it compiles!
  p
};
